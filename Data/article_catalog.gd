static func create_articles() -> Array[NewsArticle]:
	var result: Array[NewsArticle] = []
	var rows: Array = ROWS.slice(0, 2) + preload("res://Data/community_articles.gd").ROWS + ROWS.slice(2) + preload("res://Data/bripolis_articles.gd").ROWS
	rows += preload("res://Data/district_letters.gd").ROWS
	for row in rows:
		var article := NewsArticle.from_row(row)
		if not article.provenance.has("author"):
			article.provenance = {"author": "Codex" if row in ROWS else "User", "kind": "authored" if row in ROWS else "user_source"}
		result.append(article)
	return result
