extends RefCounted

static func work(balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "source", "text": "Устраивайся, Никола. Вот сегодняшние письма и рапорты. Сначала прочитай, что случилось на самом деле. Нам ещё решать, с какими словами эта история выйдет к читателям."},
		{"target": "headline", "text": "Видишь зелёное поле? Нажми на него — разложу три заголовка. Выберешь записку, и её слова останутся на листе. Пока не поставила печать, можно вернуться к полю и передумать."},
		{"target": "choices", "text": "Один заголовок держится фактов, другой раздувает сенсацию, третий хвалит власть. Не хватай первую попавшуюся записку. Смотри, что обещаешь людям и кому это обещание придётся по душе."},
		{"target": "stamp", "text": "Заголовок выбрала? Тогда бери штамп справа: одного нажатия хватит, держать кнопку мыши не нужно. Печать весомая — подумай ещё раз, прежде чем опустить её на бумагу."},
		{"target": "publish", "text": "Перенеси штамп на текст или на пустое место под ним и нажми левую кнопку ещё раз. Только не на заголовок и не на кружку. Штамп вернётся на место, я принесу расчёт. Прочитай его спокойно: до закрытия записки силы не расходуются."},
		{"target": "health", "text": "И за собой следи. На работу и каждый оттиск уходят силы. Доведёшь себя до нуля — свалишься, а подменить тебя некому. Дома ешь и высыпайся. Лучше сдать выпуск раньше, чем остаться здесь без сил."},
		{"target": "reputation", "text": "Это доверие наших читателей. Факты его укрепляют, выдумки разрушают. Если потеряем доверие совсем, однажды редакцию подожгут. Зато от %d читатели помогают: на публикацию уходит %d сил вместо %d." % [int(balance.reader_support.threshold), int(balance.publication_health_cost - balance.reader_support.amount), int(balance.publication_health_cost)]},
		{"target": "loyalty", "text": "А это отношение государства к газете. Похвала его улучшает; критика, даже правдивая, может испортить. Дойдёт до нуля — за тобой придут. От %d в начале смены получишь до %d сил: работать с поддержкой спокойнее." % [int(balance.state_approval.threshold), int(balance.state_approval.amount)]},
		{"target": "combo", "text": "Несколько заголовков одного направления подряд складываются в серию. Посмотри на эту записку: множитель растёт, вместе с ним доход и изменения показателей. Штрафы тоже. Сменишь направление или сдашь выпуск — начнёшь новую серию."},
		{"target": "coffee", "text": "Первую чашку поставил тебе за свой счёт. Когда устанешь, нажми на неё: вернётся до %d сил. Следующую купишь дома. Не захочешь пить сегодня — чашка дождётся тебя, не пропадёт." % int(balance.coffee_health_restore)},
		{"target": "finish", "text": "Теперь попробуй сама. На сегодня хватит — нажми «Сдать выпуск» и иди домой. Всё, что не успеешь, оставь на столе до завтра. Пустой выпуск тоже приму; твоё здоровье мне дороже лишнего оттиска."}
	]

static func home(balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "money", "text": "Наконец-то тишина. За комнату уже ушло %d $. Нужно пересчитать остаток и оставить на ужин. Долг в %d $ хозяин мне не простит — придётся искать ночлег на улице." % [balance.rent, balance.debt_limit]},
		{"target": "meal", "text": "В холодильнике есть ужин: %d $, зато вернётся до %d сил. Если хватит только на перекус, возьму его за %d $ — это до %d сил. Сначала поем, иначе завтра опять будет тяжело." % [balance.meal_price, int(balance.meal_health), balance.snack_price, int(balance.snack_health)]},
		{"target": "coffee", "text": "Кофе на завтра стоит %d $. Куплю здесь, а выпью уже в редакции. Если сегодняшняя чашка осталась нетронутой, незачем платить за ещё одну." % balance.coffee_price},
		{"target": "notebook", "text": "Положу блокнот рядом с чашкой. Открою его и запишу, на что ушли деньги и сколько принесли мои статьи. Здесь есть записи за сегодняшний день и за всё время. Так легче понять, чем платить за комнату."},
		{"target": "bed", "text": "Осталось добраться до кровати. Сон вернёт до %d сил, а утром снова в редакцию. Если ещё голодна, лучше поесть сейчас. Потом лягу — на сегодня с меня хватит." % int(balance.sleep_health)}
	]

static func pencil() -> Array[Dictionary]:
	return [
		{"target": "pencil", "text": "Никола, сегодня доверяю тебе ещё и вычитку. Красный карандаш уже на столе. Нажми, чтобы взять его, затем веди по бумаге с зажатой левой кнопкой. Правая кнопка вернёт карандаш на место."},
		{"target": "source", "text": "Прочитай источник внимательно. Найдёшь опечатку — подчеркни слово или обведи его. Верные слова оставляй в покое. Пометки на пустой бумаге ничего не испортят, но ошибки за тебя не исправят."},
		{"target": "eraser", "text": "Рука дрогнула? Ластик рядом с карандашом. Возьми его и сотри лишнюю пометку с зажатой левой кнопкой. Правая вернёт его на стол. На каждом листе остаются свои пометки. Исправляй до печати: после штампа материал уже уйдёт в выпуск."},
		{"target": "qualification", "text": "За найденную опечатку доплачу 2 $ и повышу оценку твоей вычитки на балл. Пропуск стоит 1 $ и три балла, пометка на верном слове — 1 $ и один балл. Рассчитаюсь после печати. Если потеряю доверие к твоей работе совсем, придётся расстаться. Так что с карандашом не торопись."}
	]
