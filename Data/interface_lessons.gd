extends RefCounted

static func work(_balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "source", "text": "Никола, сначала прочитай источник. По нему выбирай, какой заголовок дать статье."},
		{"target": "headline", "text": "Нажми на зелёное поле и выбери заголовок. До печати его можно заменить: нажми на поле ещё раз."},
		{"target": "choices", "text": "Заголовки предлагают факты, сенсацию или похвалу власти. От выбора зависят доход, доверие читателей и отношение государства."},
		{"target": "stamp", "text": "После выбора заголовка штамп подсветится. Нажми на него, чтобы взять. Держать кнопку мыши не нужно."},
		{"target": "publish", "text": "Перенеси штамп на текст или место под ним и нажми ещё раз. После печати прочитай результат. Правая кнопка отменяет перенос."},
		{"target": "health", "text": "Работа и публикации расходуют выносливость. Не доводи её до нуля: вовремя заканчивай смену, ешь и отдыхай дома."},
		{"target": "reputation", "text": "Репутация — доверие читателей. Факты его укрепляют, выдумки разрушают. При высокой репутации публикации требуют меньше сил."},
		{"target": "loyalty", "text": "Лояльность — отношение государства. Похвала повышает её, критика снижает. Высокая лояльность даёт силы в начале смены."},
		{"target": "combo", "text": "Заголовки одного направления подряд дают серию. Она усиливает доход и изменения показателей, включая штрафы."},
		{"target": "coffee", "text": "Устанешь — нажми на чашку, чтобы восстановить силы. Не выпьешь сегодня — кофе останется на следующую смену."},
		{"target": "finish", "text": "Нажми «Сдать выпуск», когда решишь закончить смену. Неопубликованные статьи останутся на завтра."}
	]

static func home(_balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "money", "text": "Это мой баланс. Нажму на сумму, чтобы открыть записи о доходах и расходах."},
		{"target": "meal", "text": "В магазине можно купить еду, напитки и корм для рыбок. Всё купленное отправляется в рюкзак."},
		{"target": "bag", "text": "В облачке рядом со мной — показатели и рюкзак. Там выберу покупку, чтобы поесть, выпить или покормить рыбок."},
		{"target": "bed", "text": "Нажму «Спать», чтобы отдохнуть и начать новую смену."}
	]

static func pencil() -> Array[Dictionary]:
	return [
		{"target": "pencil", "text": "Нажми на карандаш, чтобы взять. Рисуй по бумаге с зажатой левой кнопкой. Правая кнопка вернёт инструмент на стол."},
		{"target": "source", "text": "Найди опечатки в источнике и подчеркни или обведи ошибочные слова. Верные слова не отмечай."},
		{"target": "eraser", "text": "Ластик убирает лишние пометки: возьми его и сотри их с зажатой левой кнопкой. Исправляй статью до печати."},
		{"target": "qualification", "text": "Квалификация показывает качество вычитки. Найденные опечатки приносят награду, пропуски и неверные пометки — штраф. Расчёт будет после печати."}
	]
