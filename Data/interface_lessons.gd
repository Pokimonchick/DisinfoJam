extends RefCounted

static func work(balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "source", "text": "Сначала прочитай источник на столе. Письмо, рапорт или свидетельство — наша основа. Заголовок должен опираться на то, что здесь действительно сказано."},
		{"target": "headline", "text": "Нажми на зелёное поле, чтобы увидеть три записки с заголовками. Нажатие на записку выбирает заголовок. До печати выбор можно заменить."},
		{"target": "choices", "text": "У каждого заголовка своё направление: факты, сенсация или поддержка власти. Важен смысл слов, а не место записки: порядок заголовков меняется в новой игре."},
		{"target": "publish", "text": "Выбрав заголовок, нажми на штамп. Веди курсор на текст статьи или место под ним и нажми ещё раз для печати. Заголовок и кружка исключены. Последствия применяются при ударе; до закрытия итогов силы не расходуются."},
		{"target": "health", "text": "Выносливость — твои силы. Работа и публикации её расходуют. При нуле наступает истощение. Еда и сон дома помогают восстановиться; оставляй силы на дорогу домой."},
		{"target": "reputation", "text": "Репутация — доверие читателей. Проверенные факты укрепляют его, выдумки и искажения разрушают. При нуле читатели сожгут редакцию. От %d публикация тратит %d сил вместо %d." % [int(balance.reader_support.threshold), int(balance.publication_health_cost - balance.reader_support.amount), int(balance.publication_health_cost)]},
		{"target": "loyalty", "text": "Лояльность — отношение государства к нашей газете. Даже правдивая критика власти может его испортить. При нуле тебя арестуют. От %d в начале смены восстанавливается до %d сил." % [int(balance.state_approval.threshold), int(balance.state_approval.amount)]},
		{"target": "combo", "text": "Заголовки одного направления подряд собираются в серию. Множитель усиливает доход и изменения показателей, включая штрафы. Другое направление или новая смена начинает серию заново."},
		{"target": "coffee", "text": "Первая чашка уже здесь, бесплатно. Нажми на кофе, когда понадобятся силы: он восстанавливает до %d выносливости. Следующие чашки покупай дома. Невыпитый кофе остаётся с тобой." % int(balance.coffee_health_restore)},
		{"target": "finish", "text": "Теперь попробуй сама. Если посчитаешь, что на сегодня хватит, нажми «Сдать выпуск». Оставшиеся материалы дождутся следующей смены. Дома сможешь поесть и отдохнуть."}
	]

static func home(balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "money", "text": "Наконец-то дома. За комнату уже списали %d $. Красная сумма рядом с балансом показывает расход. Нужно оставить деньги и на еду; долг не должен достичь %d $." % [balance.rent, balance.debt_limit]},
		{"target": "meal", "text": "В холодильнике можно купить еду за %d $ и восстановить до %d сил. Если нужен небольшой перекус, есть отдельная кнопка: %d $ за %d сил." % [balance.meal_price, int(balance.meal_health), balance.snack_price, int(balance.snack_health)]},
		{"target": "coffee", "text": "Здесь можно взять кофе на следующую смену за %d $. Выпью его уже в редакции. Если чашка осталась с прошлого дня, ещё одну покупать не нужно." % balance.coffee_price},
		{"target": "notebook", "text": "Положу блокнот рядом с чашкой. По нажатию откроются расходы и доходы за этот день и за всё время. Там же видно, какие публикации принесли больше денег."},
		{"target": "bed", "text": "Кровать завершает вечер. После сна восстановится до %d сил и начнётся следующая смена. Если я сильно устала, сначала стоит поесть, а уже потом ложиться спать." % int(balance.sleep_health)}
	]
