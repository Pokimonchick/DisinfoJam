extends RefCounted

static func work(_balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "headline", "text": "Прочитай источник, затем нажми на зелёное поле заголовка."},
		{"target": "choices", "text": "Теперь выбери заголовок для статьи."},
		{"target": "stamp", "text": "После выбора заголовка штамп подсветится. Нажми на него, чтобы взять. Держать кнопку мыши не нужно."},
		{"target": "publish", "text": "Перенеси штамп на текст или место под ним и нажми ещё раз. Правая кнопка вернёт штамп."},
		{"target": "result", "text": "Это последствия публикации. Прочитай записку и закрой её, чтобы перейти к следующей статье."}
	]

static func home(_balance: NewsroomBalance) -> Array[Dictionary]:
	return [
		{"target": "meal", "text": "Открою SHOP: здесь еда, напитки и корм. Покупки попадут в рюкзак. Осмотрюсь и закрою магазин."},
		{"target": "bag", "text": "Теперь открою облачко рядом со мной. Во вкладке Bag можно поесть, выпить или покормить рыбок. Затем закрою окно."},
		{"target": "bed", "text": "Нажму SLEEP, чтобы отдохнуть и начать новую смену."}
	]

static func pencil() -> Array[Dictionary]:
	return [
		{"target": "pencil", "text": "В этой статье есть опечатка. Сначала нажми на карандаш, чтобы взять его."},
		{"target": "source", "text": "В слове «{typo}» опечатка. Подчеркни или обведи его, удерживая левую кнопку мыши."},
		{"target": "return", "text": "Готово! Нажми правую кнопку мыши, чтобы вернуть карандаш. Ластиком можно убрать лишние пометки, а результат вычитки появится после печати."}
	]
