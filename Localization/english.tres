[gd_resource type="Translation" format=3]

[resource]
messages = {
[&"", &"Выберите один заголовок"]: [&"Choose one headline"],
[&"", &"ВЫБРАТЬ ЗАГОЛОВОК  →"]: [&"CHOOSE A HEADLINE  →"],
[&"", &"Красный деревянный карандаш. Клик — взять; удержание левой кнопки — рисовать; правая — положить."]: [&"Red pencil: click to pick up, hold left-click to draw, right-click to put down."],
[&"", &"Заголовок будущей статьи"]: [&"Your article\'s headline"],
[&"", &"Закрыть лист"]: [&"Close sheet"],
[&"", &"Ластик: взять нажатием, стирать с зажатой ЛКМ, положить правой кнопкой."]: [&"Eraser: click to pick up, hold left-click to erase, right-click to put down."],
[&"", &"ВЫЧИТКА ИСТОЧНИКА ДОСТУПНА"]: [&"PROOFREADING AVAILABLE"],
[&"", &"Открыть показатели"]: [&"Show stats"],
[&"", &"Скрыть показатели"]: [&"Hide stats"],
[&"", &"Буль!"]: [&"Blub!"],
[&"", &"Квалификация"]: [&"Skill"],
[&"", &"Репутация"]: [&"Reputation"],
[&"", &"Лояльность"]: [&"Loyalty"],
[&"", &"Выносливость"]: [&"Stamina"],
[&"", &"Силы уже полностью восстановлены."]: [&"Stamina is already full."],
[&"", &"Закончилось. Можно купить ещё."]: [&"All gone. You can buy more."],
[&"", &"В рюкзаке: %d"]: [&"In bag: %d"],
[&"", &"Рюкзак пока пуст.\nЗагляните в магазин за вкусным!"]: [&"Your bag is empty.\nVisit the shop for something tasty!"],
[&"", &"Покупка в рюкзаке!"]: [&"Your purchase is in the bag!"],
[&"", &"Квалификация: пока недоступна"]: [&"Skill: not yet available"],
[&"", &"КВАЛИФИКАЦИЯ\nКачество вашей вычитки. Подчёркивайте или обводите опечатки красным карандашом. Исправления повышают квалификацию; пропущенные ошибки и неверные пометки снижают её. При нуле вас увольняют."]: [&"PROFESSIONAL SKILL\nThe quality of your proofreading. Underline or circle typos with the red pencil. Corrections improve your skill; missed errors and incorrect marks lower it. At zero, you are fired."],
[&"", &"ВЫНОСЛИВОСТЬ\nСилы редактора расходуются во время работы и при публикации.\nВосстанавливайте их едой и сном дома, а кофе выпивайте на работе.\nПри нуле выносливости наступает истощение — кампания заканчивается."]: [&"STAMINA\nEditing and publishing use up your energy.\nRecover with food and sleep at home, and drink coffee at work.\nAt zero stamina, exhaustion ends the campaign."],
[&"", &"РЕПУТАЦИЯ КОМПАНИИ\nДоверие читателей к правдивости газеты. Проверенные сведения укрепляют доверие, выдумки и искажение фактов снижают его.\nПри нуле репутации офис подожгут — кампания заканчивается.\nПри репутации от %d публикация тратит %d выносливости вместо %d."]: [&"THE PAPER\'S REPUTATION\nHow much readers trust your reporting. Verified facts build trust; inventions and distortions erode it.\nAt zero reputation, the office is set on fire and the campaign ends.\nAt %d reputation or higher, publishing costs %d stamina instead of %d."],
[&"", &"Сохранение создано более новой версией игры."]: [&"This save was created by a newer version of the game."],
[&"", &"ЛОЯЛЬНОСТЬ ГОСУДАРСТВУ\nОтношение власти к газете. Похвала власти повышает лояльность, критика — даже правдивая — и ложные сенсации снижают.\nПри нуле — арест и конец кампании.\nОт %d: до +%d выносливости в начале каждой смены."]: [&"GOVERNMENT LOYALTY\nThe authorities\' attitude towards the paper. Praise raises loyalty; criticism, even when true, and fabricated scandals lower it.\nAt zero, you are arrested and the campaign ends.\nAt %d or higher: recover up to %d stamina at the start of each shift."],
[&"", &"Не удалось заменить файл сохранения. Предыдущее сохранение осталось на диске."]: [&"Could not replace the save file. Your previous save is still on disk."],
[&"", &"Не удалось обновить резервную копию."]: [&"Could not update the backup."],
[&"", &"Не удалось записать сохранение на диск."]: [&"Could not write the save to disk."],
[&"", &"Не удалось открыть файл сохранения для записи."]: [&"Could not open the save file for writing."],
[&"", &"Не удалось создать папку сохранений."]: [&"Could not create the save folder."],
[&"", &"Сохранение превышает допустимый размер файла."]: [&"The save exceeds the maximum file size."],
[&"", &"Данные прохождения не удалось сохранить."]: [&"Could not save your progress."],
[&"", &"Не удалось прочитать сохранение и резервную копию."]: [&"Could not read the save or its backup."],
[&"", &"Основной файл недоступен. Использована резервная копия."]: [&"The main save is unavailable. A backup was loaded."],
[&"", &"Кофе с собой"]: [&"Takeaway coffee"],
[&"", &"Еда"]: [&"Food"],
[&"", &"Аренда комнаты"]: [&"Room rent"],
[&"", &"Вычитка: неверные пометки"]: [&"Proofreading: incorrect marks"],
[&"", &"Вычитка: пропущенные опечатки"]: [&"Proofreading: missed typos"],
[&"", &"Вычитка: исправления"]: [&"Proofreading: corrections"],
[&"", &"Никола Коко"]: [&"Nicola Coco"],
[&"", &"Следующий материал"]: [&"Next story"],
[&"", &"Сдать выпуск и пойти домой"]: [&"Finish edition and go home"],
[&"", &"НАПЕЧАТАНО"]: [&"PUBLISHED"],
[&"", &"ВЫПУСК ЗАПОЛНЕН"]: [&"EDITION FULL"],
[&"", &"В текущем выпуске газеты недостаточно места для новых публикаций."]: [&"There is no room for more stories in this edition."],
[&"", &"Все материалы разобраны."]: [&"All stories are done."],
[&"", &"Из них за вычитку: %s · Квалификация: %s"]: [&"Of which, proofreading: %s · Skill: %s"],
[&"", &"\n\n[color=#78512c]Вычитка: исправлено %d · пропущено %d · неверно %d[/color]\n"]: [&"\n\n[color=#78512c]Proofreading: fixed %d · missed %d · wrong %d[/color]\n"],
[&"", &"[color=#6b7046]Выносливость:[/color] [color=%s][b]%s[/b][/color]\n\n%s"]: [&"[color=#6b7046]Stamina:[/color] [color=%s][b]%s[/b][/color]\n\n%s"],
[&"", &"[color=#685078]Лояльность:[/color] %s\n"]: [&"[color=#685078]Loyalty:[/color] %s\n"],
[&"", &"[color=#2e6770]Репутация:[/color] %s\n"]: [&"[color=#2e6770]Reputation:[/color] %s\n"],
[&"", &"[color=#866025]Деньги:[/color] %s\n"]: [&"[color=#866025]Money:[/color] %s\n"],
[&"", &"[color=#78512c]%s · серия %d · ×%.2f[/color]\n\n"]: [&"[color=#78512c]%s · streak %d · ×%.2f[/color]\n\n"],
[&"", &"Все материалы разобраны. Можно сдать выпуск."]: [&"All stories are done. You can finish the edition."],
[&"", &"ВЫПУСК ГОТОВ"]: [&"EDITION READY"],
[&"", &"%s · %d ПОДРЯД"]: [&"%s · %d IN A ROW"],
[&"", &"КОМБО ×%.2f"]: [&"COMBO ×%.2f"],
[&"", &"Выпить: до +%d выносливости"]: [&"Drink: restore up to %d stamina"],
[&"", &"ВЕЧЕР"]: [&"EVENING"],
[&"", &"ФИНАЛ"]: [&"ENDING"],
[&"", &"РАБОТА"]: [&"WORK"],
[&"", &"СМЕНА %02d"]: [&"SHIFT %02d"],
[&"", &"ПРОДОЛЖИТЬ"]: [&"CONTINUE"],
[&"", &"ПОСМОТРЕТЬ ИТОГ"]: [&"VIEW RESULTS"],
[&"", &"%s · день %d · %d $"]: [&"%s · day %d · %d $"],
[&"", &"Сохранение недоступно."]: [&"Save unavailable."],
[&"", &"Сохранений пока нет."]: [&"No save yet."],
[&"", &"%s · Первая неделя: %d / %d смен"]: [&"%s · First week: %d / %d shifts"],
[&"", &"Прогресс будет сохраняться автоматически."]: [&"Your progress will be saved automatically."],
[&"", &"Начало новой истории заменит текущее сохранение."]: [&"Starting a new story will replace your current save."],
[&"", &"Сдать выпуск"]: [&"Finish edition"],
[&"", &"Продолжить работу"]: [&"Keep working"],
[&"", &"Выносливости осталось мало. Сдай выпуск и вернись домой, чтобы поесть и отдохнуть.\n\nМожно закрыть это предупреждение и продолжить работу. При нуле сил наступит истощение."]: [&"Your stamina is low. Finish the edition and go home for food and rest.\n\nYou can dismiss this warning and keep working. If your stamina reaches zero, you will collapse from exhaustion."],
[&"", &"Силы на исходе"]: [&"Running on empty"],
[&"", &"ПОРА ПЕРЕДОХНУТЬ"]: [&"TIME FOR A BREAK"],
[&"", &"БОСС"]: [&"BOSS"],
[&"", &"НИКОЛА КОКО · ПРО СЕБЯ"]: [&"NICOLA COCO · TO HERSELF"],
[&"", &"Сохранить и в меню"]: [&"Save and return to menu"],
[&"", &"Продолжить"]: [&"Continue"],
[&"", &"Выносливость не расходуется.\n\nПрогресс сохраняется автоматически. После выхода в меню можно продолжить с этого места."]: [&"Stamina is not being spent.\n\nYour progress is saved automatically. You can return to the menu and continue from here later."],
[&"", &"Выпуск подождёт."]: [&"The edition can wait."],
[&"", &"ПАУЗА"]: [&"PAUSED"],
[&"", &"НОВОЕ ПРОХОЖДЕНИЕ"]: [&"NEW PLAYTHROUGH"],
[&"", &"ПОСЛЕДНИЙ ВЫПУСК"]: [&"THE LAST EDITION"],
[&"", &"ИТОГИ НЕДЕЛИ"]: [&"THE WEEK IN REVIEW"],
[&"", &"СЪЁМНАЯ КОМНАТА"]: [&"RENTED ROOM"],
[&"", &"РАБОЧИЙ СТОЛ"]: [&"EDITOR\'S DESK"],
[&"", &"ПЕРЕД ПЕРВОЙ СМЕНОЙ"]: [&"BEFORE THE FIRST SHIFT"],
[&"", &"ГЛАВА I · АМНЕЗИЯ"]: [&"CHAPTER I · AMNESIA"],
[&"", &"НЕЗАВИСИМАЯ РЕДАКЦИЯ"]: [&"INDEPENDENT NEWSROOM"],
[&"", &"В главное меню"]: [&"Main menu"],
[&"", &"Новая история"]: [&"New story"],
[&"", &"КОНЕЦ ИСТОРИИ"]: [&"THE END"],
[&"", &"КОНЕЦ ПЕРВОЙ ГЛАВЫ"]: [&"END OF CHAPTER ONE"],
[&"", &"\n\nПоследний заголовок: «%s»"]: [&"\n\nLast headline: “%s”"],
[&"", &"%s\n\nЗавершено смен: %d. Напечатано материалов: %d.\nДеньги: %d $ · репутация: %d · государство: %d."]: [&"%s\n\nShifts completed: %d. Stories published: %d.\nMoney: %d $ · reputation: %d · government loyalty: %d."],
[&"", &"Сразу к работе"]: [&"Straight to work"],
[&"", &"Я прошла первую рабочую неделю. Прошлое пока не вернулось, но теперь у меня есть первая зацепка.\n\nСпасибо за прохождение демо «До печати». Первая глава завершена. История героини продолжится за пределами этой версии."]: [&"I made it through my first working week. My past has not returned, but now I have my first lead.\n\nThank you for playing the Before the Press demo. Chapter One is complete. Nicola\'s story continues beyond this version."],
[&"", &"Первая неделя позади"]: [&"The first week is over"],
[&"", &"Квалификация упала до нуля. Начальник возвращает лист с пропущенными ошибками и забирает красный карандаш. «Больше я не могу доверять тебе выпуск». Завтра твоё место займёт другой редактор."]: [&"Your professional skill fell to zero. The boss hands back a sheet full of missed errors and takes away the red pencil. “I can no longer trust you with an edition.” Tomorrow, another editor will take your place."],
[&"", &"Последняя корректура"]: [&"The final proof"],
[&"", &"Долг достиг предела. Хозяин комнаты сменил замок, а кредиторы забрали последние вещи. Сегодня вместо кровати — картонка под навесом."]: [&"Your debt reached its limit. The landlord changed the lock, and your creditors took your last belongings. Tonight\'s bed is a piece of cardboard under an awning."],
[&"", &"Ночлег на картонке"]: [&"A cardboard bed"],
[&"", &"Лояльность государству упала до нуля. В дверь постучали сотрудники госбезопасности. Правдивость отдельных статей не стала для них оправданием."]: [&"Government loyalty fell to zero. State security officers knocked at the door. The truth of certain articles was no defence as far as they were concerned."],
[&"", &"За вами уже пришли"]: [&"They have come for you"],
[&"", &"Репутация компании упала до нуля. Люди, которых обманывали ваши заголовки, собрались у офиса. К утру от редакции остались обугленные стены."]: [&"The paper\'s reputation fell to zero. The people your headlines had deceived gathered outside the office. By morning, only charred walls remained."],
[&"", &"Редакция больше не печатает"]: [&"The presses fall silent"],
[&"", &"Выносливость закончилась. Ещё один выпуск оказался важнее ужина, и организм не выдержал. Редакция завтра откроется — уже без тебя."]: [&"Your stamina ran out. One more edition mattered more than dinner, and your body gave up. The newsroom will open tomorrow — without you."],
[&"", &"Последняя смена"]: [&"The last shift"],
[&"", &"Этот товар пока недоступен."]: [&"This item is currently unavailable."],
[&"", &"Сейчас не время для покупок."]: [&"Now is not the time to shop."],
[&"", &"Силы уже полностью восстановлены. Прибережём на потом."]: [&"Stamina is already full. Let\'s save it for later."],
[&"", &"Этот запас уже закончился."]: [&"You have run out of this item."],
[&"", &"В рюкзаке уже достаточно этого товара. Сначала используйте запас."]: [&"Your bag is full of this item. Use some of your stock first."],
[&"", &"На эту покупку пока не хватает денег. В редакции ещё ждут новые материалы."]: [&"You cannot afford this yet. There are more stories waiting at the newsroom."],
[&"", &"%s: +%d к выносливости."]: [&"%s: +%d stamina."],
[&"", &"Рыбки получили ужин. Кажется, обе довольны."]: [&"Dinner is served. Both fish seem pleased."],
[&"", &"ПОДДЕРЖКА ВЛАСТИ"]: [&"GOVERNMENT SUPPORT"],
[&"", &"СЕНСАЦИЯ"]: [&"SENSATIONALISM"],
[&"", &"ФАКТЫ"]: [&"FACTS"],
[&"", &"Посмотреть варианты заголовка"]: [&"View headline options"],
[&"", &"Заменить заголовок"]: [&"Change headline"],
[&"", &"Выбрать заголовок…"]: [&"Choose a headline…"],
[&"", &"День %d · %s · %s $\n"]: [&"Day %d · %s · %s $\n"],
[&"", &"Записей пока нет.\n"]: [&"No entries yet.\n"],
[&"", &"ОПЕРАЦИИ — СНАЧАЛА НОВЫЕ\n"]: [&"TRANSACTIONS — NEWEST FIRST\n"],
[&"", &"пока нет доходов"]: [&"no income yet"],
[&"", &"Больше всего приносит: %s\n\n"]: [&"Top earner: %s\n\n"],
[&"", &"Исправления при вычитке: %s $\n"]: [&"Proofreading corrections: %s $\n"],
[&"", &"\nДОХОДЫ ОТ ПУБЛИКАЦИЙ\n"]: [&"\nPUBLICATION INCOME\n"],
[&"", &"РАСХОДЫ\n"]: [&"EXPENSES\n"],
[&"", &"Доходы: +%d $     Расходы: −%d $     Итог: %s $\n\n"]: [&"Income: +%d $     Expenses: −%d $     Net: %s $\n\n"],
[&"", &"Старое сохранение: история расходов неполная; сохранены известные публикации.\n\n"]: [&"Older save: expense records are incomplete; known publications have been preserved.\n\n"],
[&"", &"День %d\n"]: [&"Day %d\n"],
[&"", &"Все дни\n"]: [&"All days\n"],
[&"", &"Записей пока нет."]: [&"No entries yet."],
[&"", &"Все дни"]: [&"All days"],
[&"", &"Сегодня"]: [&"Today"],
[&"", &"Закрыть"]: [&"Close"],
[&"", &"Close"]: [&"Close"],
[&"", &"Финансовый блокнот"]: [&"Accounts notebook"],
[&"", &"Операция"]: [&"Transaction"],
[&"", &"Публикация"]: [&"Publication"],
[&"", &"Поддержка власти"]: [&"Government support"],
[&"", &"Сенсация"]: [&"Sensationalism"],
[&"", &"Напитки в рюкзак"]: [&"Drinks for the bag"],
[&"", &"Корм для рыбки"]: [&"Fish Food"],
[&"", &"Пропущенные опечатки"]: [&"Missed typos"],
[&"", &"Неверные пометки"]: [&"Incorrect marks"],
[&"", &"Факты"]: [&"Facts"],
[&"", &"Карандаш: нажми, чтобы взять; удерживай левую кнопку для пометок. Правая кнопка возвращает карандаш."]: [&"Pencil: click to pick up; hold the left mouse button to mark the text. Right-click to put it back."],
[&"", &"Ластик: нажми, чтобы взять; удерживай левую кнопку, чтобы стирать пометки. Правая кнопка возвращает ластик."]: [&"Eraser: click to pick up; hold the left mouse button to erase marks. Right-click to put it back."],
[&"", &"Аренда"]: [&"Rent"],
[&"", &"Нажми на штамп, перенеси курсор на текст статьи или место под ним и нажми ещё раз для печати."]: [&"Click the stamp, move the cursor onto the article text or the space below it, then click again to publish."],
[&"", &"Еда в рюкзак"]: [&"Food for the bag"],
[&"", &"Кофе"]: [&"Coffee"],
[&"", &"Перекус"]: [&"Snack"],
[&"", &"Полноценная еда"]: [&"Full meal"],
[&"", &"НАЖАТЬ, ЧТОБЫ ПРОЧИТАТЬ"]: [&"CLICK TO READ"],
[&"", &"Глава компании отказался давать комментарии."]: [&"The head of the company declined to comment."],
[&"", &"Подробности происшествия не уточняются."]: [&"No further details of the incident have been provided."],
[&"", &"Причиной стала техногенная авария на производстве."]: [&"It was caused by an industrial accident at the plant."],
[&"", &"Ходят слухи"]: [&"There are rumors"],
[&"", &"есть у меня предположение"]: [&"I have a theory"],
[&"", &"я их не видел уже целых два дня"]: [&"I have not seen them for two whole days"],
[&"", &"Я думаю о тебе и, как цветок, расцветаю"]: [&"I think of you and blossom like a flower"],
[&"", &"Но надеюсь, ты не знаешь, что лишь об этом я мечтаю."]: [&"But hope you do not know it’s all I dream of, night and day."],
[&"", &"автор стихов пожелала остаться анонимной"]: [&"the poet has asked to remain anonymous"],
[&"", &"Ходят слухи, что некоторые кошки устраиваются помощниками влиятельных особ"]: [&"Rumor has it that some cats take jobs as assistants to influential figures"],
[&"", &"возмущённые посетители уже требуют увольнения повара"]: [&"outraged diners are already demanding the chef’s dismissal"],
[&"", &"шеф-поваром оказалась крыса по имени Рататуй"]: [&"the head chef turned out to be a rat named Ratatouille"],
[&"", &"недавняя санитарная проверка не выявила нарушений"]: [&"a recent health inspection found no violations"],
[&"", &"По словам очевидцев"]: [&"According to eyewitnesses"],
[&"", &"Маленький ужин для самой молчаливой соседки Николы Коко."]: [&"A little dinner for Nicola Coco’s quietest roommate."],
[&"", &"Рататуй обещал лёгкую остринку. Кажется, у него другие представления о лёгкости."]: [&"Ratatouille promised a gentle kick. Apparently, his idea of gentle is different."],
[&"", &"Острый рамён"]: [&"Spicy Ramyun"],
[&"", &"Горячая лапша после смены. Рататуй советует не есть над рукописью."]: [&"Hot noodles after a shift. Ratatouille advises keeping them away from manuscripts."],
[&"", &"Рамён"]: [&"Ramyun"],
[&"", &"Молочная пенка прячет кофе лучше, чем де Мур — плохие новости."]: [&"Milk foam hides coffee better than de Meur hides bad news."],
[&"", &"Кофе латте"]: [&"Caffè Latte"],
[&"", &"Горячий шоколад"]: [&"Hot Chocolate"],
[&"", &"Лапы греются, мысли собираются. Газету в чашку не макать."]: [&"Warm paws, collected thoughts. Do not dunk the newspaper."],
[&"", &"Зелёная пауза для Николы Коко. Взбодрит даже после разговора с де Муром."]: [&"A green break for Nicola Coco. A pick-me-up even after a conversation with de Meur."],
[&"", &"Матча"]: [&"Matcha"],
[&"", &"Готово! Нажми правую кнопку мыши, чтобы вернуть карандаш. Ластиком можно убрать лишние пометки, а результат вычитки появится после печати."]: [&"Done! Right-click to put the pencil back. Use the eraser to remove unwanted marks. Your proofreading results will appear after printing."],
[&"", &"В слове «{typo}» опечатка. Подчеркни или обведи его, удерживая левую кнопку мыши."]: [&"There is a typo in “{typo}”. Underline or circle it while holding the left mouse button."],
[&"", &"В этой статье есть опечатка. Сначала нажми на карандаш, чтобы взять его."]: [&"There is a typo in this article. First, click the pencil to pick it up."],
[&"", &"Это последствия публикации. Прочитай записку и закрой её, чтобы перейти к следующей статье."]: [&"These are the consequences of publishing. Read the note and close it to move on to the next article."],
[&"", &"Перенеси штамп на текст или место под ним и нажми ещё раз. Правая кнопка вернёт штамп."]: [&"Move the stamp over the text or the space below it, then click again. Right-click to put the stamp back."],
[&"", &"После выбора заголовка штамп подсветится. Нажми на него, чтобы взять. Держать кнопку мыши не нужно."]: [&"Once you choose a headline, the stamp will light up. Click it to pick it up. You do not need to hold the mouse button."],
[&"", &"Теперь выбери заголовок для статьи."]: [&"Now choose a headline for the article."],
[&"", &"Теперь открою облачко рядом со мной. Во вкладке «Рюкзак» можно поесть, выпить или покормить рыбок. Затем закрою окно."]: [&"Now I’ll open the bubble next to me. In the Bag tab, I can eat, drink or feed the fish. Then I’ll close the window."],
[&"", &"Нажму СПАТЬ, чтобы отдохнуть и начать новую смену."]: [&"I’ll press SLEEP to rest and start a new shift."],
[&"", &"Открою МАГАЗИН: здесь еда, напитки и корм. Покупки попадут в рюкзак. Осмотрюсь и закрою магазин."]: [&"I’ll open SHOP: food, drinks and fish food are sold here. My purchases will go into my bag. I’ll have a look around, then close the shop."],
[&"", &"Прочитай источник, затем нажми на зелёное поле заголовка."]: [&"Read the source, then click the green headline field."],
[&"", &"Итоги первой недели"]: [&"First week’s results"],
[&"", &"Я кладу карточку рядом с запиской, на которой в первый день написала имя. За эту неделю у меня появилась работа и несколько дней, которые я помню.\n\nТеперь я знаю, что раньше была корректором. Где находился этот архив? Почему мне пришлось сохранить исходник? И как я оказалась на улице?\n\nНа чистом листе пишу: «Найти архивный отдел». Складываю его вместе с карточкой. В понедельник я вернусь в редакцию."]: [&"I place the card beside the note where I wrote my name on the first day. This week has given me a job and a few days I can remember.\n\nNow I know I used to be a proofreader. Where was that archive? Why did I have to keep the original? And how did I end up on the street?\n\nOn a clean sheet I write: “Find the Archive Department.” I fold it together with the card. On Monday, I will return to the newsroom."],
[&"", &"Первый факт обо мне"]: [&"The First Fact About Me"],
[&"", &"Забрать карточку"]: [&"Take the card"],
[&"", &"Последний выпуск недели сдан. Перед уходом я складываю старые корректуры обратно в коробку. Из разорванной папки выпадает карточка.\n\nНа ней моя фотография. Под снимком: «Корректор. Архивный отдел». Край с именем оторван. На обороте — перечень оттисков и тот самый разомкнутый кружок.\n\nЯ подношу карточку к лицу и смотрю на своё отражение в тёмном окне. Это я. Я уже работала с такими текстами."]: [&"The week’s final edition is in. Before leaving, I put the old proofs back in the box. A card falls out of a torn folder.\n\nIt has my photograph on it. Underneath: “Proofreader. Archive Department.” The edge with the name has been torn off. On the back is a list of proofs and that same open circle.\n\nI hold the card up to my face and look at my reflection in the dark window. It is me. I have worked with texts like these before."],
[&"", &"Карточка между листами"]: [&"A Card Between the Pages"],
[&"", &"КОНЕЦ ПЯТОГО ДНЯ · АРХИВ"]: [&"END OF DAY FIVE · ARCHIVE"],
[&"", &"Начать четвёртую смену"]: [&"Begin the fourth shift"],
[&"", &"Шелест листов. Я складываю первоначальный текст вчетверо и прячу под обложку папки. Снаружи остаётся исправленная версия.\n\nВ коридоре слышны шаги. Я прижимаю папку к себе. Дальше — пустота.\n\nНа столе лежит старый оттиск. Я не знаю, видела ли именно его. Но теперь хочу выяснить, кто делал эти пометки и что случилось с сохранёнными оригиналами."]: [&"The rustle of paper. I fold the original text into quarters and hide it inside a folder’s cover. The revised version stays on the outside.\n\nFootsteps in the corridor. I clutch the folder to my chest. After that, nothing.\n\nAn old proof lies on the desk. I do not know if I have seen this particular one before. But now I want to find out who made these marks, and what happened to the originals they kept."],
[&"", &"Не выбрасывать"]: [&"Do Not Throw Away"],
[&"", &"Перевернуть лист"]: [&"Turn the sheet over"],
[&"", &"Из той же архивной коробки мне достаётся лист с двумя вариантами сообщения о закрытии мастерской.\n\nВ исходном тексте: «Двое работников подали жалобы на условия труда». В подготовленной к печати версии: «Жалоб от работников не поступало».\n\nВозле заменённой строки — разомкнутый красный кружок. Под ним приписка: «Сохранить исходник». Эти слова я будто уже писала."]: [&"From the same archive box, I get a sheet with two versions of a report about a workshop closing.\n\nThe original reads: “Two workers filed complaints about working conditions.” In the version prepared for print: “No complaints have been received from workers.”\n\nBeside the replaced line is an open red circle. Below it, a note: “Keep the original.” I feel as though I have written those words before."],
[&"", &"Две версии одной строки"]: [&"Two Versions of One Line"],
[&"", &"ДЕНЬ 4 · ДО НАЧАЛА СМЕНЫ"]: [&"DAY 4 · BEFORE THE SHIFT"],
[&"", &"Начать вторую смену"]: [&"Begin the second shift"],
[&"", &"Другой стол. Свет падает слева. Под ладонью шершавая бумага, на пальце красная полоска.\n\nЯ обвожу строку. Чужая рука накрывает лист прежде, чем я успеваю дописать.\n\nМоргаю — передо мной снова расписание рынка. Не помню ни лица, ни того, что было в закрытой строке. На обороте записываю: «Знакомая пометка. Это ещё не доказательство»."]: [&"A different desk. Light falling from the left. Rough paper beneath my palm, a red streak on my finger.\n\nI circle a line. Someone’s hand covers the sheet before I can finish writing.\n\nI blink. The market schedule is in front of me again. I remember neither a face nor what was in the hidden line. On the back I write: “A familiar mark. This is not evidence yet.”"],
[&"", &"Красный карандаш"]: [&"The Red Pencil"],
[&"", &"ОБРЫВОК ВОСПОМИНАНИЯ"]: [&"A FRAGMENT OF MEMORY"],
[&"", &"Присмотреться к пометке"]: [&"Look more closely at the mark"],
[&"", &"Я возвращаюсь в редакцию на вторую смену. Начальник достаёт из архивной коробки старую корректуру.\n\n— Сегодня займёшься ещё и вычиткой. Возьми красный карандаш. Ошибки подчёркивай или обводи, только не порти верные слова.\n\nНа оттиске: «Рынок откроется в восемь. Разгрузка товаров начнётся в шесть». На полях красным: «Не путать разгрузку с открытием». Рядом разомкнутый кружок с короткой чертой. Я провожу пальцем по его контуру. Почему хочется закончить эту черту именно так?"]: [&"I return to the newsroom for my second shift. The boss takes an old proof from an archive box.\n\n“You’ll be proofreading today, too. Take the red pencil. Underline or circle mistakes, but leave the correct words alone.”\n\nThe proof reads: “The market opens at eight. Deliveries will be unloaded from six.” In red in the margin: “Do not confuse unloading with opening.” Beside it, an open circle with a short stroke. I trace its outline with my finger. Why do I want to finish that stroke in just this way?"],
[&"", &"Пометка на полях"]: [&"A Mark in the Margin"],
[&"", &"ДЕНЬ 2 · ДО НАЧАЛА СМЕНЫ"]: [&"DAY 2 · BEFORE THE SHIFT"],
[&"", &"Выслушать инструктаж"]: [&"Listen to the briefing"],
[&"", &"— По объявлению? Читать умеешь?\n\nЯ киваю. Сказать ничего не могу. Беру предложенный карандаш и пишу на обороте объявления: «Я не говорю. Могу отвечать письменно». Ниже исправляю пропущенную букву.\n\nНачальник подвигает ко мне чистый лист.\n— Хорошо. Как тебя записать?\n\nЯ вывожу: «{name}». Не знаю, называли ли меня так раньше. Сейчас это имя будет моим.\n\n— Садись. За напечатанные материалы платим сразу. Комнату найдёшь за углом, там берут посуточно. А пока покажу, как сдавать выпуск."]: [&"“Here about the notice? Can you read?”\n\nI nod. I cannot say anything. I take the pencil I am offered and write on the back of the notice: “I cannot speak. I can answer in writing.” Below it, I add a letter I missed.\n\nThe boss slides a blank sheet toward me.\n“All right. What name shall I put down?”\n\nI write: “{name}”. I do not know whether anyone called me that before. For now, this name will be mine.\n\n“Sit down. We pay as soon as your pieces are printed. You can find a room around the corner; they charge by the day. For now, I’ll show you how to put out an edition.”"],
[&"", &"Как тебя записать?"]: [&"What Name Shall I Put Down?"],
[&"", &"ПЕРВЫЙ ДЕНЬ · ЗНАКОМСТВО"]: [&"DAY ONE · INTRODUCTIONS"],
[&"", &"Войти в редакцию"]: [&"Enter the newsroom"],
[&"", &"Под спиной размокший картон. Я знаю, как называется эта улица: прочитала табличку. Как оказалась здесь — не помню.\n\nВ карманах нет ни документов, ни записки. Я пытаюсь представить вчерашний день и не нахожу ничего. Только сегодняшний холод и голод.\n\nНа двери редакции объявление: «Нужен сотрудник для работы с текстами». Буквы мне понятны. Может быть, этого хватит, чтобы войти."]: [&"Soggy cardboard beneath my back. I know this street’s name: I read the sign. How I got here, I cannot remember.\n\nThere are no papers in my pockets, no note. I try to picture yesterday and find nothing. Only today’s cold and hunger.\n\nA notice on the newsroom door: “Wanted: someone to work with texts.” I understand the words. Maybe that is enough to get me through the door."],
[&"", &"С чего-то нужно начать"]: [&"You Have to Start Somewhere"],
[&"", &"Вместо выяснения причин аварии газета предложила читателям довериться управе. Власти довольны поддержкой, читатели остались без ответов."]: [&"Instead of examining the accident’s causes, the paper asked readers to trust the council. The authorities welcome the support; readers still have no answers."],
[&"", &"Бриполис в надёжных лапах: пыль не повод сомневаться в управе"]: [&"Bripolis in safe paws: dust is no reason to doubt the council"],
[&"", &"Пыль над кварталом превратилась в известие о массовой гибели. Мрачный заголовок привлёк покупателей, но о жертвах предприятие не сообщало."]: [&"Dust above a neighborhood became news of mass fatalities. The grim headline drew buyers, but the company reported no casualties."],
[&"", &"Чёрный день для рыжих! Угольная авария унесла целый квартал жителей"]: [&"A black day for ginger cats! Coal accident kills an entire block of residents"],
[&"", &"Вы сообщили об аварии и честно оставили неизвестные подробности неизвестными. Предприятие молчит, но газета не заполняет это молчание догадками."]: [&"You reported the accident and honestly left unknown details unknown. The company is silent, but the newspaper does not fill that silence with guesswork."],
[&"", &"Угольная пыль накрыла «Рыжих Пушистиков»: предприятие сообщает об аварии"]: [&"Coal dust blankets Ginger Fluffballs: company reports accident"],
[&"", &"Над районом «Рыжие Пушистики» поднялся столб угольной пыли. Причиной стала техногенная авария на производстве.\n\nПодробности происшествия не уточняются. Глава компании отказался давать комментарии."]: [&"A column of coal dust rose over the Ginger Fluffballs district. It was caused by an industrial accident at the plant.\n\nNo further details of the incident have been provided. The head of the company declined to comment."],
[&"", &"Сообщение угледобывающего предприятия · Рыжие Пушистики"]: [&"Coal company statement · Ginger Fluffballs"],
[&"", &"Управа получила приятное обещание полной безопасности, которого не давала и не подтверждала. Успокаивать читателей можно и без выдуманной гарантии."]: [&"The council received a welcome promise of complete safety that it neither made nor confirmed. You can reassure readers without inventing a guarantee."],
[&"", &"Рыжие под надёжной лапой управы. Просьба не заворачивать слухи в сыр"]: [&"Gingers safe under the council’s paw. Please don’t wrap rumors in cheese"],
[&"", &"Автор не видел знакомых кошек два дня. Ни мышей-похитителей, ни тем более сыроварню это не подтверждает. Страшилка продаётся лучше письма: пока читатели не потребуют доказательств."]: [&"The writer has not seen some familiar cats for two days. That confirms neither mouse abductors nor, much less, a cheese factory. A scare story outsells a letter—until readers demand evidence."],
[&"", &"Из рыжих кошек Бриполиса делают новый сорт сыра!"]: [&"Bripolis ginger cats turned into a new variety of cheese!"],
[&"", &"Вы передали тревогу автора, не объявляя исчезновение всех рыжих доказанным фактом. О похищении у редакции пока только слух."]: [&"You conveyed the writer’s concern without declaring the disappearance of all ginger cats an established fact. For now, the newsroom has only a rumor about an abduction."],
[&"", &"Куда пропали рыжие? В редакцию пришло тревожное письмо"]: [&"Where have the gingers gone? A worried letter reaches the newsroom"],
[&"", &"Рыжие кошки внезапно исчезли из города: я их не видел уже целых два дня!\n\nБоюсь делать поспешные выводы, но есть у меня предположение, что их похитили мыши в чёрном… Ходят слухи, что они похищают граждан Бриполиса для своих экспериментов. Кто знает, что они с ними сделали!"]: [&"Ginger cats have suddenly vanished from the city: I have not seen them for two whole days!\n\nI am afraid to jump to conclusions, but I have a theory that mice in black have abducted them… There are rumors that they abduct Bripolis citizens for their experiments. Who knows what they have done to them!"],
[&"", &"Письмо тревожного гражданина · Рыжие Пушистики"]: [&"Letter from a worried citizen · Ginger Fluffballs"],
[&"", &"Письмо о личной нерешительности ничего не говорит о заслугах государства. Читатели видят придуманную похвалу, кошачья власть одобряет удобное ей объяснение чужих чувств."]: [&"A letter about personal hesitation says nothing about the state’s achievements. Readers see invented praise, while the feline authorities approve of this convenient explanation for someone else’s feelings."],
[&"", &"Кошачья власть подарила Бриполису свободу любить и быть счастливым"]: [&"Feline authorities give Bripolis the freedom to love and be happy"],
[&"", &"Отказ коллеги выдуман: автор ещё не призналась. Читатели разочарованы обманом, власти хуже оценивают редакцию, искажающую частные письма."]: [&"You invented the colleague’s rejection: the writer has not confessed her feelings yet. Readers are disappointed by the deception, and the authorities think less of a newsroom that distorts private letters."],
[&"", &"Мы больше никогда не будем вместе! Коллега отверг несчастную героиню нашей прессы."]: [&"We will never be together again! Colleague rejects the unfortunate heroine of our pages."],
[&"", &"Вы поддержали интерес к письму, не добавляя несуществующих событий. Читатели доверяют продолжению; личная колонка не оценивает действия властей."]: [&"You kept readers interested in the letter without inventing events. Readers trust the next chapter; a personal column passes no judgment on the authorities’ actions."],
[&"", &"«Oops!... It\'s happening again. Продолжение истории любви уже вышло!»"]: [&"“Oops!... It’s happening again. The next chapter of our love story is out!”"],
[&"", &"(Примечание к статье: автор пожелала остаться анонимной)\nКажется, после тех стихов я стала смелее только на бумаге. С каждым днём я понимаю, что всё сильнее влюбляюсь в коллегу и представляю, как мы гуляем вдвоём. Но стоит встретиться с ним на работе, как все заготовленные слова вылетают из головы. От одного его взгляда становится так тепло, что я потом ещё долго улыбаюсь своим мыслям. Не знаю, читает ли он газету, просто мне очень хотелось с кем-нибудь поделиться своими чувствами. Как вы считаете, стоит ли признаться ему лично?\n\nКомментарий читательницы\nДевочка, будь смелее! Я уже покупаю эту газету только ради продолжения вашей истории!\n\nОтвет другого читателя\nМне бы кто такие стихи посвятил! Я бы после этого сам пригласил её на свидание, не раздумывая.\n\n(Ниже читатели продолжают подбадривать автора и советуют решиться на признание.)"]: [&"(Editor’s note: the writer has asked to remain anonymous)\nIt seems those poems only made me braver on paper. Every day I realize I am falling harder for my colleague and imagine the two of us out walking together. But the moment I see him at work, every word I rehearsed flies out of my head. A single glance from him makes me feel so warm that I spend ages afterward smiling to myself. I do not know if he reads the paper; I just really wanted to share my feelings with someone. Do you think I should tell him in person?\n\nA reader’s comment\nGirl, be brave! I am already buying this paper just to find out what happens next in your story!\n\nAnother reader’s reply\nIf only someone wrote me poems like that! I would ask her out myself without a second thought.\n\n(Below, readers continue to encourage the writer and urge her to take the plunge.)"],
[&"", &"Blooming feelings · Второе письмо"]: [&"Blooming feelings · A second letter"],
[&"", &"Неуверенное признание одной читательницы стало похвалой государству за счастье всего города. Читатели замечают домысел, кошачьей власти приятна незаслуженная благодарность."]: [&"One reader’s uncertain confession became praise for the state for the happiness of an entire city. Readers notice the invention, while the feline authorities enjoy the unearned thanks."],
[&"", &"Бриполис: город счастливой любви: спасибо кошачьей власти!"]: [&"Bripolis: a city of happy love, thanks to our feline authorities!"],
[&"", &"Коллега добавлен в историю, хотя автор его не называла. Читатели замечают домысел, власти немного меньше доверяют аккуратности редакции."]: [&"You added a colleague to the story, although the poet never mentioned one. Readers notice the speculation, and the authorities have slightly less faith in the newsroom’s accuracy."],
[&"", &"Кому принадлежит анонимное признание? Узнает ли её коллега себя в этих стихах?"]: [&"Who penned this anonymous confession? Will her colleague recognize himself in these verses?"],
[&"", &"Вы передали содержание стихов, не угадывая адресата и не объявляя отношений. Читатели доверяют деликатной подаче, частная колонка не оценивает государство."]: [&"You conveyed the poem’s content without guessing its addressee or declaring a relationship. Readers trust your sensitivity; a personal column passes no judgment on the state."],
[&"", &"Анонимная читательница поделилась стихами о любви и ожидании встречи"]: [&"Anonymous reader shares a poem about love and longing to meet again"],
[&"", &"(Примечание к статье: автор стихов пожелала остаться анонимной)\nМилый, столько дней прошло с нашего последнего разговора.\nЯ скучаю и верю, что ты придёшь за мной скоро.\nКак свою принцессу, меня заберешь представляю,\nНо надеюсь, ты не знаешь, что лишь об этом я мечтаю.\n\nНе волнуйся, просто будь чуть-чуть смелей.\nЕсть только мы с тобой, и нет для нас других путей.\n\nТы украл моё сердце, и я к тебе так привязалась.\nЗнаю, я в этой любви совсем потерялась.\nЯ думаю о тебе и, как цветок, расцветаю,\nИ от любви к тебе я просто голову теряю.\n\n(Комментарий в конце колонки: Газета не место где вы можете писать о своих чувствах!\nОтвет на комментарий: Уважаемый господин, если у вас не сложилась личная жизнь, будьте любезны не портить ее другим.)"]: [&"(Editor’s note: the poet has asked to remain anonymous)\nMy dear, so many days have passed since last we spoke.\nI miss you, and I trust you’ll come for me before too long.\nI dream you’ll take me as your princess, carry me away,\nBut hope you do not know it’s all I dream of, night and day.\n\nDon’t worry, just be a little braver.\nThere’s only you and me; together is where we belong.\n\nYou stole my heart; I’ve grown so close to you.\nI know I’m lost in love, and don’t know what to do.\nI think of you and blossom like a flower,\nAnd loving you, I lose my head with every passing hour.\n\n(Comment at the end of the column: A newspaper is no place to write about your feelings!\nReply: Dear sir, if your love life has gone wrong, kindly refrain from ruining everyone else’s.)"],
[&"", &"Blooming feelings · Анонимное стихотворение"]: [&"Blooming feelings · Anonymous poem"],
[&"", &"Обвинение повара противоречит экспертизе, журналу врача и признанию посетителя. Читатели видят грубый обман, санитарное бюро осуждает отвержение доказательств."]: [&"The accusation against the chef contradicts the analysis, doctor’s log and diner’s confession. Readers see blatant deception, and the Health Bureau condemns your rejection of the evidence."],
[&"", &"Крыса отравила несчастного посетителя ресторана и избежала приговора!"]: [&"Rat poisons unfortunate diner and gets away with it!"],
[&"", &"Вы точно передали подтверждённый результат повторной проверки. Доверие читателей растёт, санитарное бюро особенно одобряет акцент на своей работе."]: [&"You accurately reported the verified findings of the repeat inspection. Readers’ trust grows, and the Health Bureau particularly approves of the focus on its work."],
[&"", &"Санитарное бюро вновь признало кухню «Le Goutet» чистой"]: [&"Health Bureau again declares Le Goutet’s kitchen clean"],
[&"", &"Экспертиза, запись врача и признание разоблачают подлог. Читатели высоко ценят доказанное расследование, санитарной службе приятно подтверждение обоснованности её проверки."]: [&"The analysis, doctor’s log and confession expose the setup. Readers greatly value an investigation backed by evidence, and the health service welcomes confirmation that its inspection was sound."],
[&"", &"Кот подбросил свою шерсть, чтобы выжить крысу из ресторана"]: [&"Cat planted his own fur to drive rat out of restaurant"],
[&"", &"(Примечание к выпуску: Почему коты так не любят крыс и мышей?\nОтвет под примечанием: Возможно тебе лучше задать этот вопрос самопровозглашённому герою этой прессы.)\nКонфликт между рестораном «Le Goutet» и господином де Муром закончен, а обвинения против повара Рататуя сняты. Санитарное бюро провело экспертизу и установило, что шерсть из тарелки господина де Мура принадлежала ему самому. Кроме того, запись в журнале врача показала, что де Мур обращался с отравлением ещё утром, за несколько часов до посещения ресторана.\nПрижатый к стенке, де Мур признался, что подстроил эту историю, желая добиться увольнения Рататуя.\nПовторная санитарная проверка в очередной раз подтвердила чистоту кухни."]: [&"(Editor’s note: Why do cats dislike rats and mice so much?\nReply below the note: Perhaps you should ask the self-appointed hero of this newspaper.)\nThe dispute between Le Goutet and Mr de Meur is over, and the allegations against the chef, Ratatouille, have been dropped. The Health Bureau’s analysis established that the fur in Mr de Meur’s bowl was his own. A doctor’s log also showed that de Meur had sought treatment for food poisoning earlier that morning, several hours before visiting the restaurant.\nBacked into a corner, de Meur admitted staging the incident to get Ratatouille fired.\nA repeat health inspection once again confirmed the cleanliness of the kitchen."],
[&"", &"Экспертиза санитарного бюро · Le Goutet"]: [&"Health Bureau analysis · Le Goutet"],
[&"", &"Вы поддержали проверку вместо назначения виновного по одному письму. Жалоба не объявлена ложной, читатели ценят осторожность, санитарное бюро одобряет доверие к процедуре."]: [&"You backed an inspection instead of assigning blame on the strength of one letter. You did not declare the complaint false; readers value caution, and the Health Bureau approves of your trust in the process."],
[&"", &"Шерсть в супе: ещё не повод отправлять санитарную проверку коту под хвост!"]: [&"Fur in the soup? No reason to toss the health inspection in the kitty litter!"],
[&"", &"Вопрос оставляет виновника открытым. Читатели доверяют осторожному разбирательству; заголовок не оценивает санитарную службу до экспертизы."]: [&"The question leaves responsibility open. Readers trust a careful inquiry; the headline passes no judgment on the health service before the analysis."],
[&"", &"Откуда взялась шерсть в супе господина де Мура?"]: [&"Where did the fur in Mr de Meur’s soup come from?"],
[&"", &"Рассказ посетителя о шерсти выдан за установленный факт. Читатели меньше доверяют редакции, власти считают поспешную подачу недостаточно ответственной."]: [&"The diner’s account of finding fur was presented as established fact. Readers trust the newsroom less, and the authorities consider the hasty reporting irresponsible."],
[&"", &"Посетитель ресторана «Le Goutet» нашел шерсть в своем супе!"]: [&"Le Goutet diner finds fur in his soup!"],
[&"", &"(Из письма господина де Мура, постоянного посетителя «Le Goutet».)\n\nВчера ужинал в этом хвалёном ресторане «Le Goutet» и нашёл в супе целый клочок серой шерсти. Официант вместо извинений принялся разглядывать мой рукав, словно я сам лысею. Ночью меня так скрутило, что до утра глаз не сомкнул. Теперь я прекрасно понимаю, чья шерсть плавала в тарелке и благодаря кому я отравился. Требую уволить эту крысу, пока вслед за мной к врачу не отправилась половина города!"]: [&"(From a letter by Mr de Meur, a regular at Le Goutet.)\n\nYesterday I dined at that much-praised restaurant Le Goutet and found an entire clump of gray fur in my soup. Instead of apologizing, the waiter started inspecting my sleeve, as if I were the one going bald. My stomach cramped so badly that night that I did not sleep a wink until morning. Now I know perfectly well whose fur was floating in my bowl and who gave me food poisoning. I demand that rat be fired before half the city ends up at the doctor’s after me!"],
[&"", &"Жалоба господина де Мура · Le Goutet"]: [&"Complaint from Mr de Meur · Le Goutet"],
[&"", &"Поддержка санитарного бюро основана на подтверждённом результате проверки. Читатели доверяют фактам, ведомство одобряет освещение своей работы без предубеждения против повара."]: [&"Your support for the Health Bureau rests on verified inspection findings. Readers trust the facts, and the bureau approves of coverage of its work without prejudice against the chef."],
[&"", &"Санитарная проверка не выявила нарушений на кухне «Le Goutet»"]: [&"Health inspection finds no violations in Le Goutet’s kitchen"],
[&"", &"Заголовок поддерживает повара, не противореча чистой проверке. Читатели ценят справедливость, санитарному бюро приятно косвенное подтверждение его заключения."]: [&"The headline supports the chef without contradicting the clean inspection. Readers value fairness, and the Health Bureau welcomes this indirect endorsement of its findings."],
[&"", &"Готовить может каждый, даже маленькая крыса"]: [&"Anyone can cook, even a little rat"],
[&"", &"Вопрос намекает на опасность из-за предубеждения, хотя проверка нарушений не нашла. Читатели сомневаются в честности подачи, власти отмечают её необъективность."]: [&"The question uses prejudice to imply danger, although the inspection found no violations. Readers question the fairness of your reporting, and the authorities note its bias."],
[&"", &"Стоит ли ходить в ресторан, где шеф поваром работает крыса?"]: [&"Should you eat at a restaurant with a rat for a head chef?"],
[&"", &"В знаменитом ресторане «Le Goutet», удостоенном звезды Мишлен, шеф-поваром оказалась крыса по имени Рататуй. Наш корреспондент убедился в этом лично, заглянув на кухню заведения, где процессом готовки руководила крыса в поварском колпаке! Хотя недавняя санитарная проверка не выявила нарушений, но возмущённые посетители уже требуют увольнения повара. Следите за обновлениями выпуска и берегите свое здоровье!"]: [&"At the famous Michelin-starred restaurant Le Goutet, the head chef turned out to be a rat named Ratatouille. Our correspondent saw it firsthand after peeking into the kitchen, where a rat in a chef’s hat was directing the cooking! Although a recent health inspection found no violations, outraged diners are already demanding the chef’s dismissal. Stay tuned for updates, and look after your health!"],
[&"", &"Репортаж · Повар ресторана Le Goutet"]: [&"Report · The chef at Le Goutet"],
[&"", &"Письмо не устанавливает умысла водителя. Читатели ценят отказ от домысла, власти одобряют поддержку сдержанного подхода к обвинениям; несуществующее расследование вы не объявляете."]: [&"The letter establishes no intent on the driver’s part. Readers value your refusal to speculate, and the authorities approve of a restrained approach to accusations; you have not announced an investigation that does not exist."],
[&"", &"Не будем обвинять водителя такси в умысле без доказательств"]: [&"Let’s not accuse the taxi driver of intent without evidence"],
[&"", &"Любопытный вопрос не добавляет подробностей аварии. Читатели сохраняют интерес и доверие; заголовок не оценивает государство."]: [&"A curious question adds no new details to the accident. Readers remain interested and trusting; the headline passes no judgment on the state."],
[&"", &"Чем закончилась история слишком любопытной кошки?"]: [&"How did the tale of the overly curious cat end?"],
[&"", &"Вы предупреждаете об аварии из письма очевидца без выдуманного умысла. Читатели ценят осторожность; частный случай не касается работы властей."]: [&"You warned readers about the accident in an eyewitness letter without inventing intent. Readers value caution; this individual incident says nothing about the authorities’ work."],
[&"", &"Spotto! Остерегайтесь неуправляемых желтых такси! (Даже если у вас 9 жизней)."]: [&"Spotto! Beware of out-of-control yellow taxis! (Even if you have nine lives)."],
[&"", &"На днях видел одного из сотрудников «Кошачьей Канцелярии» у самой обочины. Сидел и очень внимательно слушал разговор двух знатных господ неподалёку.\nПравда, долго слушать ему не пришлось, так как через минуту в него врезалось неуправляемое жёлтое такси.\nТак что чем закончился разговор, он уже вряд ли расскажет"]: [&"The other day I saw a Cat Chancellery employee right by the curb. He was sitting there, listening very closely to a conversation between two distinguished gentlemen nearby.\nHe did not get to listen for long, though: a minute later, an out-of-control yellow taxi crashed into him.\nSo I doubt he will be telling anyone how that conversation ended"],
[&"", &"Письмо очевидца · Жёлтое такси"]: [&"Eyewitness letter · Yellow taxi"],
[&"", &"Опровержение превращено в признание. Читатели видят прямой обман, власти осуждают газету за ложное обвинение организации."]: [&"A denial became a confession. Readers see outright deception, and the authorities condemn the paper for falsely accusing an organization."],
[&"", &"Сенсация! Кошачья канцелярия опубликовала официальное признание в шпионаже!"]: [&"Sensation! Cat Chancellery publishes official confession to espionage!"],
[&"", &"Вы точно передали содержание ответа как позицию самой организации. Читатели доверяют аккуратной подаче; опровержение само по себе не доказывает невиновности и не оценивает государство."]: [&"You accurately presented the response as the organization’s own position. Readers trust careful reporting; a denial alone does not prove innocence or pass judgment on the state."],
[&"", &"Кошачья канцелярия отрицает слежку и тайный сбор сведений"]: [&"Cat Chancellery denies surveillance and covert information gathering"],
[&"", &"Вы честно передали опровержение и призыв проверять слухи. Читатели получили другую сторону; принадлежность Канцелярии к государству источник не устанавливает."]: [&"You faithfully reported the denial and the call to check rumors. Readers heard the other side; the source establishes no state affiliation for the Chancellery."],
[&"", &"Кошачья канцелярия просит горожан не верить каждой сплетне"]: [&"Cat Chancellery urges citizens not to believe every rumor"],
[&"", &"В последнее время наша организация «Кошачья Канцелярия» все чаще сталкивается с обвинениями в шпионаже за горожанами.\nОднако наши сотрудники никогда не занимались слежкой за чиновниками, тайным сбором сведений или распространением чужих секретов.\nПрисутствие кошек на закрытых мероприятиях или рядом с известными людьми само по себе ничего не доказывает.\nНастоятельно просим читателей газеты и всех граждан не принимать каждую услышанную сплетню за достоверный факт"]: [&"Recently, our organization, the Cat Chancellery, has increasingly faced accusations of spying on citizens.\nHowever, our employees have never engaged in surveillance of officials, covert information gathering or the disclosure of other people’s secrets.\nThe presence of cats at private events or near well-known figures proves nothing in itself.\nWe strongly urge this newspaper’s readers and all citizens not to treat every piece of gossip they hear as a verified fact"],
[&"", &"Официальный ответ · Кошачья канцелярия"]: [&"Official response · Cat Chancellery"],
[&"", &"Вы поддержали осторожное отношение к обвинениям, не называя Канцелярию государственным органом. Читатели ценят сдержанность, кошачья власть одобряет отказ распространять недоказанное обвинение."]: [&"You urged caution over the allegations without calling the Chancellery a state agency. Readers value restraint, and the feline authorities approve of your refusal to spread an unproven accusation."],
[&"", &"Кошек нельзя объявлять шпионами по одному анонимному письму"]: [&"One anonymous letter is no reason to brand cats as spies"],
[&"", &"Вы отделили подозрение автора от доказанного факта. Читатели доверяют осторожности; частное письмо не устанавливает связи Канцелярии с государством."]: [&"You distinguished the writer’s suspicion from an established fact. Readers trust your caution; a private letter establishes no link between the Chancellery and the state."],
[&"", &"Анонимный автор подозревает Кошачью канцелярию в слежке, доказательств в письме нет"]: [&"Anonymous writer suspects Cat Chancellery of surveillance; letter offers no evidence"],
[&"", &"Слухи анонимного письма стали утверждением о шпионаже. Читатели теряют доверие, а власти считают такую газету ненадёжной."]: [&"Rumors from an anonymous letter became an assertion of espionage. Readers lose trust, and the authorities consider the paper unreliable."],
[&"", &"Подозрительная кошечка, замеченная за шпионажем мирных граждан."]: [&"Suspicious kitty caught spying on innocent citizens."],
[&"", &"(Примечание отправителя, которого явно задели кошки: Кошки, кошки… Они повсюду! Вы уверены, что ваш следующий разговор не услышат чужие уши?)\n«За безобидным названием \"Кошачья канцелярия\" скрывается организация, чья деятельность уже давно вызывает у меня одно беспокойство.\nПо словам очевидцев, её сотрудники следят за чиновниками, подслушивают разговоры и проникают на закрытые мероприятия под видом персонала.\nХодят слухи, что некоторые кошки устраиваются помощниками влиятельных особ и вскоре их секреты оказываются в газетах.\nГорожанам следует быть осторожнее. Помните, что даже мирно дремлющая рядом кошка может услышать больше, чем кажется»."]: [&"(A note from the sender, who clearly has a bone to pick with cats: Cats, cats… They are everywhere! Are you sure your next conversation will not reach the wrong ears?)\n“Behind the harmless name \"Cat Chancellery\" lies an organization whose activities have worried me for a long time.\nAccording to eyewitnesses, its employees watch officials, eavesdrop on conversations and infiltrate private events posing as staff.\nRumor has it that some cats take jobs as assistants to influential figures, and before long their secrets end up in the papers.\nCitizens should be careful. Remember, even a cat dozing peacefully beside you may hear more than you think.”"],
[&"", &"Анонимное письмо · Кошачья канцелярия"]: [&"Anonymous letter · Cat Chancellery"],
[&"", &"Как вы считаете, стоит ли признаться ему лично?"]: [&"Do you think I should tell him in person?"],
[&"", &"Не знаю, читает ли он газету"]: [&"I do not know if he reads the paper"],
[&"", &"автор пожелала остаться анонимной"]: [&"the writer has asked to remain anonymous"],
[&"", &"чистоту кухни"]: [&"the cleanliness of the kitchen"],
[&"", &"желая добиться увольнения Рататуя"]: [&"to get Ratatouille fired"],
[&"", &"ещё утром, за несколько часов"]: [&"earlier that morning, several hours"],
[&"", &"Ночью меня так скрутило, что до утра глаз не сомкнул."]: [&"My stomach cramped so badly that night that I did not sleep a wink until morning."],
[&"", &"нашёл в супе целый клочок серой шерсти"]: [&"found an entire clump of gray fur in my soup"],
[&"", &"Из письма господина де Мура"]: [&"From a letter by Mr de Meur"],
[&"", &"Причины аварии мне неизвестны."]: [&"I do not know what caused the accident."],
[&"", &"Я видел столкновение, а не доказательство шпионажа."]: [&"I saw a collision, not evidence of espionage."],
[&"", &"О чём они говорили, мне не слышно было."]: [&"I could not hear what they were talking about."],
[&"", &"в него врезалось неуправляемое жёлтое такси"]: [&"an out-of-control yellow taxi crashed into him"],
[&"", &"само по себе ничего не доказывает"]: [&"proves nothing in itself"],
[&"", &"никогда не занимались слежкой за чиновниками, тайным сбором сведений или распространением чужих секретов"]: [&"never engaged in surveillance of officials, covert information gathering or the disclosure of other people’s secrets"],
[&"", &"Обещания квартиры там нет."]: [&"There is no promise of a flat in it."],
[&"", &"месяц без платы, коммунальные расходы за городом"]: [&"one month rent-free, utilities covered by the city"],
[&"", &"Новых жильцов у меня семь."]: [&"I have seven new residents."],
[&"", &"Кто принял работу, ещё выясняют."]: [&"They are still establishing who signed off the work."],
[&"", &"Мост после обращения закрыли; никто не провалился."]: [&"The bridge was closed after the report; nobody fell through."],
[&"", &"акт с работой не совпадает, оплату остановил до проверки"]: [&"the certificate does not match the work; he has suspended payment pending an inspection"],
[&"", &"Сегодня передали поправку и мои извинения."]: [&"Today they broadcast a correction and my apologies."],
[&"", &"Граммо, редактор, нашёл бумажную заявку, признал ошибку."]: [&"Grammo, the editor, found the paper request and admitted the mistake."],
[&"", &"В заявке написал «Для знакомой, с благодарностью»."]: [&"On the request slip I wrote \"For a lady I know, with thanks\"."],
[&"", &"В конце месяца решат, оставлять ли."]: [&"At the end of the month they will decide whether to keep it."],
[&"", &"сверху за книгу не берут"]: [&"there is no extra charge for a book"],
[&"", &"месячный опыт с вечерней выдачей до восьми"]: [&"a month-long trial of evening collection until eight"],
[&"", &"завтра обещала начать такие выдавать"]: [&"promised to start handing them out tomorrow"],
[&"", &"Приняли меня на десять минут позже: врач задержался на вызове"]: [&"They saw me ten minutes late: the doctor was held up on a house call"],
[&"", &"На наших новых талонах один номер, ни фамилии врача, ни кабинета."]: [&"Our new tickets have only a number, no doctor\'s name or room."],
[&"", &"Мне участники платят по утверждённому тарифу"]: [&"Participants pay me at the approved rate"],
[&"", &"Зал город дал бесплатно по программе досуга."]: [&"The city provided the hall free through its leisure programme."],
[&"", &"первый вечерний урок для взрослых в нашем городском клубе"]: [&"the first evening class for adults at our city club"],
[&"", &"Взятку у меня не просили."]: [&"Nobody asked me for a bribe."],
[&"", &"во вторник будет повторный обход"]: [&"there will be another inspection on Tuesday"],
[&"", &"Выступают обе вывески на пятнадцать сантиметров."]: [&"Both signs stick out fifteen centimetres."],
[&"", &"Исправлю на следующей неделе, бесплатно."]: [&"I will fix it next week, free of charge."],
[&"", &"Рама деревянная, покрыта золотистой краской"]: [&"The frame is wooden, covered in gold-coloured paint"],
[&"", &"Совет оплатил ровно договорную сумму за портрет и раму"]: [&"The council paid exactly the contracted sum for the portrait and frame"],
[&"", &"Оценку исправила. Клёп упражнение сделал, теперь заслуженно."]: [&"I corrected the mark. Klep did the exercise, so now it is deserved."],
[&"", &"Девять вещей за неделю уже вернули"]: [&"Nine items have already been returned this week"],
[&"", &"Очки нашёл дежурный в депо."]: [&"The depot attendant found the glasses."],
[&"", &"Сегодня мастер уже пришёл"]: [&"The repairman has already arrived today"],
[&"", &"Объявление о ремонте до вторника"]: [&"repair notice, promising service by Tuesday"],
[&"", &"аппарат сломан с субботы"]: [&"the phone has been broken since Saturday"],
[&"", &"Скрипп из казначейства ответил, что ошиблись номером счёта, перечислят в следующую среду."]: [&"Skripp at the treasury replied that they got the account number wrong and would transfer the money next Wednesday."],
[&"", &"в банке проверили: перевода нет"]: [&"we checked with the bank: no transfer has arrived"],
[&"", &"За февраль и март не заплатили всем пятерым."]: [&"None of the five of us has been paid for February or March."],
[&"", &"Белый у нас есть до вечера. Ржаной печём два раза, на всех не хватает"]: [&"We have white bread until evening. We bake rye twice a day, and there isn\'t enough for everyone"],
[&"", &"Она проверила: скрытой наценки нет."]: [&"She checked: there is no hidden markup."],
[&"", &"две ржаные буханки лежали под прилавком"]: [&"two rye loaves were under the counter"],
[&"", &"Покупку оплатил город, установили ещё на прошлой неделе."]: [&"The city paid for the purchase; it was installed last week."],
[&"", &"Здоровые оба, мама тоже"]: [&"Both are healthy, and so is their mother"],
[&"", &"Генератор только для отделения"]: [&"The generator serves only the ward"],
[&"", &"Завтра после обеда заменю, у обоих подъездов ненадолго пропадёт приём"]: [&"I will replace it tomorrow afternoon; reception will briefly go out in both entrances"],
[&"", &"Новый кабель уже получил в жилищном бюро."]: [&"I have already collected a new cable from the housing bureau."],
[&"", &"кабеля: его перетёрло о водосток"]: [&"cable: it had rubbed through against the gutter"],
[&"", &"Пока один проход держат открытым, к пятнице обещают перенастроить остальные."]: [&"For now they are keeping one passage open and promise to reset the others by Friday."],
[&"", &"задержку створки рассчитывали по кошачьему образцу"]: [&"the gate delay was calculated using a feline model"],
[&"", &"До травмы не дошло: врач осмотрел, ушибов нет."]: [&"No injury resulted: a doctor examined me and found no bruising."],
[&"", &"Заведующая согласилась подержать до выходного."]: [&"The manager agreed to keep it until my day off."],
[&"", &"Мышь Пип нашёл коробочку у весов и отнёс в городское бюро находок."]: [&"Pip the mouse found the case by the scales and took it to the city\'s lost property office."],
[&"", &"Объявление можно снять!"]: [&"You can take the notice down!"],
[&"", &"Коммунальное бюро ещё выясняет, откуда она так быстро пришла"]: [&"The utilities bureau is still investigating where it came from so quickly"],
[&"", &"одиннадцать жителей, пострадавших нет"]: [&"eleven residents, no injuries"],
[&"", &"Приехали городские спасатели, две лодки."]: [&"City rescuers arrived with two boats."],
[&"", &"Бумагу в депо я видела"]: [&"I saw the notice at the depot"],
[&"", &"после десяти мало пассажиров. Дневные оставили."]: [&"few passengers after ten. They kept the daytime runs."],
[&"", &"с понедельника этого рейса не будет"]: [&"from Monday this run will be gone"],
[&"", &"(Примечание: автор пожелала остаться анонимной.)\n\nУвидела ваше спасибо кошачьей власти за счастливую любовь. Не знаю, смеяться или краснеть. За чувства отвечаю я; счастлива ли история, ещё не выяснили. Всё сильнее влюбляюсь в коллегу, мечтаю гулять вдвоём. На работе слова вылетают из головы; от его взгляда долго улыбаюсь. Смелее стала только на бумаге. Не знаю, читает ли он газету. Как вы считаете, стоит ли признаться ему лично?\n\nЧитательница: Будь смелее! Мэр вместо тебя на свидание не пойдёт. Газету покупаю ради твоего продолжения!\nДругой читатель: Мне бы такие стихи: сам пригласил бы её!"]: [&"(Note: the writer has asked to remain anonymous.)\n\nI saw your thanks to the feline authorities for a happy love story. I don\'t know whether to laugh or blush. I am responsible for my own feelings; whether this story is happy remains to be seen. I keep falling more deeply in love with a colleague and dream of walks together. At work every word flies out of my head; one look from him leaves me smiling for ages. I am braver only on paper. I do not know if he reads the paper. Do you think I should tell him in person?\n\nA female reader: Be brave! The mayor won\'t go on the date for you. I buy the paper for your next instalment!\nAnother reader: Poems like that for me? I\'d ask her out myself!"],
[&"", &"(Примечание: автор пожелала остаться анонимной.)\n\nВы спросили, узнает ли коллега себя в стихах. Я ещё не писала, что он коллега! Угадали, дальше прошу не угадывать. Всё сильнее влюбляюсь, мечтаю гулять вдвоём. Но на работе слова вылетают из головы, после его взгляда долго улыбаюсь. Смелее стала только на бумаге. Не знаю, читает ли он газету. Как вы считаете, стоит ли признаться ему лично?\n\nЧитательница: Будь смелее! Только редакцию впереди себя на свидание не пускай. Жду продолжения!\nДругой читатель: Мне бы такие стихи: сам пригласил бы её!\n(О признании и ответе коллеги сведений нет.)"]: [&"(Note: the writer has asked to remain anonymous.)\n\nYou asked whether my colleague would recognise himself in the poem. I hadn\'t said he was a colleague yet! You guessed right; please stop guessing now. I keep falling more deeply in love and dream of walks together. But at work every word flies out of my head, and one look from him leaves me smiling for ages. I am braver only on paper. I do not know if he reads the paper. Do you think I should tell him in person?\n\nA female reader: Be brave! Just don\'t let the editors go on your date before you do. Waiting for the next instalment!\nAnother reader: Poems like that for me? I\'d ask her out myself!\n(There is no report of a confession or the colleague\'s response.)"],
[&"", &"(Примечание: автор пожелала остаться анонимной.)\n\nСпасибо, что напечатали стихи, не угадывая адресата. После них я смелее только на бумаге. Всё сильнее влюбляюсь в коллегу, мечтаю гулять вдвоём. Но встречаемся на работе, и слова вылетают из головы. От его взгляда потом долго улыбаюсь. Не знаю, читает ли он газету. Как вы считаете, стоит ли признаться ему лично?\n\nЧитательница: Девочка, будь смелее! Покупаю газету ради продолжения!\nДругой читатель: Мне бы такие стихи посвятили: сам пригласил бы её!\n(Читатели советуют решиться; о признании сведений нет.)"]: [&"(Note: the writer has asked to remain anonymous.)\n\nThank you for printing the poem without guessing who it was for. Since then, I am braver only on paper. I keep falling more deeply in love with a colleague and dream of walks together. But we meet at work, and every word flies out of my head. One look from him leaves me smiling for ages. I do not know if he reads the paper. Do you think I should tell him in person?\n\nA female reader: Be brave, girl! I buy the paper for the next instalment!\nAnother reader: If someone dedicated poems like that to me, I\'d ask her out myself!\n(The readers urge her to take the plunge; there is no report of a confession.)"],
[&"", &"(Почему коты не любят крыс и мышей? Возможно, стоит спросить героя этой прессы.)\n\nВы предложили не отправлять проверку коту под хвост из-за жалобы. Теперь обвинения против Рататуя из «Le Goutet» сняты. Экспертиза установила: шерсть принадлежала де Муру. Журнал врача подтвердил обращение с отравлением ещё утром, за несколько часов до ресторана.\n\nДе Мур признался: подстроил историю, желая добиться увольнения Рататуя. Повторная проверка подтвердила чистоту кухни. Бюро уточняет: первой проверки было недостаточно, понадобились экспертиза, журнал и признание. Рататуй просит дать ему готовить: бумаги убедительные, но на ужин заказывают не их."]: [&"(Why do cats dislike rats and mice? Perhaps we should ask the subject of all this coverage.)\n\nYou suggested not chucking the inspection out with the cat litter over a complaint. The accusations against Ratatouille of \"Le Goutet\" have now been withdrawn. Analysis established that the fur belonged to de Meur. The doctor\'s log confirmed he sought treatment for poisoning earlier that morning, several hours before visiting the restaurant.\n\nDe Meur confessed: he staged the incident to get Ratatouille fired. A repeat inspection confirmed the cleanliness of the kitchen. The bureau clarifies that the first inspection was not enough: analysis, the log and a confession were needed. Ratatouille asks to be allowed to cook: the papers are convincing, but nobody orders them for dinner."],
[&"", &"(Почему коты не любят крыс и мышей? Возможно, стоит спросить героя этой прессы.)\n\nВы спросили, откуда шерсть в супе де Мура. Теперь есть проверенный ответ: экспертиза санитарного бюро установила, что она принадлежала ему самому. Журнал врача подтвердил обращение с отравлением ещё утром, за несколько часов до ресторана. Обвинения против Рататуя из «Le Goutet» сняты.\n\nДе Мур признался: подстроил историю, желая добиться увольнения Рататуя. Повторная проверка подтвердила чистоту кухни. Повар благодарит, что вопрос не стал приговором: «Теперь ответ можно напечатать без обратной стороны». Вопросы о предубеждениях уместны; происхождение этого клочка выяснено."]: [&"(Why do cats dislike rats and mice? Perhaps we should ask the subject of all this coverage.)\n\nYou asked where the fur in de Meur\'s soup came from. There is now a verified answer: analysis by the Health Bureau established that it belonged to him. The doctor\'s log confirmed he sought treatment for poisoning earlier that morning, several hours before visiting the restaurant. The accusations against Ratatouille of \"Le Goutet\" have been withdrawn.\n\nDe Meur confessed: he staged the incident to get Ratatouille fired. A repeat inspection confirmed the cleanliness of the kitchen. The chef thanks you for keeping a question from becoming a verdict: \"Now you can print the answer without having to take it back.\" Questions about prejudice are fair; the origin of this tuft has been established."],
[&"", &"(Почему коты не любят крыс и мышей? Возможно, стоит спросить героя этой прессы.)\n\nПосле вашего заголовка жалобу де Мура пересказывали как факт. Теперь обвинения против Рататуя из «Le Goutet» сняты. Экспертиза санитарного бюро установила: шерсть принадлежала самому де Муру. Журнал врача подтвердил обращение с отравлением ещё утром, за несколько часов до ресторана.\n\nДе Мур признался: подстроил историю, желая добиться увольнения Рататуя. Повторная проверка подтвердила чистоту кухни. Повар просит столь же заметно напечатать результат: «Чтобы рядом с моим именем опять можно было спокойно заказать суп». Жалоба была письмом посетителя; оговорка оказалась существенной."]: [&"(Why do cats dislike rats and mice? Perhaps we should ask the subject of all this coverage.)\n\nAfter your headline, people repeated de Meur\'s complaint as fact. The accusations against Ratatouille of \"Le Goutet\" have now been withdrawn. Analysis by the Health Bureau established that the fur belonged to de Meur himself. The doctor\'s log confirmed he sought treatment for poisoning earlier that morning, several hours before visiting the restaurant.\n\nDe Meur confessed: he staged the incident to get Ratatouille fired. A repeat inspection confirmed the cleanliness of the kitchen. The chef asks that you give the findings just as much prominence: \"So people can order soup calmly when they see my name again.\" The complaint was a customer\'s letter; that qualification turned out to matter."],
[&"", &"(Из письма господина де Мура, посетителя «Le Goutet».)\n\nВы пишете, что санитарная проверка не выявила нарушений. Значит, проверяли плохо! Вчера ужинал там и нашёл в супе целый клочок серой шерсти. Официант разглядывал мой рукав, словно я сам лысею. Ночью меня так скрутило, что до утра глаз не сомкнул.\n\nЯ прекрасно понимаю, чья шерсть в тарелке и благодаря кому отравился. Пусть бюро хоть десять печатей поставит: требую уволить эту крысу, пока к врачу не отправилась половина города! От бумажки суп чище не становится. Поддержите посетителя."]: [&"(From a letter by Mr de Meur, a customer of \"Le Goutet\".)\n\nYou write that the health inspection found no violations. Then they didn\'t look properly! I dined there yesterday and found an entire clump of gray fur in my soup. The waiter inspected my sleeve as though I were the one going bald. My stomach cramped so badly that night that I did not sleep a wink until morning.\n\nI know perfectly well whose fur was in the bowl and who poisoned me. The bureau can stamp it ten times over: I demand that rat be fired before half the city ends up at the doctor\'s! A piece of paper doesn\'t make soup cleaner. Stand by the customer."],
[&"", &"(Из письма господина де Мура, посетителя «Le Goutet».)\n\nПрочёл ваше «Готовить может каждый». Красиво, пока не ешь. Вчера ужинал там и нашёл в супе целый клочок серой шерсти. Официант разглядывал мой рукав, словно я сам лысею. Ночью меня так скрутило, что до утра глаз не сомкнул.\n\nЯ прекрасно понимаю, чья шерсть в тарелке и благодаря кому отравился. Хватит хвалить талант крысы: требую уволить повара, пока к врачу не отправилась половина города! Считаете мой тон предубеждением? Это голос посетителя. Найдите ему место."]: [&"(From a letter by Mr de Meur, a customer of \"Le Goutet\".)\n\nI read your \"Anyone Can Cook\". Lovely, until you eat. I dined there yesterday and found an entire clump of gray fur in my soup. The waiter inspected my sleeve as though I were the one going bald. My stomach cramped so badly that night that I did not sleep a wink until morning.\n\nI know perfectly well whose fur was in the bowl and who poisoned me. Stop praising the rat\'s talent: I demand the chef be fired before half the city ends up at the doctor\'s! You think my tone is prejudiced? This is a customer\'s voice. Find room for it."],
[&"", &"(Из письма господина де Мура, посетителя «Le Goutet».)\n\nВы спросили, стоит ли ходить в ресторан, где готовит крыса. Вчера ужинал там и нашёл в супе целый клочок серой шерсти. Официант разглядывал мой рукав, словно я сам лысею. Ночью меня так скрутило, что до утра глаз не сомкнул.\n\nЯ прекрасно понимаю, чья шерсть в тарелке и благодаря кому отравился. Санитарная проверка меня не успокоила. Требую уволить эту крысу, пока к врачу не отправилась половина города! После прошлого заголовка не смягчайтесь: я принёс жалобу, не повод похвалить ресторан."]: [&"(From a letter by Mr de Meur, a customer of \"Le Goutet\".)\n\nYou asked whether it is worth visiting a restaurant where a rat does the cooking. I dined there yesterday and found an entire clump of gray fur in my soup. The waiter inspected my sleeve as though I were the one going bald. My stomach cramped so badly that night that I did not sleep a wink until morning.\n\nI know perfectly well whose fur was in the bowl and who poisoned me. The health inspection did not reassure me. I demand that rat be fired before half the city ends up at the doctor\'s! Don\'t soften up after your last headline: I brought a complaint, not a reason to praise the restaurant."],
[&"", &"Вы написали, будто Кошачья Канцелярия призналась в шпионаже. Но в письме отрицание! Боюсь, и мою записку перевернёте. На днях её сотрудник сидел у обочины и внимательно слушал двух знатных господ. Только это знаю про разговор.\n\nЧерез минуту в него врезалось неуправляемое жёлтое такси. Чем закончился разговор, он уже вряд ли расскажет. Причины аварии мне неизвестны. Ни признания водителя, ни признания кошки у меня нет, не добывайте их из запятых. Предупреждайте о такси; под шпионским скандалом я не подпишусь."]: [&"You wrote as though the Cat Chancellery had confessed to espionage. But the letter was a denial! I fear you will turn my note upside down too. The other day one of its employees was sitting by the kerb, listening closely to two distinguished gentlemen. That is all I know about the conversation.\n\nA minute later, an out-of-control yellow taxi crashed into him. He is unlikely to tell us how the conversation ended now. I do not know what caused the accident. I have no confession from either the driver or the cat; please don\'t extract one from the commas. Warn people about taxis; I will not put my name to a spy scandal."],
[&"", &"Хорошо, что вы написали: Кошачья Канцелярия «отрицает» слежку. Подтвердить её ответ или старое письмо не могу. На днях её сотрудник сидел у обочины, внимательно слушая двух знатных господ. Может, отдыхал с открытыми ушами.\n\nЧерез минуту в него врезалось неуправляемое жёлтое такси. Чем закончился разговор, он уже вряд ли расскажет. Я видел столкновение, а не доказательство шпионажа. Причины аварии мне неизвестны. Пусть письмо останется рассказом очевидца: и без тайных агентов история неприятная."]: [&"Good of you to write that the Cat Chancellery \"denies\" surveillance. I can confirm neither its reply nor the earlier letter. The other day one of its employees was sitting by the kerb, listening closely to two distinguished gentlemen. Perhaps he was resting with his ears open.\n\nA minute later, an out-of-control yellow taxi crashed into him. He is unlikely to tell us how the conversation ended now. I saw a collision, not evidence of espionage. I do not know what caused the accident. Let this letter remain an eyewitness account: the story is unpleasant enough without secret agents."],
[&"", &"Прочёл призыв Кошачьей Канцелярии не верить каждой сплетне. Согласен: трижды подумал, прежде чем писать. На днях её сотрудник сидел у обочины и внимательно слушал двух знатных господ. О чём они говорили, мне не слышно было.\n\nЧерез минуту в него врезалось неуправляемое жёлтое такси. Чем закончился разговор, он уже вряд ли расскажет. Причины аварии мне неизвестны. Намерений водителя по цвету машины не угадаю. Девять жизней: плохой повод не смотреть по сторонам."]: [&"I read the Cat Chancellery\'s appeal not to believe every rumour. Agreed: I thought three times before writing. The other day one of its employees was sitting by the kerb, listening closely to two distinguished gentlemen. I could not hear what they were talking about.\n\nA minute later, an out-of-control yellow taxi crashed into him. He is unlikely to tell us how the conversation ended now. I do not know what caused the accident. I cannot guess a driver\'s intentions from the colour of the car. Nine lives are a poor excuse for not looking both ways."],
[&"", &"Спасибо за призыв не объявлять кошек шпионами по одному анонимному письму. Но не считайте это просьбой заступаться за Кошачью Канцелярию во всём.\n\nНаши сотрудники никогда не занимались слежкой за чиновниками, тайным сбором сведений или распространением чужих секретов. Присутствие кошек на закрытых мероприятиях или рядом с известными людьми само по себе ничего не доказывает. Просим не принимать сплетни за факт и не превращать наш ответ в грамоту о безупречности. Мы прислали опровержение, не портрет для стены редакции."]: [&"Thank you for urging readers not to declare cats spies on the strength of one anonymous letter. But please do not take that as a request to defend the Cat Chancellery in everything.\n\nOur staff have never engaged in surveillance of officials, covert information gathering or the disclosure of other people’s secrets. The presence of cats at private events or near famous people proves nothing in itself. Please do not take gossip for fact or turn our reply into a certificate of spotless conduct. We sent a denial, not a portrait for the newsroom wall."],
[&"", &"Спасибо, что назвали подозрение подозрением, а анонимное письмо не превратили в доказательство. Кошачья Канцелярия отвечает на слух о шпионаже.\n\nНаши сотрудники никогда не занимались слежкой за чиновниками, тайным сбором сведений или распространением чужих секретов. Присутствие кошек на закрытых мероприятиях или рядом с известными людьми само по себе ничего не доказывает. Наше опровержение является ответом, а не независимой экспертизой. Есть конкретные сведения? Пришлите. Желательно без рассуждений о чужих ушах: собственные у нас весь день на работе."]: [&"Thank you for calling a suspicion a suspicion, and for not turning an anonymous letter into evidence. The Cat Chancellery is responding to the rumour of espionage.\n\nOur staff have never engaged in surveillance of officials, covert information gathering or the disclosure of other people’s secrets. The presence of cats at private events or near famous people proves nothing in itself. Our denial is a response, not an independent investigation. Have specific information? Send it. Preferably without speculation about other people\'s ears: our own are at work all day."],
[&"", &"После вашего заголовка о кошечке, замеченной за шпионажем, Кошачью Канцелярию спрашивают уже не о слежке, а о количестве проданных секретов. Удобно: сначала объявить виноватыми, потом попросить объясниться.\n\nНаши сотрудники никогда не занимались слежкой за чиновниками, тайным сбором сведений или распространением чужих секретов. Присутствие кошек на закрытых мероприятиях или рядом с известными людьми само по себе ничего не доказывает. Просим не принимать сплетни за факт. Редакцию тоже. Усы от газетных обвинений длиннее не становятся, проверили на секретаре."]: [&"After your headline about a cat caught spying, the Cat Chancellery is being asked not about surveillance, but how many secrets it has sold. Convenient: declare us guilty first, then ask us to explain.\n\nOur staff have never engaged in surveillance of officials, covert information gathering or the disclosure of other people’s secrets. The presence of cats at private events or near famous people proves nothing in itself. Please do not take gossip for fact. That goes for the editors too. Newspaper accusations don\'t make whiskers grow longer; we tested it on the secretary."],
[&"", &"Похвала ограничена предоставленной помощью. Читатели и мэрия ценят точность без выдуманного обещания постоянных квартир."]: [&"The praise is limited to the help provided. Readers and city hall value accuracy without an invented promise of permanent flats."],
[&"", &"Мэрия дала погорельцам комнаты на месяц и взяла коммунальные расходы на себя"]: [&"City hall gives fire victims rooms for a month and covers utility costs"],
[&"", &"Отсутствие решения на будущее превращено в завтрашнее выселение вопреки действующей помощи. Ложная тревога портит обе шкалы."]: [&"The lack of a future decision has been turned into eviction tomorrow, despite the current help. The false alarm damages both meters."],
[&"", &"Погорельцев гонят на улицу уже завтра: семь жильцов городу не нужны!"]: [&"Fire victims thrown into street tomorrow: city has no room for seven residents!"],
[&"", &"Постановление подтверждает число жильцов, срок и условия. Читатели доверяют фактам, мэрия одобряет сообщение о реальной помощи."]: [&"The resolution confirms the number of residents, the duration and the terms. Readers trust the facts; city hall approves of a report on real help."],
[&"", &"Семь погорельцев поселили в городском общежитии без платы на месяц"]: [&"Seven fire victims housed in city hostel free for a month"],
[&"", &"Новых жильцов у меня семь. Мышиная семья, барсук, лиса с сыном. После пожара в их частном доме за день освободили две комнаты городского общежития. Барсук спросил, куда платить, мышата: можно ли ключи. Лиса просто села.\n\nМышиная кастрюля барсуку мала, барсучья на плиту не влезла. Варили суп в моей. Теперь я дядя Ключ, а кастрюлю спрашивают чаще комнат.\n\nМэлла из мэрии привезла бельё по накладной, постановление: месяц без платы, коммунальные расходы за городом. Дальше «Решаем». Обещания квартиры там нет. Барсук читает каждое утро, вдруг дописали.\n\nМышка принесла вторую варежку с вышитым ключиком: помогите найти первую. Дядя Ключ у неё был раньше меня. Ревную, но поищу.\n\nПёс, смотритель на Кирпичной. Приходите поговорить с жильцами. Суп большой."]: [&"I have seven new residents. A mouse family, a badger, a fox and her son. After the fire in their privately owned house, two rooms in the city hostel were made available within a day. The badger asked where to pay; the young mice asked whether they could have keys. The fox just sat down.\n\nThe mice\'s saucepan was too small for the badger; the badger\'s wouldn\'t fit on the stove. We made soup in mine. Now I am Uncle Key, and the saucepan is requested more often than the rooms.\n\nMella from city hall brought bed linen with a delivery note and a resolution: one month rent-free, utilities covered by the city. After that: \"Under consideration\". There is no promise of a flat in it. The badger reads it every morning in case they have added one.\n\nA little mouse brought a second mitten with an embroidered key: please help find the first. She had an Uncle Key before she had me. I am jealous, but I\'ll look.\n\nA dog, caretaker on Brick Street. Come and talk to the residents. There is plenty of soup."],
[&"", &"Тетрадь дяди Ключа · Суп на семь жильцов"]: [&"Uncle Key\'s notebook · Soup for seven residents"],
[&"", &"Реакция бюро подтверждена. Похвала касается мер после обращения, не объявляя сам ремонт удачным или проверку законченной."]: [&"The bureau\'s response is confirmed. The praise concerns action after the report, without declaring the repair successful or the inspection complete."],
[&"", &"Дорожное бюро остановило оплату ремонта, опасный мост закрыт до проверки"]: [&"Roads bureau halts repair payment; unsafe bridge closed pending inspection"],
[&"", &"Замена трёх досок стала отсутствием всего остального настила, а расхождение: доказанным хищением и умыслом. Ложное обвинение резко портит обе шкалы."]: [&"Replacement of three planks became the absence of all the others, and a discrepancy became proven theft and intent. The false accusation sharply damages both meters."],
[&"", &"Мосту оставили три доски, бюджет украли целиком: чиновники ждут жертв!"]: [&"Three planks left on bridge, entire budget stolen: officials wait for victims!"],
[&"", &"Снимок, копия акта и подтверждение бюро доказывают ложную отчётность. Читатели ценят разоблачение, ведомство недовольно оглаской провала контроля."]: [&"The photograph, certificate copy and bureau confirmation prove false reporting. Readers value the exposé; the department dislikes its failed oversight being publicised."],
[&"", &"По акту сменили весь настил, на деле: три доски: плотник обнаружил расхождение"]: [&"Full decking replaced on paper, three planks in reality: carpenter finds discrepancy"],
[&"", &"На мосту у мельницы три новые доски. У четвёртой отвёртка вошла до ручки. Тридцать лет плотник, а дерево, которое можно намазывать, не люблю.\n\nСторож показал акт городского подрядчика: «Настил заменён полностью». Взял копию, сфотографировал: три светлые полоски. Играли в «найди ещё одну». Не нашли.\n\nСкрепп из дорожного бюро подтвердил: акт с работой не совпадает, оплату остановил до проверки. Мост после обращения закрыли; никто не провалился. Обход двадцать минут. Старушка назвала занудой и дала яблоко: за то, что вовремя.\n\nКто принял работу, ещё выясняют. Отвёртку вытащил, над мостом теперь красная тряпка. Хотелось бы следующей обновкой доску.\n\nБобр Тарбо. Адрес на конверте: от снимка не прячусь."]: [&"Three new planks on the bridge by the mill. Into the fourth, my screwdriver sank to the handle. Thirty years a carpenter, and I don\'t like wood you can spread.\n\nThe caretaker showed me the city contractor\'s certificate: \"Decking replaced in full\". Took a copy, took a photo: three pale stripes. We played \"find another\". Didn\'t find one.\n\nSkrepp at the roads bureau confirmed: the certificate does not match the work; he has suspended payment pending an inspection. The bridge was closed after the report; nobody fell through. A twenty-minute detour. An old lady called me a fusspot and gave me an apple: for being one in time.\n\nThey are still establishing who signed off the work. I pulled out the screwdriver; a red rag now hangs over the bridge. I would prefer the next new addition to be a plank.\n\nTarbo the beaver. Address on the envelope: I am not hiding from the photograph."],
[&"", &"Отвёртка прилагается мысленно · Плотник считает до четырёх"]: [&"Screwdriver enclosed in spirit · A carpenter counts to four"],
[&"", &"Граммо действительно проверил первоисточник и передал поправку. Заслуженная поддержка муниципальной редакции повышает обе шкалы."]: [&"Grammo really did check the original source and broadcast a correction. Well-earned support for the municipal newsroom raises both meters."],
[&"", &"Редактор городского радио поднял заявку и исправил ошибку в эфире"]: [&"City radio editor checks original request and corrects mistake on air"],
[&"", &"Комическая сцена есть в письме. Читатели понимают ошибку эфира, свадьба и взаимная любовь не объявлены фактами."]: [&"The comic scene is in the letter. Readers understand the broadcast mistake; neither the wedding nor mutual love is presented as fact."],
[&"", &"Он заказал песню, сосед принёс табуретку на свадьбу. Жених пока не в курсе!"]: [&"He requested a song; the neighbour brought a wedding stool. The groom hasn\'t heard!"],
[&"", &"Бумажная заявка и кассетная запись подтверждают ошибку и поправку. Точная публикация повышает доверие и немного поддерживает городское радио."]: [&"The paper request and cassette recording confirm the error and correction. Accurate reporting increases trust and gives a little support to the city radio station."],
[&"", &"«Хвост FM» исправило посвящение: знакомую енота ошибочно назвали невестой"]: [&"\"Tail FM\" corrects dedication: raccoon\'s acquaintance mistakenly called his bride-to-be"],
[&"", &"После «Хвост FM» все знают, что я женюсь. Я удивлён.\n\nЗаказал песню лисе: носила приёмник с заевшим выключателем. Мог починить сразу, да отвлекался на разговор. Лишних денег не брал, приёмник исправен. Мне бы выключатель наладить.\n\nВ заявке написал «Для знакомой, с благодарностью». Ведущая сказала «С любовью для невесты». Сосед принёс табуретку: занимать место на свадьбу.\n\nГраммо, редактор, нашёл бумажную заявку, признал ошибку. Сегодня передали поправку и мои извинения. Кассета в конверте. Лиса улыбнулась. О её чувствах больше не знаю: ремонтирую радиотехнику.\n\nДома Клёп спросил, придёт ли она на чай. Только ребёнок умеет спрашивать нормально.\n\nЕнот из мастерской. Имя придержите: сосед табуретку не унёс."]: [&"Thanks to \"Tail FM\", everyone knows I am getting married. News to me.\n\nI requested a song for a fox: she brought in a radio with a stuck switch. Could have fixed it at once, but kept getting distracted by the conversation. Charged no extra; the radio works. If only I could fix my own switch.\n\nOn the request slip I wrote \"For a lady I know, with thanks\". The presenter said \"With love for my bride-to-be\". My neighbour brought a stool to reserve his place at the wedding.\n\nGrammo, the editor, found the paper request and admitted the mistake. Today they broadcast a correction and my apologies. Cassette in the envelope. The fox smiled. That is all I know about her feelings: I repair radios.\n\nAt home, Klep asked whether she was coming for tea. Only a child knows how to ask a sensible question.\n\nThe raccoon from the workshop. Hold the name: the neighbour hasn\'t taken his stool away."],
[&"", &"Письмо под музыку · Жених поневоле на «Хвост FM»"]: [&"A letter with music · An unwilling bridegroom on \"Tail FM\""],
[&"", &"Вечерняя выдача уже действует без доплаты. Похвала конкретной помощи заслуженна и повышает обе шкалы."]: [&"Evening collection is already running at no extra charge. Praise for this specific help is deserved and raises both meters."],
[&"", &"Библиотека дала работающим родителям возможность забирать сказки после смены"]: [&"Library lets working parents collect fairy tales after their shift"],
[&"", &"Сравнение принадлежит дочери, приключение с обложкой есть в письме. Тёплая история заинтересует читателей без оценки государства."]: [&"The comparison belongs to the daughter, and the book\'s adventure is in the letter. The warm story will interest readers without judging the government."],
[&"", &"Папа стал книжной полкой: ёж доставил дочери сказку на собственном боку"]: [&"Dad becomes a bookshelf: hedgehog delivers daughter\'s fairy tale on his own flank"],
[&"", &"Соглашение и учтённые выдачи подтверждают опыт. Его временный характер сохранён, доверие и небольшое одобрение библиотеки растут."]: [&"The agreement and recorded collections confirm the trial. Its temporary nature is preserved, increasing trust and giving the library a little approval."],
[&"", &"Семь книг за неделю: библиотека пробует вечернюю выдачу через газетный киоск"]: [&"Seven books in a week: library trials evening collection through newspaper kiosk"],
[&"", &"Дочь велела родителю принести сказку. Я один, сторожу склад до семи, библиотека закрывается раньше. Послал записку: «Папа обещал до пятницы». Бобр Плотт позвонил, назвал киоск. Начальник решил, заказываю обед: после семи у него только книга жалоб.\n\nВ пятницу забрал в газетном киоске у библиотеки на Плотинной. Пакет лопнул, поднял книгу колючками, донёс боком. Дочь: «У нас новая книжная полка». Книга целая, полка тоже.\n\nМадам Фолио объяснила: месячный опыт с вечерней выдачей до восьми. Киоск частный, соглашение с городской библиотекой есть, сверху за книгу не берут. Семь заказов за неделю забрали. В конце месяца решат, оставлять ли.\n\nЧитали вдвоём. На «отправился в дальний путь» дочь засмеялась. Зря рассказал про пакет.\n\nЁж Брист."]: [&"My daughter instructed her parent to bring a fairy tale. I am on my own, guarding a warehouse until seven; the library closes earlier. Sent a note: \"Dad promised by Friday.\" Plott the beaver called and named a kiosk. My boss thought I was ordering lunch: after seven, the only book he offers is the complaints book.\n\nCollected it on Friday at the newspaper kiosk beside the library on Dam Street. The bag split; I picked up the book on my spines and carried it home sideways. My daughter said, \"We have a new bookshelf.\" The book is intact. So is the shelf.\n\nMadame Folio explained: a month-long trial of evening collection until eight. The kiosk is private, with an agreement with the city library; there is no extra charge for a book. Seven orders collected this week. At the end of the month they will decide whether to keep it.\n\nWe read together. At \"set out on a long journey\", my daughter laughed. Shouldn\'t have told her about the bag.\n\nBrist the hedgehog."],
[&"", &"Родительское собрание на колючках · Письмо Бриста"]: [&"A parents\' meeting on spines · Brist\'s letter"],
[&"", &"Подготовленный образец подтверждает реакцию на жалобу. Заслуженная похвала повышает обе шкалы, не обещая исчезновения очередей."]: [&"The prepared sample confirms a response to the complaint. Well-earned praise raises both meters without promising to abolish queues."],
[&"", &"Клиника услышала восьмого: новые талоны помогут найти своего врача"]: [&"Clinic listens to Number Eight: new tickets will help patients find their doctor"],
[&"", &"Номера у разных врачей превращены в доказательство покровительства. Письмо само опровергает обвинение, поэтому доверие и лояльность падают."]: [&"Numbers for different doctors have been turned into proof of favouritism. The letter itself disproves the accusation, so trust and loyalty fall."],
[&"", &"Восьмых держат за дверью, любимчиков лечат без очереди!"]: [&"Number Eights kept outside while favourites skip the queue!"],
[&"", &"Образец готов, начало выдачи названо обещанием. Точное сообщение сохраняет доверие и немного поддерживает клинику."]: [&"The sample is ready; the start of distribution is described as a promise. The accurate report preserves trust and offers a little support to the clinic."],
[&"", &"После путаницы с номерами клиника добавит на талон врача и кабинет"]: [&"After number mix-up, clinic to add doctor and room to tickets"],
[&"", &"Редакция, хотел назвать письмо «Заговор в клинике». Двенадцатый прошёл, четырнадцатый, а я, восьмой, сижу. Придумал три заголовка. Один жаль выбрасывать.\n\nМедсестра объяснила: двенадцатый к уху, четырнадцатый к носу, я к сердцу, за другой дверью. На наших новых талонах один номер, ни фамилии врача, ни кабинета. Расписание заслонил сам, пока возмущался.\n\nПриняли меня на десять минут позже: врач задержался на вызове, журнал показали. Помощь получил. Полтора часа сидел по своей инициативе: боюсь опоздать, однажды опоздал на свадьбу. Чужую, но неприятно.\n\nБеллис принесла образец с врачом и кабинетом, завтра обещала начать такие выдавать. Жена сказала: опять всё от нервов. Ни печати у неё, ни кабинета, а диагноз первый.\n\nПёс Мотт."]: [&"Editors, I wanted to call this letter \"Conspiracy at the Clinic\". Twelve went in, then Fourteen, while I, Eight, sat waiting. Thought up three headlines. One is a shame to waste.\n\nThe nurse explained: Twelve for ears, Fourteen for noses, me for my heart, behind another door. Our new tickets have only a number, no doctor\'s name or room. I had blocked the timetable myself while protesting.\n\nThey saw me ten minutes late: the doctor was held up on a house call; they showed me the log. I received treatment. The hour and a half of waiting was my own doing: I worry about being late, having once missed a wedding. Somebody else\'s, but still unpleasant.\n\nBellis brought a sample with the doctor and room on it and promised to start handing them out tomorrow. My wife said it was my nerves again. No stamp, no consulting room, yet hers is the first diagnosis.\n\nMott the dog."],
[&"", &"Почти разоблачение · Восьмой против четырнадцатого"]: [&"Almost an exposé · Number Eight versus Number Fourteen"],
[&"", &"Бесплатен именно зал, а не весь урок. Подтверждённая помощь городской программы повышает и доверие, и лояльность."]: [&"The hall is free, not the whole lesson. Verified help from the city programme increases both trust and loyalty."],
[&"", &"Город выделил взрослым бесплатный зал, чтобы вальсировать после смены"]: [&"City gives adults a free hall to waltz in after their shift"],
[&"", &"Шутка о посетителе передаёт реальный эпизод урока. Читателям интересно, действия государства в заголовке не оцениваются."]: [&"The joke about the visitor recounts a real incident at the class. Readers are interested; the headline makes no judgement on government action."],
[&"", &"Кот искал Плотинную, нашёл вальс: и обещал заблудиться ещё раз"]: [&"Cat looks for Dam Street, finds a waltz, promises to get lost again"],
[&"", &"Кружок действует, условия оплаты вывешены. Полезное объявление повышает доверие и немного поддерживает городское учреждение."]: [&"The group is running and the payment terms are posted. The useful notice increases trust and gives a little support to the city institution."],
[&"", &"Вечерний кружок для взрослых открыл набор на танцы в городском клубе"]: [&"Evening group opens enrolment for adult dance classes at city club"],
[&"", &"ПРАВАЯ ЛАПА: которой не наступили на соседа. ЛЕВАЯ: проверьте. ХВОСТ партнёра не держим, даже со страху.\n\nПамятку повесил на первый вечерний урок для взрослых в нашем городском клубе, под кривым латунным звонком. Звонить костяшкой: кнопка для красоты. Пришли две козы, барсук, три мыши, кот. Кот искал Плотинную, остался на вальс. На следующий четверг обещал опять заблудиться.\n\nШахматисты говорят, от моего «па па па» фигуры ходят сами. В тапочках кабан тоже не бесшумен.\n\nЗал город дал бесплатно по программе досуга. Мне участники платят по утверждённому тарифу, расчёт у памятки. Директор мадам Павана сдвинула начало для второй смены. Места есть, особенно для тех, кто боится. Мой первый партнёр до сих пор прячет лапы.\n\nМаэстро Топотто."]: [&"RIGHT PAW: the one that hasn\'t stepped on your neighbour. LEFT: check. Do not hold your partner\'s TAIL, even out of fear.\n\nI put the guide up for the first evening class for adults at our city club, under the crooked brass bell. Knock with a knuckle: the button is decorative. Two goats, a badger, three mice and a cat came. The cat was looking for Dam Street and stayed for a waltz. Promised to get lost again next Thursday.\n\nThe chess players say my \"one-two-three\" makes their pieces move by themselves. Even in slippers, a boar isn\'t silent.\n\nThe city provided the hall free through its leisure programme. Participants pay me at the approved rate; the breakdown is beside the guide. Madame Pavane, the director, moved the start time to suit the second shift. Places available, especially for the frightened. My first partner still hides his paws.\n\nMaestro Topotto."],
[&"", &"Памятка начинающим · Кабан считает до трёх"]: [&"Beginners\' guide · A boar counts to three"],
[&"", &"Жалобу приняли и назвали срок. Поддержка ответа ведомства не выдаёт проверку за состоявшуюся и не снимает вопрос о неравенстве."]: [&"The complaint was accepted and a date given. Supporting the department\'s response neither presents the inspection as completed nor dismisses the inequality."],
[&"", &"Управление торговли проверит жалобу Фундуччи: новый обход назначен на вторник"]: [&"Trade department to investigate Funducci\'s complaint: new inspection set for Tuesday"],
[&"", &"Мешок для инспектора существует только в пересказах публики. Вы объявили взятку фактом вопреки словам Фундуччи, теряя доверие и лояльность."]: [&"The sack for the inspector exists only in the crowd\'s retelling. You presented a bribe as fact despite Funducci\'s own words, losing trust and loyalty."],
[&"", &"Кошачья семейка обложила белок данью: инспектор требует орехи!"]: [&"Feline family extorts squirrels: inspector demands nuts!"],
[&"", &"Замеры и предписание показывают разное применение правила. Читатели ценят обоснованную жалобу, инспекции неприятна огласка."]: [&"The measurements and the order show unequal enforcement of the rule. Readers value the substantiated complaint; the inspectors dislike the publicity."],
[&"", &"Лишние пятнадцать сантиметров у обоих киосков, предписание: у одной Фундуччи"]: [&"Both stalls fifteen centimetres over; only Funducci gets an order"],
[&"", &"У Муретт «Свежая рыба», у меня «Орехи Фундуччи». Выступают обе вывески на пятнадцать сантиметров. Нарушает только моя. Может, рыба втягивает буквы перед инспектором.\n\nПредписание снять доску получила в четверг. Мерила обе с табурета, Муретт держала. Хорошая соседка, сдачу меняет. Фото замеров и предписание в конверте.\n\nИнспектор её двоюродный брат, в карточке записано. Почему её обошёл, не объяснили. Она уверяет, что не просила. Здороваемся теперь слишком вежливо, хуже ссоры.\n\nУправление торговли приняло жалобу: во вторник будет повторный обход. Доску пока оставили. Взятку у меня не просили. Публика придумала мешок орехов инспектору, а у меня один на весь день.\n\nХочу снова давать соседке мелочь, не думая о наших фамилиях. Белка Фундуччи."]: [&"Murette has \"Fresh Fish\"; I have \"Funducci\'s Nuts\". Both signs stick out fifteen centimetres. Only mine breaks the rules. Perhaps the fish pulls its letters in for the inspector.\n\nI received the order to take down my sign on Thursday. Measured both from a stool; Murette held it steady. A good neighbour, always changes money for me. Photos of the measurements and the order are in the envelope.\n\nThe inspector is her cousin; it is written on his card. Nobody explained why he passed her by. She insists she didn\'t ask him to. We greet each other far too politely now, worse than a quarrel.\n\nThe trade department accepted the complaint: there will be another inspection on Tuesday. The sign can stay for now. Nobody asked me for a bribe. People have invented a sack of nuts for the inspector, and I only have one to last all day.\n\nI want to give my neighbour change again without thinking about our surnames. Funducci the squirrel."],
[&"", &"Пятнадцать лишних сантиметров · Рулетка Фундуччи"]: [&"Fifteen extra centimetres · Funducci\'s tape measure"],
[&"", &"Копия договора подтверждает оплату. Конкретная похвала добросовестному расчёту даёт рост доверия и лояльности, не доказывая нужность портрета."]: [&"The contract copy confirms the payment. Specific praise for honest settlement increases trust and loyalty, without proving the portrait was needed."],
[&"", &"Совет оплатил работу художницы по договору, без дополнительной платы"]: [&"Council pays artist under contract, with no additional charge"],
[&"", &"Окрашенную раму объявили золотой, сравнение со школьным бюджетом взяли из слуха. Ложное обвинение портит репутацию и отношения с советом."]: [&"A painted frame was declared gold, and the comparison with a school\'s budget came from gossip. The false accusation damages reputation and relations with the council."],
[&"", &"Школе: ничего, мэру: золото! Годовой бюджет повесили в ратуше!"]: [&"Nothing for schools, gold for the mayor! A year\'s budget hung in town hall!"],
[&"", &"Материал рамы и договор позволяют опровергнуть конкретный слух. Читатели доверяют уточнению, совет немного одобряет его."]: [&"The frame material and contract disprove a specific rumour. Readers trust the clarification, and the council gives it a little approval."],
[&"", &"Золото на раме мэра оказалось краской, оплата портрета совпала с договором"]: [&"Mayor\'s gold frame turns out to be paint; portrait payment matches contract"],
[&"", &"Секретарь сказал, мэр Вельвет таким не бывает. Молодым? Нет, короткоусым.\n\nПисала по фото: на сеанс не пришёл трижды. Совещание, министр, потом, кажется, устал от первых двух. Усы на снимке прошлогодние. Предложила отрастить прежние, но совет признали художественным.\n\nИсправлю на следующей неделе, бесплатно. Совет оплатил ровно договорную сумму за портрет и раму, копию отдала корреспонденту. Рама деревянная, покрыта золотистой краской: той же, что корона мышиного принца в театре.\n\nВ коридоре уже говорят, что рама золотая, стоит годовой бюджет школы. Банку принесла: желающих поскоблить поубавилось.\n\nМэр посмотрел портрет, спросил, точно ли у него такой нос. Надеюсь, за год не вырос.\n\nЛиса Вивар, художница."]: [&"The secretary said Mayor Velvet doesn\'t look like that. Young? No, short-whiskered.\n\nI worked from a photograph: he missed three sittings. A meeting, a minister, then I think he was tired after the first two. The whiskers in the picture are last year\'s. I suggested growing the old ones back, but the advice was deemed artistic.\n\nI will fix it next week, free of charge. The council paid exactly the contracted sum for the portrait and frame; I gave a copy to the reporter. The frame is wooden, covered in gold-coloured paint: the same paint as the mouse prince\'s crown at the theatre.\n\nThe corridor gossip already says the frame is gold and costs a school\'s annual budget. I brought the tin: fewer people want to scrape it now.\n\nThe mayor looked at the portrait and asked whether his nose really looked like that. I hope it hasn\'t grown in a year.\n\nVivar the fox, artist."],
[&"", &"Разговор у мольберта · Мэр с прошлогодними усами"]: [&"A chat by the easel · Mayor with last year\'s whiskers"],
[&"", &"Решение директора подтверждено. Похвала полезному расписанию повышает доверие и лояльность без обещаний за весь город."]: [&"The director\'s decision is confirmed. Praise for the useful hours increases trust and loyalty without making promises for the entire city."],
[&"", &"За потерей можно зайти после работы: городское депо назначило вечернего дежурного"]: [&"Collect lost property after work: city depot appoints an evening attendant"],
[&"", &"Шутливое преувеличение таланта не меняет реального эпизода с оценкой. История привлекает читателей и не оценивает власть."]: [&"The playful exaggeration of talent does not change the real incident with the mark. The story attracts readers without judging the authorities."],
[&"", &"За пустую страницу: высший балл! Учительница без очков открыла талант енота"]: [&"Top marks for a blank page! Teacher without glasses discovers raccoon\'s talent"],
[&"", &"Учительница сверила число с журналом. Читатели получают точные сведения, городское депо: небольшое одобрение своей работы."]: [&"The teacher checked the number against the log. Readers get accurate information; the city depot gets a little approval for its work."],
[&"", &"Девять забытых вещей вернули владельцам за неделю в трамвайном депо"]: [&"Tram depot returns nine forgotten items to owners in one week"],
[&"", &"Уважаемые родители, Клёп получил высший балл за пустую страницу. Я потеряла очки в трамвае, проверяла по памяти почерка. У пустой страницы он оказался лучше всех.\n\nОчки нашёл дежурный в депо. Отец Клёпа, енот из мастерской, забрал по записке; линзы сверили с рецептом. Принёс после работы, починил школьный звонок. Спросил, как подписать музыкальную открытку для «одной знакомой». Советую начать с имени. Взрослых тоже учим.\n\nДиректор Рельс выделил находкам стол и вечернего дежурного. Девять вещей за неделю уже вернули, журнал читала сама, в очках. Осталась варежка с вышитым ключиком, полка четыре.\n\nОценку исправила. Клёп упражнение сделал, теперь заслуженно. Пустых тетрадей не присылайте: я хоть сова, ночью тоже иногда сплю.\n\nМисс Оул, вечерняя школа."]: [&"Dear parents, Klep received top marks for a blank page. I lost my glasses on the tram and marked the work from my memory of the handwriting. His blank page had the best handwriting of all.\n\nThe depot attendant found the glasses. Klep\'s father, the raccoon from the workshop, collected them with my note; they checked the lenses against the prescription. He brought them after work and fixed the school bell. Asked how to sign a musical card for \"a lady I know\". I suggest starting with a name. We teach the adults too.\n\nDirector Rails set aside a table for lost property and appointed an evening attendant. Nine items have already been returned this week; I read the log myself, with my glasses on. One mitten with an embroidered little key remains, shelf four.\n\nI corrected the mark. Klep did the exercise, so now it is deserved. Please don\'t send blank exercise books: I may be an owl, but even I sometimes sleep at night.\n\nMiss Owl, evening school."],
[&"", &"Обращение к родителям · За очки оценки не ставят"]: [&"A note to parents · No marks for returning glasses"],
[&"", &"Мастер действительно приступил к работе. Поддержка конкретного действия не выдаёт обещанный ремонт за завершённый."]: [&"The repairman really has started work. Support for a specific action does not pass off the promised repair as completed."],
[&"", &"К немой будке у кинотеатра телефонная служба уже прислала мастера"]: [&"Telephone service has already sent a repairman to the silent cinema booth"],
[&"", &"Один сорвавшийся разговор растянут на четыре дня непрерывного ожидания. Выдуманная драма уменьшает доверие и лояльность."]: [&"One missed conversation has been stretched into four days of constant waiting. The invented drama reduces trust and loyalty."],
[&"", &"Четыре дня мать не выходит из будки: сын больше не звонит!"]: [&"Four days without leaving the booth: a mother\'s son no longer calls!"],
[&"", &"Сообщение точно передаёт поломку и объявленный срок. Читателям полезно предупреждение, телефонной службе неприятна огласка неудобства."]: [&"The report accurately states the fault and the announced deadline. Readers benefit from the warning; the telephone service dislikes the inconvenience being publicised."],
[&"", &"Будка у кинотеатра сломана: ремонт обещан до вторника"]: [&"Cinema phone booth broken: repair promised by Tuesday"],
[&"", &"1. Крыша не течёт. 2. Огурцы взошли. 3. Платок не покупать. 4. Как он ест?\n\nСын звонит по воскресеньям к девяти из другого города: в будку кинотеатра, где я сторожу. Дома телефона нет. Список, чтобы не говорить одни огурцы. Всё равно говорю.\n\nА тут не позвонил. Обиделась, испугалась, обошла будку трижды. Для черепахи это расследование.\n\nТелефонист Лайн подтвердил: аппарат сломан с субботы. Объявление о ремонте до вторника дождь прилепил буквами к стеклу. Рабочая будка через два квартала. Сегодня мастер уже пришёл, сидит с инструментами. Я бы поместилась, но неловко.\n\nНа следующее воскресенье Лайн договорился о звонке в служебную комнату кинотеатра. Сыну передали. Дописала: «Я не сердилась». Зачеркнула: услышит.\n\nТорти."]: [&"1. The roof doesn\'t leak. 2. The cucumbers have sprouted. 3. Don\'t buy a scarf. 4. Is he eating properly?\n\nMy son calls from another city on Sundays at nine: the phone booth by the cinema where I work as a caretaker. No telephone at home. The list is so I don\'t talk only about cucumbers. I still do.\n\nBut this time he didn\'t call. I felt hurt, then frightened, and went round the booth three times. For a tortoise, that is an investigation.\n\nLine, the telephone technician, confirmed: the phone has been broken since Saturday. Rain had stuck the repair notice, promising service by Tuesday, face down against the glass. There is a working booth two blocks away. The repairman has already arrived today and is sitting there with his tools. I could fit inside too, but it would be awkward.\n\nFor next Sunday, Line arranged a call to the cinema\'s staff room. My son has been told. I added, \"I wasn\'t cross.\" Crossed it out: he\'ll hear that anyway.\n\nTorti."],
[&"", &"Неиспользованный список новостей · Торти ждёт звонка"]: [&"Unused list of news · Torti waits for a call"],
[&"", &"Названная причина остаётся объяснением казначея, выплата: обещанием. Сдержанная поддержка его ответа даёт небольшой рост доверия и лояльности."]: [&"The stated reason remains the treasurer\'s explanation, and payment remains a promise. Restrained support for the reply brings a small increase in trust and loyalty."],
[&"", &"Казначейство назвало причину задержки и обещало рассчитаться в среду"]: [&"Treasury gives reason for delay and promises payment on Wednesday"],
[&"", &"Невыплату вы назвали доказанным хищением. Продажи растут ценой доверия читателей и отношений с казначейством."]: [&"You called nonpayment proven embezzlement. Sales rise at the expense of readers\' trust and relations with the treasury."],
[&"", &"Казначей прикарманил зарплаты: часы ратуши отбивают украденные деньги!"]: [&"Treasurer pockets wages: town hall clock chimes out stolen money!"],
[&"", &"Задержка подтверждена листками, банком и ответом казначея. Читатели ценят публикацию, власти недовольны оглаской долга."]: [&"The delay is confirmed by payslips, the bank and the treasurer\'s reply. Readers value the publication; the authorities dislike the debt being publicised."],
[&"", &"Башня бьёт вовремя, зарплата опаздывает: пятерым часовщикам должны за два месяца"]: [&"The tower strikes on time, wages run late: five clock repairers owed two months\' pay"],
[&"", &"Несу в ратушу шестерёнку. Дочь: «Пап, у часов живот есть? А зачем ты их кормишь?» Я белка, слесарь Нокс. Домой вместо запасов несу разговоры.\n\nБашенные часы починили в феврале. Бьют честно: в лавке напротив уже знают, сколько нам должны. За февраль и март не заплатили всем пятерым. Листки приложили, в банке проверили: перевода нет.\n\nСкрипп из казначейства ответил, что ошиблись номером счёта, перечислят в следующую среду. Я обвёл среду, дочь нарисовала орех.\n\nНа работу ходим: остановить часы легче, чем объяснять городу опоздания. У Шпунта больная мама, у Тикса квартплата, у меня юный бухгалтер с карандашами. Хоть бы к среде купить ей настоящий орех."]: [&"I am carrying a cog to the town hall. My daughter asks, \"Dad, do clocks have stomachs? Why do you feed them?\" I am Knox, a squirrel and mechanic. I bring home conversations instead of provisions.\n\nWe repaired the tower clock in February. It strikes honestly: the shop opposite already knows how much we are owed. None of the five of us has been paid for February or March. Payslips enclosed; we checked with the bank: no transfer has arrived.\n\nSkripp at the treasury replied that they got the account number wrong and would transfer the money next Wednesday. I circled Wednesday; my daughter drew a nut.\n\nWe keep going to work: stopping the clock is easier than explaining everyone\'s lateness to the city. Shpunt has a sick mother, Tix has rent, and I have a young accountant with pencils. If only I could buy her a real nut by Wednesday."],
[&"", &"Объяснительная для дочери · Почему папе не платят"]: [&"An explanation for a daughter · Why Dad isn\'t getting paid"],
[&"", &"Проверка чеков действительно проведена. Похвала полиции касается её результата, а не решения всей хлебной проблемы."]: [&"The receipts really were checked. Praise for the police concerns that result, without suggesting the entire bread problem is solved."],
[&"", &"Полицейская разобралась с «тайным хлебом»: скрытой наценки не нашла"]: [&"Policewoman checks the \"secret bread\" and finds no hidden markup"],
[&"", &"Острый вопрос отражает настоящую нехватку ржаного и спор о брони. Пекарша не объявлена мошенницей, интерес не требует обмана."]: [&"The pointed question reflects a real rye shortage and a dispute over reserved bread. The baker is not branded a fraud; the story draws interest without deception."],
[&"", &"Под прилавком: хлеб для дворника. А тем, кто стоял в очереди, что грызть?"]: [&"Under the counter: bread for the sweeper. What are those in the queue meant to chew?"],
[&"", &"Чеки подтверждают цену, саму бронь редакция не скрывает. Читатели доверяют изложению, частный спор не оценивает власть."]: [&"The receipts confirm the price, and the paper does not hide the reservation itself. Readers trust the account; the private dispute makes no judgement on the authorities."],
[&"", &"Две буханки для Брума: пекарша оставляет хлеб дворнику по обычной цене"]: [&"Two loaves for Broom: baker saves bread for street sweeper at the regular price"],
[&"", &"Насчёт фото «тайного хлеба». Да, две ржаные буханки лежали под прилавком. Фотограф нагнулся за мелочью и стал борцом за правду.\n\nОставляю Бруму, дворнику: после смены ржаной уже раскуплен. Он всякий раз говорит: «Мьетта, я вам снег убрал». Даже в апреле. Платит как все, чеки отдала полицейской. Она проверила: скрытой наценки нет.\n\nБелый у нас есть до вечера. Ржаной печём два раза, на всех не хватает; третью партию печь не вместит. Понимаю тех, кто ушёл без хлеба. Но Брум как раз подметает улицу, на которой они стоят.\n\nСегодня привязал к хлебной тележке синюю ленточку: чтобы я из окна видела, что пришёл. Машет снизу, будто пароход причалил.\n\nМышь Мьетта, пекарша. Пакет чистый, крошки мои."]: [&"About that photograph of \"secret bread\". Yes, two rye loaves were under the counter. The photographer bent down for his change and became a crusader for truth.\n\nI save them for Broom, the street sweeper: by the end of his shift, the rye is sold out. Every time he says, \"Miette, I cleared your snow.\" Even in April. He pays what everyone pays; I gave the receipts to the policewoman. She checked: there is no hidden markup.\n\nWe have white bread until evening. We bake rye twice a day, and there isn\'t enough for everyone; the oven won\'t take a third batch. I understand those who left without bread. But Broom is busy sweeping the very street they are standing on.\n\nToday he tied a blue ribbon to the bread trolley so I could see from the window that he had arrived. He waves down below as though a steamer has docked.\n\nMiette the mouse, baker. The bag is clean; the crumbs are mine."],
[&"", &"Пакет от батона · Мьетта отвечает очереди"]: [&"Bread bag · Miette answers the queue"],
[&"", &"Похвала связывает оплаченную покупку с её подтверждённой пользой. Доверие и лояльность растут за конкретный результат."]: [&"The praise links the funded purchase to its verified benefit. Trust and loyalty rise for a concrete result."],
[&"", &"Город оплатил генератор: родильные палаты остались со светом и приборами"]: [&"City-funded generator kept maternity ward lights and equipment running"],
[&"", &"Тёплая сцена соответствует письму и не добавляет угрозы жизни. Читатели интересуются историей без оценки действий власти."]: [&"The warm scene matches the letter and adds no threat to life. Readers enjoy the story without a verdict on the authorities\' actions."],
[&"", &"Первый крик в освещённом окне: двое зайчат родились, пока за окном гас свет"]: [&"First cry in a lit window: two baby hares born as the lights outside went out"],
[&"", &"Акт установки и журнал дежурства подтверждают работу покупки. Точные сведения повышают доверие и немного поддерживают городскую больницу."]: [&"The installation certificate and duty log confirm the purchase was working. Accurate details increase trust and offer a little support to the city hospital."],
[&"", &"При отключении света родильное отделение сорок минут работало от генератора"]: [&"Maternity ward ran on a generator for forty minutes during power cut"],
[&"", &"Генератор у нас здоровенный: сначала рычит, потом работает. Тилли сказала, на главврача похож, только у того наоборот. Главврач согласился.\n\nВо вторник погас свет. В палате лампы горели, приборы работали. В коридоре темно, Тилли с чайником завидует лампе. Генератор только для отделения, кухню не подключали.\n\nЗа те сорок минут родились двое зайчат. Один возмутился, второй поддержал. Здоровые оба, мама тоже; фотографа пока не хочет. Пусть познакомятся без газеты.\n\nПокупку оплатил город, установили ещё на прошлой неделе. Акт у главврача, сорок минут в моём журнале. Эту страницу он читал молча и улыбался.\n\nСпайра, ёжиха, акушерка. Тилли просит дописать: чайник исправный. А то ещё один купят."]: [&"Our generator is enormous: first it growls, then it works. Tilly said it resembles the head doctor, only he does it the other way round. The head doctor agreed.\n\nThe power went out on Tuesday. The ward lights stayed on, the equipment kept working. The corridor was dark; Tilly, holding her kettle, envied the lamp. The generator serves only the ward; the kitchen was not connected.\n\nTwo baby hares were born during those forty minutes. One protested; the other backed him up. Both are healthy, and so is their mother; she doesn\'t want a photographer yet. Let them meet without a newspaper present.\n\nThe city paid for the purchase; it was installed last week. The head doctor has the installation certificate, and my log has the forty minutes. He read that page in silence and smiled.\n\nSpira, hedgehog, midwife. Tilly asks me to add: the kettle works. In case they buy another."],
[&"", &"Листок из ординаторской · Два зайчонка и один чайник"]: [&"Note from the doctors\' room · Two baby hares and one kettle"],
[&"", &"Материал уже выдан, ремонт обозначен как предстоящий. Похвала конкретной помощи повышает доверие и отношение ведомства."]: [&"The material has already been supplied; the repair is clearly still to come. Praise for specific help increases trust and the department\'s goodwill."],
[&"", &"Жилищное бюро выдало кабель: Колумбо вернёт картинку двум подъездам"]: [&"Housing bureau supplies cable: Columbo to restore the picture to two entrances"],
[&"", &"Один повреждённый кабель превратился в тайную операцию против всего города. Необоснованное подозрение вредит доверию и лояльности."]: [&"One damaged cable became a secret operation against the whole city. The groundless suspicion damages trust and loyalty."],
[&"", &"Голубиная глушилка над городом: кто не даёт Бриполису смотреть телевизор?"]: [&"Pigeon jammer above the city: who is stopping Bripolis watching TV?"],
[&"", &"Мастер показал место повреждения. Причина помех передана без обвинений и политической оценки, доверие читателей растёт."]: [&"The repairman showed the damaged section. The cause of interference is reported without accusations or a political verdict, increasing readers\' trust."],
[&"", &"Сериал заснежило из-за кабеля: у седьмого дома повреждена антенная линия"]: [&"Snow on the soap opera traced to cable: Number Seven\'s aerial line damaged"],
[&"", &"Редакция, передайте седьмому дому: я на крыше по специальности. Диплом радиомастера дома, здесь сдувает.\n\nЖильцы кричат, что глушу телевизоры. У сеньоры Сериаллы должны раскрыть, кто отец жеребёнка; она готова раскрыть меня. Спустился с куском кабеля: его перетёрло о водосток. Соседи убедились, Сериалла нет.\n\nНовый кабель уже получил в жилищном бюро. Завтра после обеда заменю, у обоих подъездов ненадолго пропадёт приём; объявления висят. Управляющий Бартесс велел антенну не снимать. Сосед хотел убрать её вместе с моей «станцией»: плоскогубцами и термосом. Термос действительно что-то выпускает, но это чай.\n\nЕсли отец жеребёнка окажется тем, кого Сериалла подозревает с февраля, я тоже не причастен.\n\nГолубь Колумбо. Отвечайте обычной почтой: на работе занят."]: [&"Editors, please tell Number Seven: I am on the roof in a professional capacity. My radio repair diploma is at home; it would blow away up here.\n\nResidents shout that I am jamming their televisions. Signora Serialla is about to find out who fathered the foal; she is ready to find out what is inside me. I came down with a piece of cable: it had rubbed through against the gutter. The neighbours were convinced. Serialla wasn\'t.\n\nI have already collected a new cable from the housing bureau. I will replace it tomorrow afternoon; reception will briefly go out in both entrances. Notices are up. The manager, Bartess, said to leave the aerial in place. A neighbour wanted it removed along with my \"station\": pliers and a thermos. The thermos does emit something, but it is tea.\n\nIf the foal\'s father turns out to be the one Serialla has suspected since February, I had nothing to do with that either.\n\nColumbo the pigeon. Reply by regular post: I am busy at work."],
[&"", &"Ответ с крыши · «Голубиная почта тут ни при чём»"]: [&"Reply from the roof · \"Pigeon post has nothing to do with it\""],
[&"", &"Открытый проход уже есть, перенастройка честно названа будущей. Полезное сообщение поддерживает транспортную службу и сохраняет доверие."]: [&"The open passage already exists; resetting is honestly presented as a future action. The useful report supports the transport service and preserves trust."],
[&"", &"Станция открыла свободный проход и перенастроит створки к пятнице"]: [&"Station opens a free passage and promises to reset gates by Friday"],
[&"", &"Порванное пальто стало увечьем, а неудачная настройка: запретом на проезд. Ложная тревога портит отношения с читателями и властями."]: [&"A torn coat became a mutilation, and a poor setting became a travel ban. The false alarm damages relations with readers and the authorities."],
[&"", &"На «Ратушной» режут хвосты! Пушистым велели сидеть дома!"]: [&"Tails sliced off at Town Hall! Fluffy passengers told to stay home!"],
[&"", &"Письмо станции подтверждает неполные испытания и неверную настройку. Читатели ценят критику, начальство недовольно оглаской ошибки."]: [&"The station\'s letter confirms incomplete testing and incorrect settings. Readers value the criticism; management dislikes the mistake being publicised."],
[&"", &"Пальто енота не прошло: турникеты «Ратушной» испытывали по кошачьей мерке"]: [&"Raccoon\'s coat fails the test: Town Hall turnstiles were fitted to a feline measure"],
[&"", &"Кто шил моё пальто? Я. Порвал? Турникет на «Ратушной». Перешивать опять мне. Выгодно поставлен городской заказ.\n\nСтворка схватила полу поверх хвоста. Я шагнул, пальто осталось. Пока дежурная выключала, сзади просили не задерживать движение. Кот предложил похудеть. Уважаемый кот, хвост у меня семейный.\n\nДо травмы не дошло: врач осмотрел, ушибов нет. Ткань стоит половину вечерней выручки. Фото разрыва приложил: о шве не судите, это работа турникета.\n\nНачальник извинился письменно: задержку створки рассчитывали по кошачьему образцу, пушистые хвосты не испытывали. Пока один проход держат открытым, к пятнице обещают перенастроить остальные. Теперь меня встречает табличка «Неисправно». Чувствую себя делегацией.\n\nТвилл, енот, портной. Турникеты в ремонт не присылайте."]: [&"Who made my coat? I did. Who tore it? The turnstile at Town Hall station. Who gets to mend it? Me again. A nicely arranged city contract.\n\nThe gate caught the coat tail over my tail. I stepped forward; the coat stayed put. While the attendant switched it off, those behind asked me not to hold up traffic. A cat suggested losing weight. Dear cat, this tail runs in the family.\n\nNo injury resulted: a doctor examined me and found no bruising. The fabric costs half an evening\'s takings. Photo of the tear enclosed: don\'t judge the stitching, that is the turnstile\'s work.\n\nThe manager apologised in writing: the gate delay was calculated using a feline model; fluffy tails were never tested. For now they are keeping one passage open and promise to reset the others by Friday. Now I am greeted by a sign saying \"Out of order\". I feel like a visiting delegation.\n\nTwill, raccoon, tailor. Please do not send me turnstiles to repair."],
[&"", &"Счёт за ремонт пальто · Твилл против створки"]: [&"Coat repair bill · Twill versus the gate"],
[&"", &"Заведующая действительно пообещала сохранить находку. Читатели ценят помощь, муниципальному учреждению приятна заслуженная похвала."]: [&"The manager really did promise to keep the find safe. Readers value the help; the municipal office welcomes its well-earned praise."],
[&"", &"Бюро находок подождёт выходного Флёр, чтобы вернуть ей семейную запись"]: [&"Lost property office will wait for Fleur\'s day off to return her family recording"],
[&"", &"Надпись и ценность записи для Флёр есть в объявлении. Личная история цепляет читателей без выдуманной беды и оценки власти."]: [&"The inscription and the recording\'s value to Fleur are in the notice. The personal story hooks readers without invented hardship or a verdict on the authorities."],
[&"", &"«ПАПУ НЕ СТИРАТЬ»: история знакомства оказалась ценнее целой кассеты хитов"]: [&"\"DO NOT ERASE DAD\": how they met proved worth more than a whole tape of hits"],
[&"", &"Заведующая подтвердила запись в журнале. История остаётся достоверной, городское бюро получает небольшое одобрение."]: [&"The manager confirmed the entry in the log. The story stays accurate, and the city office receives a little approval."],
[&"", &"Семейная кассета с сырного рынка нашлась в бюро находок"]: [&"Family cassette from the cheese market turns up at the lost property office"],
[&"", &"Потеряна кассета в красной коробочке. Сырный рынок, суббота. Сторона А: «Мокрые хвосты» с «Хвост FM», посреди песни прогноз погоды. Сторона Б: папа знакомится с мамой.\n\nТо есть рассказывает. Знакомился без магнитофона, иначе мама бы ушла. На коробочке написано «ПАПУ НЕ СТИРАТЬ». За возврат дам кассету и сыр. Субботний съели. Лиса Флёр.\n\nПриписка, понедельник. Объявление можно снять! Мышь Пип нашёл коробочку у весов и отнёс в городское бюро находок. В бюро спросили, как опознать. После слов «я тогда был красавцем» мама громко кашляет. Хватило.\n\nВо вторник выдача совпала со сменой. Заведующая согласилась подержать до выходного. Папа дописывает важное. Мама говорит, если опять её имя, можно не искать."]: [&"Lost: cassette in a red case. Cheese market, Saturday. Side A: \"Wet Tails\" from \"Tail FM\", with a weather forecast in the middle of a song. Side B: Dad meets Mum.\n\nTells the story, I mean. He met her without a tape recorder, or Mum would have left. The case says \"DO NOT ERASE DAD\". Reward: a cassette and some cheese. We ate Saturday\'s cheese. Fleur the fox.\n\nPostscript, Monday. You can take the notice down! Pip the mouse found the case by the scales and took it to the city\'s lost property office. They asked how to identify it. After the words \"I was quite a looker back then\", Mum coughs loudly. That was enough.\n\nTuesday\'s collection hours clashed with my shift. The manager agreed to keep it until my day off. Dad is recording something important to add. Mum says if it is her name again, we needn\'t bother looking."],
[&"", &"Платное объявление с припиской · «Папу не стирать»"]: [&"Paid notice with a postscript · \"Do not erase Dad\""],
[&"", &"Спасатели действительно помогли жителям и спасли книги. Подтверждённая похвала повышает доверие читателей и лояльность службы."]: [&"The rescuers really did help the residents and save the books. Verified praise increases readers\' trust and the service\'s loyalty."],
[&"", &"Две городские лодки вывезли жителей Плотинной и детский книжный фонд"]: [&"Two city boats evacuated Dam Street residents and the children\'s book collection"],
[&"", &"Необычная сцена взята из дневника. Она привлекает внимание без выдуманной катастрофы и без оценки государства."]: [&"The unusual scene comes from the diary. It attracts attention without an invented disaster or a verdict on the government."],
[&"", &"«Морские приключения» эвакуированы: библиотекари спасались на читательском столе"]: [&"\"Sea Adventures\" evacuated: librarians took refuge on a reading table"],
[&"", &"Число сверено с журналом спасателей. Читатели доверяют точному сообщению, городская служба ценит признание своей помощи."]: [&"The figure was checked against the rescue log. Readers trust the precise report; the city service appreciates recognition of its help."],
[&"", &"Одиннадцать жителей Плотинной вывезли на лодках, пострадавших нет"]: [&"Eleven Dam Street residents taken out by boat, no injuries"],
[&"", &"9:10. Плотинная оправдывает название. Воду мерили линейкой из читального зала. Теперь она в мокром фонде.\n\n9:40. Книги на шкафах. Мадам Фолио требует поднять «Морские приключения»: не нравится, как они на всё смотрят. Мы на столе.\n\n11:50. Приехали городские спасатели, две лодки. Старший спросил, кто остался. Мадам Фолио начала авторов по алфавиту. Пришлось уточнить: жильцы внизу, писатели на шкафах. Сначала вывезли жильцов, потом детские книги.\n\nВечером сверили журнал: одиннадцать жителей, пострадавших нет. Вода уходит. Коммунальное бюро ещё выясняет, откуда она так быстро пришла; Фолио уже выяснила, но только вслух.\n\nСушим сказки. В одной записка: «Верните до пятницы, папа обещал дочке». Пятницу постараемся не намочить.\n\nБобр Плотт, библиотекарь. Со стола переписал на сухой лист."]: [&"9:10. Dam Street is living up to its name. We measured the water with a ruler from the reading room. It is now part of the wet collection.\n\n9:40. Books on top of the cabinets. Madame Folio demands we raise \"Sea Adventures\": she dislikes the way it is looking at everything. We are on the table.\n\n11:50. City rescuers arrived with two boats. Their leader asked who was left. Madame Folio started listing authors alphabetically. We had to clarify: residents downstairs, writers on the cabinets. They took the residents out first, then the children\'s books.\n\nChecked the log that evening: eleven residents, no injuries. The water is receding. The utilities bureau is still investigating where it came from so quickly; Folio has already established that, though only out loud.\n\nDrying the fairy tales. A note in one: \"Please return by Friday, Dad promised his daughter.\" We will try to keep Friday dry.\n\nPlott the beaver, librarian. Copied this from the table onto a dry sheet."],
[&"", &"Дневник книговыдачи · Плотт, временно на столе"]: [&"Library lending log · Plott, temporarily on a table"],
[&"", &"Малолюдность рейса указана в расписании, но подача скрывает нуждающихся в нём пассажиров. Ведомству нравится поддержка, читателям: меньше."]: [&"The timetable notes the low passenger numbers, but this framing hides the passengers who need the service. The department welcomes the support; readers are less pleased."],
[&"", &"Меньше пустых рейсов: целее казна: транспортный отдел сокращает расходы"]: [&"Fewer empty runs, fuller coffers: transport department cuts costs"],
[&"", &"В письме нет ни ночёвок на улице, ни отмены всего транспорта. Выдуманная беда продаётся, но разрушает доверие и раздражает власти."]: [&"The letter mentions neither nights on the street nor the cancellation of all transport. Invented hardship sells, but destroys trust and annoys the authorities."],
[&"", &"Больные ночуют на остановках: кошачье начальство сняло последний транспорт!"]: [&"The sick sleep at bus stops: feline bosses scrap the last transport home!"],
[&"", &"Новое расписание подтверждает отмену вечернего рейса. Читатели узнают о неудобстве заранее, транспортный отдел недоволен оглаской сокращения."]: [&"The new timetable confirms the cancellation of the evening run. Readers hear about the inconvenience in advance; the transport department dislikes having the cut publicised."],
[&"", &"Шестёрка уйдёт спать раньше: последний рейс отменяют с понедельника"]: [&"Number Six gets an earlier bedtime: last run cancelled from Monday"],
[&"", &"Вчера Ролло уже снял штанги, когда пришёл барсук из котельной с женой: после больницы ходит медленно. Ролло делает вид, что долго проверяет зеркало.\n\nЗаяц с козой спорили, кому сидеть. Когда барсучиха подошла, он держал дверь, она сумку. Барсук рассказывал, что в котельной даже рыжие после смены чёрные. Ролло посоветовал мыться до посадки.\n\nА с понедельника этого рейса не будет: транспортный отдел вычеркнул его из расписания, после десяти мало пассажиров. Дневные оставили. Бумагу в депо я видела, на остановке пока реклама аккордеона. Ролло пока будет подъезжать по привычке, но без пассажиров.\n\nЛеппа, кондуктор. Билет приложила использованный, а то ещё за проезд возьмут."]: [&"Yesterday Rollo had already lowered the trolley poles when the badger from the boiler house arrived with his wife: she walks slowly after her hospital stay. Rollo pretends to spend a long time checking his mirror.\n\nA hare and a goat were arguing over who should sit. When Mrs Badger came up, he held the door, she held the bag. The badger said even ginger fur comes out black after a shift in the boiler house. Rollo suggested washing before boarding.\n\nAnd from Monday this run will be gone: the transport department has crossed it off the timetable, with few passengers after ten. They kept the daytime runs. I saw the notice at the depot; the stop still has an accordion advertisement. Rollo will keep coming out of habit for now, but without passengers.\n\nLeppa, conductor. I enclosed a used ticket, or they might charge me for the ride."],
[&"", &"Билет на обороте письма · Леппа, шестой маршрут"]: [&"Ticket on the back of a letter · Leppa, Route Six"],
[&"", &"к беспорядкам и смене власти они не призывают"]: [&"they are not calling for unrest or a change of government"],
[&"", &"назначил рассмотрение на пятницу. Переход пока не сделали."]: [&"scheduled its review for Friday. The crossing has not been built yet."],
[&"", &"Тридцать жителей подписали просьбу сделать переход у больницы."]: [&"Thirty residents signed a request for a crossing by the hospital."],
[&"", &"Совету досталась благодарность до пятничного рассмотрения. Перехода ещё нет, и читатели замечают, что готов только ваш заголовок."]: [&"The council received thanks before Friday\'s review. There is still no crossing, and readers notice that only your headline is finished."],
[&"", &"Просили: получили: совет уже построил переход и исполнил все пожелания"]: [&"Asked and answered: council has built crossing and granted every wish"],
[&"", &"Мирные подписи выдали за начало переворота. Читатели видят опасную выдумку, совет осуждает ложь о восстании города."]: [&"Peaceful signatures were presented as the start of a coup. Readers see a dangerous invention, and the council condemns the lie about a city uprising."],
[&"", &"Термос, стул и переворот: весь Бриполис восстал против кошачьей власти!"]: [&"Flask, chair and a coup: all Bripolis rises against feline rulers!"],
[&"", &"Мирная просьба не стала бунтом, а нерешённая проблема: готовой победой. Читатели доверяют газете, совету неприятно публичное напоминание об обращении."]: [&"A peaceful request did not become a riot, nor an unresolved problem a finished victory. Readers trust the paper; the council dislikes the public reminder of the petition."],
[&"", &"Полосатую дорогу к больнице: тридцать жителей подписали просьбу о переходе"]: [&"A striped road to the hospital: thirty residents sign crossing petition"],
[&"", &"Тридцать жителей подписали просьбу сделать переход у больницы. Подписи подлинные. Среди авторов пёс с хромотой, мама с коляской, черепаха, закончившая переход дороги после закрытия регистратуры. Возраст просит не указывать: дело в ширине улицы.\n\nСовет зарегистрировал обращение и назначил рассмотрение на пятницу. Переход пока не сделали. Авторы подчёркивают: к беспорядкам и смене власти они не призывают. Принесли термос, стул и линейку для замера съезда коляски.\n\nКот-секретарь просил убрать стул из прохода. Черепаха просила сначала сесть. Копию петиции спасли от дождя пакетом из пекарни. На обороте теперь «Осторожно, горячо». Решили, что сойдёт."]: [&"Thirty residents signed a request for a crossing by the hospital. The signatures are genuine. The authors include a dog with a limp, a mother with a pushchair, and a tortoise who finished crossing the road after the reception desk closed. She asks us not to mention her age: the issue is the width of the street.\n\nThe council registered the petition and scheduled its review for Friday. The crossing has not been built yet. The authors stress that they are not calling for unrest or a change of government. They brought a flask, a chair and a ruler to measure a pushchair ramp.\n\nThe cat acting as secretary asked them to move the chair out of the way. The tortoise asked him to sit down first. A bakery bag saved the petition copy from the rain. The back now says \"Caution: hot\". They decided that would do."],
[&"", &"Тридцать подписей · переход у больницы"]: [&"Thirty signatures · a crossing by the hospital"],
[&"", &"Кто первый видел золото, неизвестно."]: [&"Who first saw the gold is unknown."],
[&"", &"Ни снимка находки, ни названного очевидца в газетах нет."]: [&"The newspapers show neither a photograph of the find nor a named eyewitness."],
[&"", &"«Писк» ссылается на «Свисток»."]: [&"The Squeak cites the Whistle."],
[&"", &"Мэрии приятна богатая реклама. Ни слитков, ни обещания в источниках нет, и читатели перестают верить красивому будущему от газеты."]: [&"City Hall appreciates the rich publicity. The sources contain neither gold bars nor a promise, and readers stop believing the beautiful future sold by the paper."],
[&"", &"Золотая эра Бриполиса: мэрия нашла запас и обещает богатство каждому"]: [&"Bripolis enters golden age: City Hall finds reserves, promises wealth for everyone"],
[&"", &"Три перепечатки одного слуха не стали тремя расследованиями. Читатели обнаружили круг ссылок, власти недовольны неподтверждённой сенсацией."]: [&"Three reprints of one rumour did not become three investigations. Readers discovered the circular citations, and the authorities resent the unconfirmed sensation."],
[&"", &"Три газеты не ошибутся: тайное золото под мэрией доказано!"]: [&"Three newspapers cannot be wrong: secret City Hall gold proven!"],
[&"", &"Читатели увидели цепочку ссылок вместо доказательств. Доверие растёт; вы проверили работу газет, не приписав государству находку или вину."]: [&"Readers saw a chain of citations in place of evidence. Trust grows; you checked the newspapers\' work without crediting the state with a find or accusing it of wrongdoing."],
[&"", &"«Писк» слышал «Свисток»: газеты ходят по кругу в поисках золота мэрии"]: [&"Squeak heard Whistle: newspapers go round in circles seeking City Hall gold"],
[&"", &"Буфетчице мэрии принесли три газеты: «Принимайте слитки». «Городской свисток» пишет о золоте под мэрией, ссылаясь на «Вечерний писк». «Писк» ссылается на «Свисток». Третья газета поставила заметки рядом: «Подтверждено дважды».\n\nКрот Кротти обвёл ссылки: петлю впору распутывать ножницами. Ни снимка находки, ни названного очевидца в газетах нет. Кто первый видел золото, неизвестно. Кто списал первым, тоже не признаются.\n\nБуфетчица хранит в подвале картошку, но это не доказательство отсутствия сокровищ. «Пусть принесут слиток. Вчера искала двадцать центов на сдачу, газеты не помогли». Вырезки есть. Обещаний чиновников к ним не приложено."]: [&"The City Hall canteen lady was handed three newspapers: \"Here come your gold bars.\" The City Whistle reports gold beneath City Hall, citing the Evening Squeak. The Squeak cites the Whistle. A third paper put the stories side by side: \"Confirmed twice.\"\n\nKrotti the mole circled the references: this loop calls for scissors. The newspapers show neither a photograph of the find nor a named eyewitness. Who first saw the gold is unknown. Nobody will admit who copied whom first either.\n\nThe canteen lady keeps potatoes in the basement, but that does not prove there is no treasure. \"Let them bring me a gold bar. Yesterday I needed twenty cents in change. The newspapers were no help.\" We have the clippings. No promises from officials came with them."],
[&"", &"Три вырезки · золото под мэрией"]: [&"Three clippings · gold beneath City Hall"],
[&"", &"В остальном Бриполисе отключений не запланировано."]: [&"No outages are planned elsewhere in Bripolis."],
[&"", &"Во вторник с 10 до 12 часов в трёх домах на улице Колокольчиков отключат электричество"]: [&"On Tuesday from 10:00 to 12:00, electricity will be cut to three buildings on Bellflower Street"],
[&"", &"Службе приятно выглядеть всемогущей. Объявленное отключение и отсутствие вечных гарантий делают похвалу неправдоподобной для читателей."]: [&"The utility appreciates looking all-powerful. The announced outage and lack of eternal guarantees make the praise implausible to readers."],
[&"", &"Последний обрыв позади: электросети гарантируют свет навсегда"]: [&"Last broken cable behind us: power utility guarantees light forever"],
[&"", &"Два часа в трёх домах превратились в бессрочную тьму для города. Читатели заметили ложь, электросети недовольны выдуманной тревогой."]: [&"Two hours in three buildings became endless darkness for the city. Readers spotted the lie, and the power utility resents the invented alarm."],
[&"", &"Запасайтесь свечами навсегда: весь Бриполис погружается во тьму!"]: [&"Stock up on candles forever: all Bripolis plunges into darkness!"],
[&"", &"Известные адреса и срок помогают подготовиться. Читатели доверяют расписанию; оценок работы электросетей вы не добавили."]: [&"The addresses and timing help people prepare. Readers trust the schedule; you added no judgements on the power utility\'s performance."],
[&"", &"Два часа без утюга: во вторник меняют кабель в трёх домах на Колокольчиков"]: [&"Two hours without the iron: cable replacement Tuesday at three Bellflower buildings"],
[&"", &"Во вторник с 10 до 12 часов в трёх домах на улице Колокольчиков отключат электричество для замены кабеля. Номера у подъездов и на доске электросетей. В остальном Бриполисе отключений не запланировано. Закончите работу с электроприборами заранее.\n\nПриписка: «Не звоните в десять проверять, выключили ли. Телефон обычный, работает». Енот Твик говорит, изоляция старше ученика, а тот уже женат. Вечную бесперебойность обещать не стал.\n\nСоседи назначили на эти часы обмен кассетами. На записи «Хвост FM» посреди песни слышно «Сними чайник!». Хозяйка просит сохранить: это голос мужа, а он теперь всё чаще звонит из другого города."]: [&"On Tuesday from 10:00 to 12:00, electricity will be cut to three buildings on Bellflower Street for cable replacement. Building numbers are posted at the entrances and on the power utility noticeboard. No outages are planned elsewhere in Bripolis. Finish using electrical appliances beforehand.\n\nA note: \"Do not phone at ten to check whether it is off. It is an ordinary telephone. It works.\" Twik the raccoon says the insulation is older than his apprentice, who is already married. He stopped short of promising uninterrupted power for eternity.\n\nThe neighbours have arranged a cassette swap for those hours. Halfway through a song on a Tail FM recording, someone shouts, \"Take the kettle off!\" Its owner asks that they keep it: it is her husband\'s voice, and these days he calls from another city more and more often."],
[&"", &"Объявление электросетей · улица Колокольчиков"]: [&"Power utility notice · Bellflower Street"],
[&"", &"Остальные продукты проверку прошли, за медицинской помощью никто не обращался."]: [&"All other food passed inspection, and nobody sought medical attention."],
[&"", &"три пакета молока с истёкшим сроком. Их убрали с выдачи до обеда."]: [&"three cartons of expired milk in the school canteen. They were removed from service before lunch."],
[&"", &"Ведомство получило удобную чистую страницу. Три просроченных пакета остались в акте, и читатели видят скрытое вами нарушение."]: [&"The department received a conveniently spotless page. The three expired cartons remain in the report, and readers see the violation you concealed."],
[&"", &"Школьное меню без единого пятна: инспекция не нашла нарушений"]: [&"Not a stain on the school menu: inspection finds no violations"],
[&"", &"Молоко убрали до обеда, обращений к медикам не было. Выдуманное массовое отравление разрушает доверие и вызывает возмущение властей."]: [&"The milk was removed before lunch, and nobody sought medical help. The invented mass poisoning destroys trust and outrages the authorities."],
[&"", &"Вместо обеда: больница: государственные школы массово травят детей!"]: [&"Hospital instead of lunch: state schools poisoning children en masse!"],
[&"", &"Вы назвали и настоящее нарушение, и своевременное изъятие. Родители доверяют точности, школьному ведомству неприятна огласка просрочки."]: [&"You reported both the real violation and the timely removal. Parents trust the precision; the education authorities dislike publicity about expired stock."],
[&"", &"Три пакета до обеда не дожили: в школьной столовой убрали просроченное молоко"]: [&"Three cartons fail to reach lunchtime: expired milk removed from school canteen"],
[&"", &"Инспектор Коггс нашёл в школьной столовой три пакета молока с истёкшим сроком. Их убрали с выдачи до обеда. Остальные продукты проверку прошли, за медицинской помощью никто не обращался. Велено исправить учёт: старую партию забыли за новой.\n\nПовариха мадам Трюфф попросила вписать все три пакета, не «некоторое количество»: «Мне перед родителями стоять. Пусть знают точно». Заведующая предлагала устное замечание. Коггс ответил, что устное молоко на складе не хранится.\n\nОбед начали вовремя. На вопрос о жалобах ученик назвал изюм в запеканке. Это не нарушение. Он попросил проверить ещё раз. Трюфф подписала акт и пошла перебирать коробки."]: [&"Inspector Koggs found three cartons of expired milk in the school canteen. They were removed from service before lunch. All other food passed inspection, and nobody sought medical attention. Stock records must be corrected: an old batch had been forgotten behind a new one.\n\nThe cook, Madame Truff, asked that all three cartons be listed, not \"a quantity\": \"I have to face the parents. Let them know exactly.\" The manager suggested a verbal warning. Koggs replied that verbal milk is not kept in the storeroom.\n\nLunch started on time. Asked about complaints, a pupil mentioned the raisins in the pudding. That is not a violation. He asked for a second inspection. Truff signed the report and went to sort through the boxes."],
[&"", &"Акт инспектора · школьная столовая"]: [&"Inspector\'s findings · school canteen"],
[&"", &"Заявления о краже не поступало. Велосипед цел, задержанных нет."]: [&"No theft has been reported. The bicycle is intact and nobody has been arrested."],
[&"", &"он оставил велосипед у другого входа и совершенно забыл об этом"]: [&"he had left his bicycle by another entrance and completely forgotten about it"],
[&"", &"Полиции досталась слава за преступников, которых не задерживали. Вернувшийся забывчивый хозяин не подтверждает вашу героическую историю."]: [&"The police received glory for criminals they never arrested. A forgetful owner coming back does not support your heroic tale."],
[&"", &"Ни одного угонщика на свободе: полиция разгромила крупнейшую сеть"]: [&"Not a bicycle thief left free: police smash biggest crime network"],
[&"", &"Выдуманная банда распугала пассажиров. В рапорте не было даже кражи; читатели разочарованы, полиция недовольна ложной угрозой."]: [&"The invented gang scared passengers away. The report did not even contain a theft; readers are disappointed, and the police resent the false threat."],
[&"", &"Педали в лапы и бежать: вокзал захватила банда велосипедных воров!"]: [&"Grab your pedals and run: gang of bicycle thieves takes over station!"],
[&"", &"Маленькая помощь осталась маленькой помощью. Читатели ценят честную заметку, полиции приятно заслуженное упоминание возвращённого велосипеда."]: [&"A little help remained a little help. Readers appreciate an honest item; the police enjoy deserved credit for returning the bicycle."],
[&"", &"Велосипед нашёлся, память пока нет: патрульный помог господину Бискеру"]: [&"Bicycle found, memory still missing: constable helps Mr Bisker"],
[&"", &"У вокзала найден велосипед без владельца. Патрульный Мурч подождал, отвёл к будке. Через час барсук Бискер спросил, не находили ли вокзал поменьше. Выяснилось: он оставил велосипед у другого входа и совершенно забыл об этом.\n\nЗаявления о краже не поступало. Велосипед цел, задержанных нет. В корзине правая варежка. Бискер радовался ей больше колёс: давно собирает пару. Объяснение вышло длиннее рапорта.\n\nМурч поправил седло, предложил ленту на руль. «На тележке уже есть, всё равно теряю». Бискер пошёл с велосипедом, вернулся спросить дорогу домой. Мурч приписал: «Обстановка спокойная. Гражданам желательно выспаться»."]: [&"A bicycle without an owner was found outside the station. Constable Murch waited, then took it to his booth. An hour later, Bisker the badger asked whether anyone had found a smaller station. It turned out he had left his bicycle by another entrance and completely forgotten about it.\n\nNo theft has been reported. The bicycle is intact and nobody has been arrested. There is a right mitten in the basket. Bisker was happier about that than the wheels: he has been trying to make a pair for ages. The explanation ran longer than the report.\n\nMurch adjusted the saddle and offered a ribbon for the handlebars. \"Already got one on the trolley. Still lose it.\" Bisker left with the bicycle, then returned to ask the way home. Murch added: \"All quiet. Citizens are advised to get some sleep.\""],
[&"", &"Рапорт патрульного · велосипед господина Бискера"]: [&"Patrol report · Mr Bisker\'s bicycle"],
[&"", &"Выселением нам никто не угрожал"]: [&"Nobody has threatened to evict us"],
[&"", &"Её приняли, решения ещё нет."]: [&"It has been accepted; no decision has been made yet."],
[&"", &"пересматривать плату можно раз в год, а предыдущее повышение было два месяца назад"]: [&"rent may be reviewed once a year, and the previous increase was two months ago"],
[&"", &"Ведомству приятна готовая победа. Но жалобу только приняли, платить пока требуют по-новому, и читатели видят выдуманный результат."]: [&"The department appreciates a ready-made victory. But it has only accepted the complaint, the new rent is still being demanded, and readers see the invented outcome."],
[&"", &"Жилищный отдел вернул прежнюю аренду: справедливость восторжествовала"]: [&"Housing department restores old rent: justice prevails"],
[&"", &"Газета разошлась быстрее слуха о выселении, которого никто не объявлял. Читатели возмущены обманом, власти недовольны безосновательной паникой."]: [&"The paper sold faster than the rumour of an eviction nobody had announced. Readers are angry at the deception, and the authorities resent the groundless panic."],
[&"", &"Пакуйте чемоданы: завтра всех жильцов выбросят на улицу!"]: [&"Pack your bags: every tenant will be thrown out tomorrow!"],
[&"", &"Вопрос опирается на договор и два объявления, а не на придуманный приговор. Жильцы доверяют газете, жилищному отделу неприятно внимание к нерешённой жалобе."]: [&"The question rests on the contract and two notices, not an invented verdict. Residents trust the newspaper; the housing department dislikes attention to the unresolved complaint."],
[&"", &"Сколько годов в одном году? На Тихой оспаривают второе повышение аренды"]: [&"How many years in a year? Quiet Street disputes second rent increase"],
[&"", &"Хозяин повысил аренду на десять долларов, приколол бумажный цветок: «Спасибо за понимание». По договору пересматривать плату можно раз в год, а предыдущее повышение было два месяца назад. Копии договора и объявлений прилагаем.\n\nЛис Ренар говорит, год у него хозяйственный. Черепаха спросила, сколько таких годов в обычном. Он перестал здороваться. Отнесли жалобу в жилищный отдел. Её приняли, решения ещё нет. Выселением нам никто не угрожал; не пугайте детей.\n\nК двери привинтили кривой латунный звонок. На звон приходит весь этаж: никто не узнаёт, к кому. Наконец поговорили. Десять плюс десять слышно и глуховатым."]: [&"The landlord raised the rent by ten dollars and pinned up a paper flower: \"Thank you for understanding.\" Under the contract, rent may be reviewed once a year, and the previous increase was two months ago. Copies of the contract and notices are enclosed.\n\nRenard the fox says he means a financial year. A tortoise asked how many of those fit into an ordinary year. He stopped saying hello. We took a complaint to the housing department. It has been accepted; no decision has been made yet. Nobody has threatened to evict us; please do not frighten the children.\n\nA bent brass bell has been screwed to the door. When it rings, the entire floor comes out: nobody can tell who it is for. At last we got talking. Ten plus ten is loud enough even for the hard of hearing."],
[&"", &"Коллективное письмо · жильцы Тихой улицы"]: [&"Joint letter · residents of Quiet Street"],
[&"", &"Обвинение чиновников в поджоге ничем не подтверждено."]: [&"There is nothing to support the accusation that officials committed arson."],
[&"", &"В городском архиве сегодня принимали посетителей по обычному расписанию."]: [&"The city archive received visitors as usual today."],
[&"", &"Где снято и кто держал фотоаппарат, неизвестно."]: [&"Where it was taken and who held the camera are unknown."],
[&"", &"Власти приятен вывод о всеобщей честности. Читатели понимают, что работающий архив опровергает один слух, а не оправдывает каждого чиновника."]: [&"The authorities appreciate a declaration of universal honesty. Readers understand that an open archive disproves one rumour; it does not clear every official."],
[&"", &"Архив на месте: значит, кошачья власть безупречно честна"]: [&"Archive still standing: feline rulers must be perfectly honest"],
[&"", &"Открытый архив опровергает вашу историю, а фото не доказывает даже место пожара. Читатели теряют доверие, чиновники возмущены обвинением в уничтожении улик."]: [&"The open archive refutes your story, and the photograph does not even establish where a fire occurred. Readers lose trust, and officials are outraged at being accused of destroying evidence."],
[&"", &"Огонь спрячет всё: чиновники сожгли архив вместе с уликами!"]: [&"Fire hides everything: officials burn archive along with the evidence!"],
[&"", &"Журнал и работающий архив оказались убедительнее безымянного снимка. Читатели доверяют проверке, чиновники довольны опровержением обвинения в поджоге."]: [&"The log and the open archive proved more convincing than an anonymous photograph. Readers trust the check; officials are pleased the arson accusation was disproved."],
[&"", &"Архив «сгорел» только на листовке: Караппа по-прежнему выдаёт справки"]: [&"Archive \"burned down\" only on a leaflet: Karappa still issuing records"],
[&"", &"В телефонных будках листок: «АРХИВ СОЖГЛИ. ПРИКАЗ СВЕРХУ». Под ним расплывчатый снимок костра без даты. Где снято и кто держал фотоаппарат, неизвестно. Листок велит предупредить соседей «раньше, чем исчезнут и они».\n\nВ городском архиве сегодня принимали посетителей по обычному расписанию. В журнале краевед, наследницы, слесарь за планом отопления. Черепаха Караппа спросила, надо ли для опровержения тоже кого-нибудь приклеить к будке.\n\nНа столе сохнут квитанции из старого справочника. С фотографией костра установленной связи нет. Обвинение чиновников в поджоге ничем не подтверждено. Караппа просит перед следующим газетным пожаром позвонить: чай опять остыл."]: [&"A leaflet in the phone booths reads: \"ARCHIVE BURNED DOWN. ORDERS FROM ABOVE.\" Below it is a blurry, undated photo of a bonfire. Where it was taken and who held the camera are unknown. The leaflet orders readers to warn their neighbours \"before they disappear too\".\n\nThe city archive received visitors as usual today. The log lists a local historian, some heiresses, and a plumber looking for a heating plan. Karappa the tortoise asked whether someone would have to paste a person to a phone booth to get a correction seen too.\n\nReceipts from an old reference book are drying on the desk. No connection to the bonfire photo has been established. There is nothing to support the accusation that officials committed arson. Karappa asks us to phone before the next newspaper fire: her tea has gone cold again."],
[&"", &"Анонимный листок и журнал городского архива"]: [&"Anonymous leaflet and the city archive visitors\' log"],
[&"", &"Очень нужны помощники по уборке."]: [&"We badly need help with cleaning."],
[&"", &"Мэрия выделила питание на неделю. Остальное купили на частные пожертвования."]: [&"City Hall provided a week\'s food. The rest was bought with private donations."],
[&"", &"Девятерым нашли семьи, трое ещё ждут."]: [&"Nine have found families; three are still waiting."],
[&"", &"Мэрия получила благодарность за чужие пожертвования. Трое зверят всё ещё ждут семью, и читатели видят ложный счастливый конец."]: [&"City Hall received thanks for other people\'s donations. Three little animals still await a family, and readers see the false happy ending."],
[&"", &"Ни одного без семьи: мэрия полностью обеспечила городской приют"]: [&"Not one without a family: City Hall fully provides for city shelter"],
[&"", &"Выдуманная катастрофа принесла продажи. Читатели узнали о девяти новых семьях и отсутствии гибели, власти недовольны необоснованным страхом."]: [&"An invented catastrophe brought sales. Readers learned about the nine new families and the absence of deaths; the authorities resent the unfounded fear."],
[&"", &"Их бросили умирать: десятки зверят за дверями приюта!"]: [&"Abandoned to die: dozens of little animals behind shelter doors!"],
[&"", &"Тёплый заголовок сохранил число оставшихся и надежду на помощь. Читатели доверяют приюту; работу волонтёров вы не приписали государству."]: [&"The warm headline preserved both the number still waiting and the hope of help. Readers trust the shelter; you did not credit the state with the volunteers\' work."],
[&"", &"Девятерых уже ждут дома. Ещё трое в приюте ставят чайник для гостей"]: [&"Nine already have a home waiting. Three more put the kettle on for shelter visitors"],
[&"", &"Пишет Лапси. За месяц поступило двенадцать зверят. Девятерым нашли семьи, трое ещё ждут. Не пишите «никому не нужны»: заяц читает по слогам и спросил, можно ли стать нужным, если хорошо мыть пол.\n\nМэрия выделила питание на неделю. Остальное купили на частные пожертвования. Спасибо за продукты, одеяла и деньги. Бискера просим больше не привозить двадцать одинаковых левых варежек. Знаем, они дешёвые.\n\nОчень нужны помощники по уборке. В субботу моем окна и красим полку-корабль. Трое готовят гостям чай: считают чашки и друг друга. Уходя, скажите, когда вернётесь. Здесь обещанный четверг отмечают в календаре и ждут всерьёз."]: [&"Lapsi here. Twelve little animals arrived this month. Nine have found families; three are still waiting. Do not write \"nobody wants them\": the little hare reads one syllable at a time and asked whether he could become wanted if he mopped the floor well.\n\nCity Hall provided a week\'s food. The rest was bought with private donations. Thank you for the food, blankets and money. We ask Bisker to stop bringing twenty identical left mittens. We know they are cheap.\n\nWe badly need help with cleaning. On Saturday we are washing the windows and painting the ship-shaped shelf. The three are making tea for visitors: counting the cups and each other. When you leave, say when you will be back. Here, a promised Thursday gets marked on the calendar, and they really do wait."],
[&"", &"Письмо волонтёрки Лапси · приют на Ольховой"]: [&"Letter from volunteer Lapsi · the shelter on Alder Street"],
[&"", &"Договор действует, подрядчик продолжает ремонт."]: [&"The contract remains in force and the contractor is continuing repairs."],
[&"", &"Если подрядчик сорвёт сроки, мы расторгнем договор. Пока работы идут по графику"]: [&"If the contractor misses the deadline, we will terminate the contract. For now, work is on schedule"],
[&"", &"Мэру приятна решительность в газете. В записи нет ни досрочного открытия, ни всех мостов, поэтому доверие читателей снижается."]: [&"The mayor appreciates looking decisive in print. The recording mentions neither early opening nor every bridge, so readers\' trust falls."],
[&"", &"Все мосты откроют досрочно: железная гарантия мэра"]: [&"Every bridge to open early: mayor\'s ironclad guarantee"],
[&"", &"Слово «если» потерялось, и предупреждение стало ложной новостью. Читатели видят продолжающийся ремонт, мэрия недовольна искажённой цитатой."]: [&"The word \"if\" disappeared, turning a warning into false news. Readers see repairs continuing, and City Hall resents the distorted quotation."],
[&"", &"Мост не сойдётся: мэр уже разорвал договор с подрядчиком!"]: [&"Bridge falls apart: mayor has already torn up contractor\'s deal!"],
[&"", &"Условие сохранилось, ремонт не объявлен сорванным. Читатели верят точной цитате, мэрии приятно сообщение о контроле за работами."]: [&"The condition survived, and you did not announce that repairs had failed. Readers trust the accurate quotation; City Hall appreciates the report that work is being monitored."],
[&"", &"Мост пока по графику: мэр пригрозил разрывом договора в случае срыва"]: [&"Bridge on schedule for now: mayor warns contract could end if deadline is missed"],
[&"", &"Мэр приехал к мосту в новых сапогах, уехал с одним чистым. Подрядчик бобр говорил: «Сюда не ступайте». Мэр кивал и ступал. Интервью записали на берегу, пока помощник оттирал сапог афишей.\n\nПолная фраза мэра: «Если подрядчик сорвёт сроки, мы расторгнем договор. Пока работы идут по графику». Речь об одном мосте. Договор действует, подрядчик продолжает ремонт. Досрочного открытия этого или остальных мостов мэр не обещал.\n\nСлово «если» попало на сгиб листа. Машинистка обвела: «Не потерять при наборе». Подрядчик просил оставить «пока», помощник убрать сапог, мэр увеличить портрет. Портрета нет: фотограф спасал от воды чехол."]: [&"The mayor arrived at the bridge in new boots and left with one clean one. The beaver contractor said, \"Do not step there.\" The mayor nodded and stepped. The interview was recorded on the bank while an aide scrubbed the boot with a poster.\n\nThe mayor\'s full statement: \"If the contractor misses the deadline, we will terminate the contract. For now, work is on schedule.\" He was talking about one bridge. The contract remains in force and the contractor is continuing repairs. The mayor did not promise to open this bridge or any other bridge early.\n\nThe word \"if\" landed on a fold in the paper. The typist circled it: \"Do not lose this when typesetting.\" The contractor asked us to keep \"for now\", the aide to remove the boot, and the mayor to enlarge his portrait. There is no portrait: the photographer was rescuing the camera case from the water."],
[&"", &"Расшифровка интервью мэра · слово на сгибе"]: [&"Transcript of mayor\'s interview · a word on the fold"],
[&"", &"Сегодня аварий не зарегистрировано."]: [&"No accidents have been recorded today."],
[&"", &"к сегодняшним рейсам снимок отношения не имеет"]: [&"the photo has nothing to do with today\'s services"],
[&"", &"архивный штамп с датой трёхлетней давности"]: [&"an archive stamp dated three years ago"],
[&"", &"Депо приятно получить три года безупречности. Источник подтверждал только сегодняшний день, и читатели замечают лишние обещания газеты."]: [&"The depot appreciates being handed three flawless years. The source confirmed only today, and readers notice the newspaper\'s extra claims."],
[&"", &"Три года без аварий: безупречная работа городского депо"]: [&"Three years without an accident: city depot\'s flawless record"],
[&"", &"Выдуманы и дата, и школьный рейс, и жертвы. Продажи выросли ценой тяжёлого обмана; депо и власти возмущены обвинением в сокрытии гибели детей."]: [&"The date, the school service and the casualties are all invented. Sales rose at the cost of a grave deception; the depot and authorities are outraged at being accused of hiding children\'s deaths."],
[&"", &"Школьный автобус разбился сегодня. Власти прячут имена погибших!"]: [&"School bus crashes today. Authorities hide names of the dead!"],
[&"", &"Проверка оборота фотографии остановила ложную тревогу. Читатели доверяют разоблачению, депо и власти довольны опровержением слуха."]: [&"Checking the back of the photograph stopped a false alarm. Readers trust the debunking; the depot and authorities are pleased the rumour was disproved."],
[&"", &"«Сегодня» трёхлетней давности: разбитый автобус оказался учебным"]: [&"Three-year-old \"today\": wrecked bus turns out to be a training vehicle"],
[&"", &"В конверте лежала фотография разбитого автобуса с полоской «СЕГОДНЯ. ПЕЧАТАЙТЕ, ПОКА НЕ ЗАПРЕТИЛИ». Кабина помята, окна выбиты. На обороте: архивный штамп с датой трёхлетней давности. Приклеивая полоску, оборот забыли.\n\nДиспетчер пёс Барк узнал старую учебную машину: к сегодняшним рейсам снимок отношения не имеет. Сегодня аварий не зарегистрировано. За предыдущие три года Барк по одному звонку ручаться не взялся.\n\n«Помню вмятину. Молодой был, думал: получу фуражку, и всё получится». Он попросил прислать снимок после проверки: сзади виден покойный напарник. Полоску «сегодня» просит отклеить. Для него эта фотография очень давно."]: [&"The envelope contained a photograph of a wrecked bus, with a strip reading \"TODAY. PRINT BEFORE THEY BAN IT\". The cab is dented, the windows shattered. On the back: an archive stamp dated three years ago. Whoever glued on the strip forgot the other side.\n\nBark the dog, a dispatcher, recognised an old training bus: the photo has nothing to do with today\'s services. No accidents have been recorded today. Bark would not vouch for the previous three years on the strength of one phone call.\n\n\"I remember that dent. I was young. Thought once I had the uniform cap, everything would fall into place.\" He asked us to send him the picture after checking it: his late colleague is visible in the background. Please peel off the strip saying \"today\". For him, this photograph was a very long time ago."],
[&"", &"Конверт без адреса · снимок разбитого автобуса"]: [&"Unaddressed envelope · photograph of a wrecked bus"],
[&"", &"Уличную ярмарку переносим на воскресенье."]: [&"The outdoor fair is postponed until Sunday."],
[&"", &"Начало в 19:00, билеты действительны."]: [&"It starts at 19:00; tickets remain valid."],
[&"", &"сегодняшний концерт состоится в городском клубе вместо открытой площади"]: [&"today\'s concert will take place at the city club instead of the open square"],
[&"", &"Власть получила красивую победу над погодой. Читатели, промокшие у прежней площадки, обнаружили скрытые вами изменения."]: [&"The authorities received a fine victory over the weather. Readers getting soaked at the old venue discovered the changes you concealed."],
[&"", &"Кошачья власть победила дождь: фестиваль без единого изменения!"]: [&"Feline rulers defeat rain: festival goes ahead without a single change!"],
[&"", &"Часть читателей осталась дома, хотя концерт шёл. Обман стоил доверия и ухудшил отношение городских служб к газете."]: [&"Some readers stayed home while the concert went ahead. The deception cost trust and worsened city services\' opinion of the newspaper."],
[&"", &"Занавес! Горожан лишили главного концерта года"]: [&"Curtain down! Citizens robbed of the year\'s biggest concert"],
[&"", &"Публика нашла новую площадку и не перепутала концерт с ярмаркой. Читатели доверяют объявлению, городу приятно, что праздник состоится."]: [&"The audience found the new venue and did not confuse the concert with the fair. Readers trust the announcement; the city is pleased the celebration will go ahead."],
[&"", &"Павлина спасают от дождя: концерт в 19:00 в городском клубе, ярмарка: в воскресенье"]: [&"Peacock sheltered from rain: concert at city club at 19:00, fair on Sunday"],
[&"", &"Дорогие зрители, сегодняшний концерт состоится в городском клубе вместо открытой площади. Начало в 19:00, билеты действительны. Уличную ярмарку переносим на воскресенье. Причина: дождь, а не разрыв барабанщика с певицей.\n\nПавлин Паво просит не гладить афиши: краска течёт, у портрета поплыли брови. Шляпа фокусника промокла. Из неё достали двух возмущённых мышей и половник воды. Мыши по договору, не отпускайте их на волю.\n\nЗонтики оставляйте у входа. Самый красивый зонт: дежурной. Кассету «Хвост FM» привезли, звук проверили. Приходите вовремя: заставку на репетиции слушали трижды, четвёртый публика не простит."]: [&"Dear audience, today\'s concert will take place at the city club instead of the open square. It starts at 19:00; tickets remain valid. The outdoor fair is postponed until Sunday. The reason is rain, not the drummer breaking up with the singer.\n\nPavo the peacock asks you not to stroke the posters: the ink is running, and his portrait\'s eyebrows have drifted. The magician\'s hat got wet. Two indignant mice and a ladleful of water were removed from it. The mice are under contract; do not set them free.\n\nLeave umbrellas at the entrance. The prettiest umbrella goes to the attendant. The Tail FM cassette has arrived and the sound has been checked. Please be on time: we heard the jingle three times at rehearsal; the audience will not forgive a fourth."],
[&"", &"Объявление конферансье · концерт под крышей"]: [&"Compere\'s announcement · a concert under cover"],
[&"", &"Названия остаются в каталоге, новые бумажные экземпляры и копии на микрофильме доступны."]: [&"The titles remain in the catalogue; replacement paper copies and microfilm copies are available."],
[&"", &"списываем двадцать книг, испорченных водой"]: [&"withdrawing twenty water-damaged books"],
[&"", &"Чиновники получили похвалу за целую библиотеку. Читатели нашли двадцать заменённых книг и тысячи старых: заголовку верят меньше."]: [&"Officials received praise for an entire library. Readers found twenty replacements and thousands of old books, and trust the headline less."],
[&"", &"Каждая полка как новая: город полностью обновил библиотечный фонд"]: [&"Every shelf like new: city replaces entire library collection"],
[&"", &"У намокших книг появился выдуманный политический смысл. Читатели видят доступные экземпляры, власти недовольны бездоказательным обвинением в цензуре."]: [&"Wet books acquired an invented political meaning. Readers see copies still available, and the authorities resent the unsupported accusation of censorship."],
[&"", &"Вода смоет не всё: библиотека уничтожает неугодных авторов!"]: [&"Water cannot wash it all away: library destroys inconvenient authors!"],
[&"", &"Читатели знают, почему списывают книги и где взять замену. Доверие растёт, властям приятно сообщение о сохранённом доступе к фонду."]: [&"Readers know why the books are being withdrawn and where to find replacements. Trust grows; the authorities appreciate the report that access to the collection is preserved."],
[&"", &"Книги промокли, авторы остались: библиотека заменяет двадцать томов"]: [&"Books soaked, authors intact: library replaces twenty volumes"],
[&"", &"Уважаемые читатели! У окна уже спрашивают, кого запретим следующим. На этой неделе списываем двадцать книг, испорченных водой. Том о лёгкой походке разбух так, что одному не поднять.\n\nЗапрещённых авторов нам никто не присылал. Названия остаются в каталоге, новые бумажные экземпляры и копии на микрофильме доступны. Зал работает как прежде. «Изъять» на коробке относится к мокрым экземплярам, не к мыслям.\n\nБобр Плотт сушил справочник под прессом: вода приняла форму справочника. Больше опытов не будет. Не забирайте книги из коробки: пособие по консервированию вчера вернули в банке. След чашки на странице сорок второй тоже не цензура, я сам пролил чай."]: [&"Dear readers! People at the desk are already asking who we will ban next. This week we are withdrawing twenty water-damaged books. The volume on walking lightly has swollen so much that one person cannot lift it.\n\nNobody has sent us a list of banned authors. The titles remain in the catalogue; replacement paper copies and microfilm copies are available. The reading room is open as usual. \"Withdraw\" on the box refers to wet copies, not ideas.\n\nPlott the beaver dried a reference book under a press: the water took the shape of the book. There will be no further experiments. Please do not take books from the box: yesterday someone returned the guide to preserving food in a jar. The cup ring on page forty-two is not censorship either. I spilled my tea."],
[&"", &"Письмо библиотекаря · двадцать мокрых книг"]: [&"Letter from the librarian · twenty wet books"],
[&"", &"Во вторник пройдут публичные слушания"]: [&"A public hearing will be held on Tuesday"],
[&"", &"Постановление не принято."]: [&"The measure has not been adopted."],
[&"", &"предложение закрывать грузовой двор после 23:00"]: [&"A proposal to close the freight yard after 23:00"],
[&"", &"Совету приятно единодушие на бумаге. Жители ещё не пришли на слушания, поэтому быстро понимают, что их одобрение вы сочинили."]: [&"The council appreciates unanimity on paper. Residents have not even attended the hearing yet, so they soon realise you invented their approval."],
[&"", &"Бриполис единогласно поддержал ночной порядок городского совета"]: [&"Bripolis unanimously supports council\'s night-time order"],
[&"", &"Обсуждение режима одного двора стало выдуманным запретом для города. Читатели напуганы и разочарованы, совет возмущён ложным объявлением."]: [&"A discussion about one yard\'s opening hours became an invented city-wide ban. Readers are frightened and disappointed, and the council is outraged by the false announcement."],
[&"", &"После одиннадцати из дома ни лапой: в Бриполисе введён комендантский час!"]: [&"Not a paw outside after eleven: Bripolis under curfew!"],
[&"", &"Жители узнали, что и когда обсуждают. Вы не превратили проект в закон и не оценивали совет вместо сообщения о слушаниях."]: [&"Residents learned what is being discussed and when. You did not turn a draft into law or replace a hearing notice with a judgement on the council."],
[&"", &"Кому мешают мешки? Во вторник обсудят ночное закрытие грузового двора"]: [&"Who has had enough of sacks? Tuesday hearing on closing freight yard at night"],
[&"", &"На доске совета висит предложение закрывать грузовой двор после 23:00. Кот-секретарь трижды поставил «ПРОЕКТ». Под листом приписали: «А спать тоже по проекту?»\n\nСоседи жалуются на ночную разгрузку. Жирафа Лонга каждый мешок слышит раньше, чем видит. Грузчик с синей лентой на тележке предложил обмотать колёса тряпками. Это записали как замечание, хотя он просто просил тряпки.\n\nПостановление не принято. Улиц и жилых районов ограничение не касается. Во вторник пройдут публичные слушания, жители могут оставить замечания. Пока двор работает как прежде. Не обрывайте низ листа на растопку: именно там написано, что это ещё обсуждение."]: [&"A proposal to close the freight yard after 23:00 is posted on the council board. The cat acting as secretary stamped \"DRAFT\" on it three times. Someone added underneath: \"Is sleep still in draft too?\"\n\nNeighbours complain about night-time unloading. Longa the giraffe hears every sack before she sees it. The loader with the blue ribbon on his trolley suggested wrapping the wheels in rags. This was recorded as a comment, though he was just asking for rags.\n\nThe measure has not been adopted. The restriction does not apply to streets or residential areas. A public hearing will be held on Tuesday, and residents may submit comments. For now, the yard operates as before. Do not tear off the bottom of the notice for kindling: that is where it says this is still being discussed."],
[&"", &"Проект для слушаний · грузовой двор"]: [&"Draft for public hearing · the freight yard"],
[&"", &"К материалу приложен чек только из этой лавки."]: [&"The only receipt attached to this report is from this shop."],
[&"", &"Обычный сыр по-прежнему продают за шесть."]: [&"Ordinary cheese still sells for six."],
[&"", &"По его словам, из-за смены поставщика кусок теперь стоит двенадцать долларов вместо десяти."]: [&"According to him, a change of supplier means a piece now costs twelve dollars instead of ten."],
[&"", &"Чиновникам приятна похвала, которой они не заработали. Новый ценник на выдержанном сыре сразу выдаёт ложь о всеобщей стабильности."]: [&"Officials appreciate praise they have not earned. The new price on the mature cheese immediately exposes the lie about universal stability."],
[&"", &"Сырная стабильность: государство удержало все цены"]: [&"Cheese stability: state holds every price steady"],
[&"", &"Двенадцать вместо десяти: не вдвое, и чек всего один. Читатели замечают обман, власти недовольны необоснованной ценовой тревогой."]: [&"Twelve instead of ten is not double, and there is only one receipt. Readers spot the deception, and the authorities resent the unfounded price scare."],
[&"", &"Держитесь за кошельки: за ночь весь сыр Бриполиса подорожал вдвое!"]: [&"Clutch your wallets: all cheese in Bripolis doubles in price overnight!"],
[&"", &"Шутка не изменила цену и не распространила её на другие лавки. Читатели доверяют чеку; частная покупка не оценивает государство."]: [&"The joke changed neither the price nor its scope beyond this shop. Readers trust the receipt; a private purchase passes no judgement on the state."],
[&"", &"Сыр стал старше на два доллара: новая цена в лавке «Корочка»"]: [&"Cheese matures by two dollars: a new price at The Rind"],
[&"", &"Люсиль купила выдержанный сыр и вернулась: «За десять долларов он был выдержанным. За двенадцать получил образование?» Продавец показал новую накладную. По его словам, из-за смены поставщика кусок теперь стоит двенадцать долларов вместо десяти.\n\nОбычный сыр по-прежнему продают за шесть. Люсиль выбрала его: «Пусть учится заочно». Покупку завернули в объявление о ремонте северных ворот. На бумагу скидка есть, на возраст сыра: нет.\n\nК материалу приложен чек только из этой лавки. Другие цены не сверяли, о вмешательстве государства продавец не говорил. Фамилию просит скрыть: вчера зять подарил ей дорогой сыр, сегодня у него ужин."]: [&"Lucille bought some mature cheese and came back: \"At ten dollars it was mature. At twelve, has it graduated?\" The shopkeeper showed her a new invoice. According to him, a change of supplier means a piece now costs twelve dollars instead of ten.\n\nOrdinary cheese still sells for six. Lucille chose that: \"It can study by correspondence.\" Her purchase was wrapped in a notice about repairs to the north gate. The paper comes at a discount; the age of the cheese does not.\n\nThe only receipt attached to this report is from this shop. No other prices were checked, and the shopkeeper said nothing about state intervention. She asks us to withhold her surname: yesterday her son-in-law gave her expensive cheese, and tonight she is dining at his place."],
[&"", &"Чек из лавки «Корочка» · спор у прилавка"]: [&"Receipt from The Rind shop · an argument at the counter"],
[&"", &"велел освободить один запасной выход"]: [&"ordered one emergency exit cleared"],
[&"", &"Пожара не было."]: [&"There was no fire."],
[&"", &"плановую учебную эвакуацию"]: [&"a scheduled evacuation drill"],
[&"", &"Инспекции досталась безусловная похвала. Читатели узнали о коробках у запасного выхода и заметили исчезнувшее из газеты замечание."]: [&"The inspectors received unqualified praise. Readers learned about the boxes blocking the emergency exit and noticed the criticism missing from your paper."],
[&"", &"Почта прошла проверку с блеском: все выходы образцовые"]: [&"Post office passes inspection with flying colours: every exit exemplary"],
[&"", &"Время эвакуации выдали за длительность пожара. Читатели зря переживали за почту, инспекция недовольна выдуманной тревогой."]: [&"You presented the evacuation time as the duration of a fire. Readers worried about their post for nothing, and the inspectors resent the invented alarm."],
[&"", &"Четыре минуты в огне! Что осталось от ваших писем?"]: [&"Four minutes in flames! What is left of your letters?"],
[&"", &"Учение осталось учением. Читатели не испугались за письма, инспекции приятно точное сообщение о проверке безопасности."]: [&"A drill stayed a drill. Readers did not fear for their letters, and the inspectors appreciate an accurate account of the safety check."],
[&"", &"За четыре минуты: наружу: почта потренировалась выходить без очереди"]: [&"Out in four minutes: post office practises leaving without a queue"],
[&"", &"Вчера на почте провели плановую учебную эвакуацию. Все вышли за четыре минуты. Пожара не было. Почтальон голубь накрыл дымовую машину сумкой: «Техника кашляет, а вы стоите». Пришлось запускать заново.\n\nИнспектор Коггс похвалил спокойствие, но велел освободить один запасной выход: перед ним коробки новогодних открыток. Начальница пояснила, что это на следующий год. Коггс записал: «Следующий год не должен мешать эвакуации».\n\nКривой латунный звонок на столе посылок звякал сам: приделали пружину от степлера. Его попросили убрать от сигнализации. Клиенты впервые сами шли к свободному окну. Письма и посылки не горели, работа продолжилась."]: [&"The post office held a scheduled evacuation drill yesterday. Everyone was out in four minutes. There was no fire. A pigeon postman covered the smoke machine with his bag: \"The machine is coughing and you are just standing there.\" They had to start again.\n\nInspector Koggs praised everyone\'s calm, but ordered one emergency exit cleared: boxes of New Year cards stood in front of it. The manager explained they were for next year. Koggs wrote: \"Next year must not obstruct an evacuation.\"\n\nThe bent brass bell on the parcel counter rang by itself: someone had fitted a stapler spring. They were asked to move it away from the alarm. For once, customers found an empty counter without being told. No letters or parcels burned; work resumed."],
[&"", &"Рапорт инспектора Коггса · почтовые учения"]: [&"Inspector Koggs\'s report · post office drill"],
[&"", &"Эвакуации не было, никто не пострадал, крыша не обрушалась."]: [&"There was no evacuation, nobody was hurt, and the roof has not collapsed."],
[&"", &"Сейчас дети учатся в другом крыле здания."]: [&"The children are currently studying in another wing of the building."],
[&"", &"протечку подтвердили и обещали ремонт в пятницу"]: [&"they confirmed the leak and promised repairs on Friday"],
[&"", &"Ведомство получило удобный отчёт. Фотография вёдер и подтверждённая протечка показывают читателям, какую проблему вы спрятали."]: [&"The department received a convenient report. The photograph of the buckets and the confirmed leak show readers the problem you concealed."],
[&"", &"Сухо, тепло, образцово: городские школы под надёжной защитой"]: [&"Dry, warm, exemplary: city schools in safe hands"],
[&"", &"Родители бросились за детьми из-за выдуманного обрушения. Ни обломков, ни пострадавших нет; доверие рушится, ведомство возмущено ложным обвинением."]: [&"Parents rushed to collect their children because of an invented collapse. There is no rubble and nobody is hurt; trust crumbles, and the department is outraged by the false accusation."],
[&"", &"Крыша рухнула, чиновники отвернулись: детей бросили под обломками!"]: [&"Roof collapses, officials look away: children abandoned under the rubble!"],
[&"", &"Родители видят свою настоящую проблему и полученный ответ. Доверие растёт, отделу образования неприятно, что о недельной протечке узнал весь город."]: [&"Parents see their actual problem and the reply they received. Trust grows; the education department dislikes the whole city hearing about a week-long leak."],
[&"", &"Ведро по имени Директор: после жалобы школе № 2 обещали починить крышу"]: [&"A bucket called Headmaster: School No. 2 promised roof repairs after complaint"],
[&"", &"Дорогая редакция, сын принёс сочинение «Как я провёл перемену»: три строчки и мокрый след лапы. В школе № 2 неделю текла крыша. Подставили ведро, потом два. Учительница утка объяснила круговорот воды прямо у доски. Сын говорит, лучший урок за четверть.\n\nМы направили жалобу в отдел образования: протечку подтвердили и обещали ремонт в пятницу. Сейчас дети учатся в другом крыле здания. Эвакуации не было, никто не пострадал, крыша не обрушалась. Нужен ремонт, а не слухи, из-за которых бабушки отменят занятия.\n\nПрилагаем ответ ведомства и снимок вёдер. Дети дали им имена. Большое зовут Директором и уже спрашивают у него разрешения выйти."]: [&"Dear Editor, my son brought home an essay called \"How I Spent My Break\": three lines and a wet pawprint. The roof at School No. 2 has been leaking for a week. They put out a bucket, then two. His teacher, a duck, explained the water cycle right there at the blackboard. My son says it was the best lesson of the term.\n\nWe complained to the education department: they confirmed the leak and promised repairs on Friday. The children are currently studying in another wing of the building. There was no evacuation, nobody was hurt, and the roof has not collapsed. We need repairs, not rumours that make grandmothers cancel lessons.\n\nWe enclose the department\'s reply and a photo of the buckets. The children have named them. The big one is called Headmaster, and they are already asking it for permission to leave."],
[&"", &"Письмо родительского комитета · школа № 2"]: [&"Letter from the parents\' committee · School No. 2"],
[&"", &"Школьников продолжают пускать бесплатно."]: [&"Schoolchildren still get in free."],
[&"", &"Новая цена действует со следующего месяца."]: [&"The new price takes effect next month."],
[&"", &"Взрослый билет подорожает на два доллара, чтобы оплатить ремонт крыши"]: [&"Adult tickets will go up by two dollars to pay for roof repairs"],
[&"", &"Мэрии приятна щедрость за чужой счёт. У музейной кассы взрослые узнают цену вашим обещаниям: бесплатности для всех никто не объявлял."]: [&"City Hall appreciates generosity at someone else\'s expense. At the museum ticket desk, adults discover what your promises cost: nobody announced free entry for everyone."],
[&"", &"Мэрия открыла двери в историю: музей навсегда бесплатен для всех"]: [&"City Hall opens the doors to history: museum free for everyone, forever"],
[&"", &"Одно пропавшее «не» перевернуло ответ директора. Родители возмутились обманом, власти сочли газету ненадёжной."]: [&"One missing \"not\" reversed the director\'s answer. Parents were angry at the deception, and the authorities judged the paper unreliable."],
[&"", &"За знания придётся платить: музей выставил счёт школьникам!"]: [&"Knowledge comes at a price: museum sends schoolchildren the bill!"],
[&"", &"Обе части ответа дошли до читателей. Семьи могут посчитать расходы; заслуг или провалов мэрии вы не выдумали."]: [&"Both parts of the answer reached the readers. Families can work out the cost; you invented neither achievements nor failures for City Hall."],
[&"", &"Школьники: бесплатно, взрослые: плюс два доллара на музейную крышу"]: [&"Schoolchildren: free. Adults: two dollars more towards the museum roof"],
[&"", &"Филин Оулден принимал корреспондента среди старинной мебели под зонтом. «Это не экспонат. Таз важнее стула, тоже не трогайте».\n\nО билетах директор сказал: «Мы не будем вводить платный вход для школьников. Взрослый билет подорожает на два доллара, чтобы оплатить ремонт крыши». Новая цена действует со следующего месяца. Кассирша просит написать крупно: мать троих детей уже предлагала расплатиться вареньем.\n\nШкольников продолжают пускать бесплатно. Бесплатного входа всем взрослым никто не обещал, решения мэрии нет. Капля громко упала в таз. Оулден сказал: «Голос главного спонсора» и попросил не вырезать слово «не»."]: [&"Owlden the eagle owl received the reporter among antique furniture, under an umbrella. \"This is not an exhibit. The basin matters more than the chair; do not touch that either.\"\n\nOn tickets, the director said: \"We will not charge schoolchildren for admission. Adult tickets will go up by two dollars to pay for roof repairs.\" The new price takes effect next month. The cashier asks you to print it large: a mother of three has already offered to pay in jam.\n\nSchoolchildren still get in free. Nobody promised free entry to all adults, and City Hall has issued no decision. A drop landed loudly in the basin. Owlden said, \"The voice of our chief sponsor,\" and asked us not to cut the word \"not\"."],
[&"", &"Кассетная запись · директор музея под зонтом"]: [&"Cassette recording · museum director under an umbrella"],
[&"", &"Новую аллею откроют через месяц."]: [&"The new avenue opens in a month."],
[&"", &"Двадцать пять растут, пять не прижились; осенью заменим."]: [&"Twenty-five are growing, five failed to take; we will replace them in autumn."],
[&"", &"Мэрии приятна преждевременная ленточка в газете. Пять пустых лунок и месяц до открытия быстро подрывают доверие к заголовку."]: [&"City Hall enjoys its early ribbon-cutting in the newspaper. Five empty holes and a month until opening soon undermine trust in the headline."],
[&"", &"Аллея открыта, все тридцать зеленеют: мэрия сдержала слово!"]: [&"Avenue open, all thirty trees flourishing: City Hall keeps its word!"],
[&"", &"Пять погибших саженцев выдали за гибель парка. Читатели увидели остальные двадцать пять, администрация недовольна выдуманной катастрофой."]: [&"You presented five dead saplings as the death of the park. Readers saw the other twenty-five, and the administration resents the invented catastrophe."],
[&"", &"Последняя весна городского парка: деревья гибнут одно за другим!"]: [&"City park\'s last spring: trees dying one after another!"],
[&"", &"Вы рассказали о живых саженцах, не объявляя успеха всех тридцати. Читатели верят точной заметке, администрации приятно упоминание удачной части посадок."]: [&"You reported the living saplings without claiming all thirty were a success. Readers trust the precise report; the administration appreciates mention of the planting that worked."],
[&"", &"Двадцать третье пьёт по расписанию: в парке растут 25 новых деревьев"]: [&"No. 23 drinks on schedule: 25 new trees growing in the park"],
[&"", &"Пишет белка Фунта. Нет, я не закапываю казённые орехи под видом озеленения. Третий спрашивает, а вежливого ответа нет. За весну посадили тридцать деревьев. Двадцать пять растут, пять не прижились; осенью заменим. На полив дали дополнительную бригаду.\n\nНовую аллею откроют через месяц. Не ходите между саженцами: на свадебном снимке в яме оставили тёщу. Она выбралась и помогла подвязать рябину.\n\nЯ пронумеровала деревца. Теперь черепаха здоровается с двадцать третьим, спрашивает, пил ли он. Ему полезно, мне тоже. Только не печатайте, что прижились все тридцать: пять пустых лунок от газеты не зазеленеют."]: [&"Funta the squirrel writing. No, I am not burying publicly owned nuts and calling it landscaping. That is the third person to ask, and I have run out of polite answers. We planted thirty trees this spring. Twenty-five are growing, five failed to take; we will replace them in autumn. We have been given an extra watering crew.\n\nThe new avenue opens in a month. Please do not walk between the saplings: a wedding photo left someone\'s mother-in-law in a planting hole. She climbed out and helped stake a rowan.\n\nI numbered the little trees. Now a tortoise greets No. 23 and asks if it has had a drink. Good for the tree, good for me. Just do not print that all thirty took root: five empty holes will not turn green because of a newspaper."],
[&"", &"Письмо садовницы Фунты · городская аллея"]: [&"Letter from gardener Funta · the city avenue"],
[&"", &"Пробы из остальных кварталов соответствуют норме. Данных об отравлениях нет."]: [&"Samples from all other neighbourhoods meet the standard. There are no reports of poisoning."],
[&"", &"дождаться промывки к 18:00"]: [&"wait for the pipes to be flushed by 18:00"],
[&"", &"после ремонта трубы осадок есть в домах 12 и 14"]: [&"following pipe repairs, sediment is present at Nos. 12 and 14"],
[&"", &"Ведомству удобен заголовок без осадка. У жителей двух домов осадок остался и в чайниках, и от вашей газеты."]: [&"The department likes a headline with no sediment. Residents in two buildings still have a nasty residue, both in their kettles and from reading your paper."],
[&"", &"Чистая работа водоканала: никаких проблем с водой в Бриполисе"]: [&"Water utility makes a clean job of it: no water problems in Bripolis"],
[&"", &"Банка из одного дома стала обвинением в умышленном отравлении города. Доказательств нет; доверие резко падает, чиновники возмущены опасной выдумкой."]: [&"A jar from one building became an accusation of deliberately poisoning the city. There is no evidence; trust plummets, and officials are outraged by the dangerous invention."],
[&"", &"Не пейте ни капли: кошачья власть отравила весь Бриполис!"]: [&"Do not drink a drop: feline rulers have poisoned all of Bripolis!"],
[&"", &"Масштаб и срок проблемы сохранены, остальной город не напуган зря. Читатели доверяют заметке, водоканалу неприятна огласка осадка после ремонта."]: [&"You kept the problem\'s scale and deadline intact, sparing the rest of the city a needless scare. Readers trust the report; the water utility dislikes publicity about sediment after its repairs."],
[&"", &"Чай с ремонтом: дома 12 и 14 ждут промывки труб к шести вечера"]: [&"Tea with pipe works: Nos. 12 and 14 await flushing by six this evening"],
[&"", &"В лабораторию принесли банку из дома № 12 с надписью «Это уже не огурцы». Осадок будто ждёт начальства. Выдра Лютта проверила пробы: после ремонта трубы осадок есть в домах 12 и 14. Им рекомендуют дождаться промывки к 18:00.\n\nПробы из остальных кварталов соответствуют норме. Данных об отравлениях нет. «Весь город пьёт землю» в протокол не включили.\n\nУ дома соседки расставили чайники, дворник принёс воду из исправной колонки. Старая кошка потребовала записать: «Мне чай с заваркой нужен, а не с ремонтом». Водоканал просит возвращать банки хозяевам: одна крышка уже приглянулась лаборанту."]: [&"A jar from No. 12 arrived at the laboratory labelled \"These are not pickles any more\". The sediment looked as if it was waiting for management. Lyutta the otter tested the samples: following pipe repairs, sediment is present at Nos. 12 and 14. Residents there are advised to wait for the pipes to be flushed by 18:00.\n\nSamples from all other neighbourhoods meet the standard. There are no reports of poisoning. \"The whole city is drinking soil\" did not make it into the report.\n\nOutside the building, neighbours set out kettles and the caretaker brought water from a working standpipe. An elderly cat insisted they write this down: \"I want my tea with leaves, not pipe works.\" The utility asks that jars be returned to their owners: one lid has already caught the lab assistant\'s eye."],
[&"", &"Протокол водоканала · письмо с банкой осадка"]: [&"Water utility report · a letter with a jar of sediment"],
[&"", &"Всех я не спрашивал, только этих десятерых у входа."]: [&"I did not ask all of them, just those ten outside the door."],
[&"", &"Опросил десятерых покупателей. Восемь сказали, что булочки хорошие."]: [&"I asked ten customers. Eight said the buns were good."],
[&"", &"Мэрия получила аппетитную рекламу. Покупатели говорили о частных булочках, поэтому читатели видят придуманную заслугу властей."]: [&"City Hall received some appetising publicity. The customers were talking about privately sold buns, so readers see the credit you invented for the authorities."],
[&"", &"Городская программа питания: Бриполис мурчит от удовольствия"]: [&"City nutrition programme: Bripolis purrs with delight"],
[&"", &"Восемь ответов растянули на восемь тысяч жителей и добавили требование, которого не было. Читатели разочарованы, власти недовольны выдуманной волей города."]: [&"You stretched eight answers across eight thousand residents and added a demand nobody made. Readers are disappointed, and the authorities resent the invented will of the people."],
[&"", &"Бриполис перешёл на булочки: 80% жителей требуют новую диету!"]: [&"Bripolis switches to buns: 80% of residents demand a new diet!"],
[&"", &"Десять покупателей остались десятью покупателями. Читатели верят честному масштабу опроса; частная пекарня не затрагивает власть."]: [&"Ten customers remained ten customers. Readers trust an honestly reported sample; a private bakery says nothing about the authorities."],
[&"", &"Восемь довольных, двое ещё жуют глазами: опрос у новой пекарни"]: [&"Eight happy customers, two still feasting their eyes: a survey at the new bakery"],
[&"", &"Редактор велел узнать мнение города о пекарне. Я, хомяк Пончик, встал у её дверей. Опросил десятерых покупателей. Восемь сказали, что булочки хорошие. Двое не пробовали: один нёс жене, вторая ждала, пока остынет, и отвечала «горячо».\n\nОдин ответил с набитым ртом. Попросил повторить: он купил ещё булочку. Посчитал его один раз, проверил по шляпе. Покупатели приняли меня за сборщика денег, пришлось уйти.\n\nВ Бриполисе восемь тысяч жителей. Всех я не спрашивал, только этих десятерых у входа. Городскую программу питания никто не упоминал. Прилагаю чек на рабочую булочку, не смейтесь."]: [&"The editor told me to find out what the city thinks of the bakery. I, Ponchik the hamster, stood outside its doors. I asked ten customers. Eight said the buns were good. Two had not tried them: one was taking his home to his wife; the other was waiting for hers to cool and answered \"hot\".\n\nOne answered with his mouth full. I asked him to repeat himself: he bought another bun. I counted him once, checked by his hat. Customers mistook me for a money collector, so I had to leave.\n\nBripolis has eight thousand residents. I did not ask all of them, just those ten outside the door. Nobody mentioned a city nutrition programme. Receipt attached for one work-related bun. Do not laugh."],
[&"", &"Тетрадь стажёра · десять покупателей и одна пекарня"]: [&"Trainee\'s notebook · ten customers and one bakery"],
[&"", &"Деталь обещают завтра"]: [&"The part is promised tomorrow"],
[&"", &"Остальные маршруты идут по расписанию."]: [&"All other routes are running to schedule."],
[&"", &"Теперь ходим через двадцать минут вместо десяти."]: [&"We now run every twenty minutes instead of ten."],
[&"", &"Начальству приятно, что маршруты перечислили без жалоб. Пассажиры четвёртого замечают спрятанную задержку и меньше верят газете."]: [&"Management appreciates a list of routes with no complaints. No. 4 passengers notice the delay you concealed and trust the newspaper less."],
[&"", &"Транспортное управление держит город в движении: все маршруты работают"]: [&"Transport department keeps the city moving: all routes operating"],
[&"", &"По соседней улице прошёл трамвай и испортил сенсацию. Читатели увидели преувеличение, управление недовольно ложью о полной остановке."]: [&"A tram passed on the next street and spoiled the scoop. Readers saw the exaggeration, and the department resents the claim of a total shutdown."],
[&"", &"Рельсы есть, трамваев больше нет: транспорт Бриполиса встал!"]: [&"Rails but no trams: Bripolis transport grinds to a halt!"],
[&"", &"Пассажиры узнали настоящий интервал. Газете верят, транспортному управлению неприятно читать о поломке и редких рейсах."]: [&"Passengers learned the actual interval. Readers trust the newspaper; the transport department dislikes reading about the breakdown and reduced service."],
[&"", &"Четвёртый ходит раз в двадцать минут. Ссориться на остановке необязательно"]: [&"No. 4 runs every twenty minutes. Quarrelling at the stop is optional"],
[&"", &"Если успели поссориться и помириться, а четвёртого нет, часы исправны. Один вагон сломался. Теперь ходим через двадцать минут вместо десяти. Остальные маршруты идут по расписанию. Деталь обещают завтра; слесарь просил записать «обещают»: в прошлый раз привезли ручку от пианино.\n\nЁж Пик просит не стучать монеткой по кабине. Я вас вижу даже спиной: в отражении термоса. Выходите заранее.\n\nУ «Рыжих Пушистиков» ждали трое чёрных котов. После дождя один оказался рыжим. Кочегарка просит вернуть рукавицу, а Пик просит сесть на газету: сиденья моем, а вагонов стало на один меньше."]: [&"If you have had time to quarrel and make up and the No. 4 still has not arrived, your watch is fine. One tram has broken down. We now run every twenty minutes instead of ten. All other routes are running to schedule. The part is promised tomorrow; the mechanic asked me to write \"promised\": last time they brought a piano knob.\n\nPik the hedgehog asks you not to tap coins on his cab. I can see you with my back turned: in the reflection on my flask. Leave home early.\n\nThree black cats were waiting outside Ginger Fluffballs. After the rain, one turned out to be ginger. The boiler room wants its mitten back, and Pik asks you to sit on a newspaper: we do wash the seats, but we are a tram short now."],
[&"", &"Записка вагоновожатого Пика · трамвай № 4"]: [&"A note from driver Pik · tram No. 4"],
[&"", &"Ни о виновности казначея, ни о безупречности всей казны решения пока нет."]: [&"No ruling has yet found the treasurer guilty or the entire treasury beyond reproach."],
[&"", &"Суд запросил документы у подрядчика."]: [&"The court requested documents from the contractor."],
[&"", &"обвинение казначею не предъявлено"]: [&"the treasurer has not been charged"],
[&"", &"В мэрии вырезали заголовок для стенда. В суде такого решения не находят: разбирательство ещё не закончено. Читатели замечают преждевременное оправдание."]: [&"City Hall clipped the headline for its noticeboard. The court can find no such ruling: proceedings are still under way. Readers notice the premature acquittal."],
[&"", &"Ни пятнышка на казне: суд подтвердил честность городской власти"]: [&"Not a stain on the treasury: court confirms city government\'s honesty"],
[&"", &"Свидетеля объявили вором до приговора. Скандал обеспечил продажи и жалобы, читатели потеряли доверие, власти осудили голословное обвинение."]: [&"You branded a witness a thief before a verdict. The scandal brought sales and complaints, readers lost trust, and the authorities condemned the baseless accusation."],
[&"", &"Кот на мягком, город без денег: казначей украл весь бюджет!"]: [&"Cat sits pretty, city sits penniless: treasurer stole the entire budget!"],
[&"", &"Вы сохранили настоящий статус казначея и вопрос, который разбирает суд. Читатели доверяют репортажу; властям неприятно внимание к пропавшим бумагам."]: [&"You preserved the treasurer\'s actual status and the issue before the court. Readers trust the report; the authorities dislike the attention paid to missing paperwork."],
[&"", &"Казначей принёс подушку, подрядчик: отговорки. Суд ждёт квитанции"]: [&"Treasurer brings a cushion, contractor brings excuses. Court awaits receipts"],
[&"", &"Казначей кот Муржин прибыл с папками и подушечкой. Показания велели давать стоя. «Я же свидетель, а не экспонат!» Он прав: обвинение казначею не предъявлено. Исчезли квитанции по городской закупке, отчёт не сходится.\n\nСуд запросил документы у подрядчика. Представитель принёс список причин отсутствия оригиналов. Самая короткая заняла полстраницы. Судья подшил список и повторил запрос. Ни о виновности казначея, ни о безупречности всей казны решения пока нет. Следующее открытое заседание и решение назначены на будущую неделю.\n\nУ входа спорили, посадили ли Муржина. На скамью свидетелей: да. Больше никуда."]: [&"Murzhin the cat, city treasurer, arrived with folders and a cushion. He was told to give evidence standing up. \"I am a witness, not an exhibit!\" He is right: the treasurer has not been charged. Receipts for a city purchase have gone missing, and the accounts do not add up.\n\nThe court requested documents from the contractor. A representative brought a list of reasons why the originals were unavailable. The shortest took half a page. The judge filed the list and repeated the request. No ruling has yet found the treasurer guilty or the entire treasury beyond reproach. The next public hearing and a ruling are scheduled for next week.\n\nOutside, people argued over whether Murzhin had been put away. On the witness stand: yes. Anywhere else: no."],
[&"", &"Блокнот судебной машинистки · дело о квитанциях"]: [&"Court typist\'s notebook · the missing receipts case"],
[&"", &"Южные ворота открыты с 8 до 20 часов, все ряды работают как обычно."]: [&"The south gates are open from 08:00 to 20:00; all stalls are trading as usual."],
[&"", &"С понедельника по среду северный вход закрыт на ремонт."]: [&"The north entrance is closed for repairs from Monday to Wednesday."],
[&"", &"Чиновникам понравился подарок на бумаге. Торговцы увидели прежние прилавки: город оплатил ремонт одного входа, а вы пообещали все ряды."]: [&"Officials enjoyed their gift on paper. Traders found the same old counters: the city paid to repair one entrance, while you promised every stall."],
[&"", &"За три дня мэрия подарит городу совершенно новый сырный рынок"]: [&"City Hall to give the city an entirely new cheese market in just three days"],
[&"", &"Газету раскупили, но и сыр продавали весь день. Покупатели разочарованы, мэрия возмущена ложью о закрытом рынке."]: [&"The newspaper sold out, but cheese was on sale all day too. Customers are disappointed, and City Hall is outraged by the false claim that the market closed."],
[&"", &"Последний кусок ваш? Мэрия оставляет Бриполис без сыра!"]: [&"Is that your last slice? City Hall leaves Bripolis cheeseless!"],
[&"", &"Покупатели нашли открытые ворота и свой сыр. Полезному сообщению верят, администрации приятно, что ремонт не превратился в слух о закрытии рынка."]: [&"Customers found the open gates and their cheese. Readers trust useful information; the administration appreciates repairs being reported without rumours of a market closure."],
[&"", &"За сыром: с юга: северный вход рынка закрыт с понедельника по среду"]: [&"For cheese, head south: market\'s north entrance closed Monday to Wednesday"],
[&"", &"С понедельника по среду северный вход закрыт на ремонт. Южные ворота открыты с 8 до 20 часов, все ряды работают как обычно. Платит городской бюджет. Ремонтируют вход, рынок работает.\n\nПриписка сторожа барсука Клапа: господину в клетчатом объясняю: узкий проход не означает распродажу для худых. Вчера вас выносили вместе с дверью. Кривой латунный звонок лежит у меня в будке. Звоните, взяв его в лапы.\n\nГрузчикам объезжать с юга. Тележку с синей лентой заберите от северной калитки: я уже дважды объяснял вашей колбасе, что вход закрыт. Сыр никуда не уезжает."]: [&"The north entrance is closed for repairs from Monday to Wednesday. The south gates are open from 08:00 to 20:00; all stalls are trading as usual. The city budget is paying. The entrance is being repaired; the market is open.\n\nA note from Klap the badger, caretaker: to the gentleman in checks, a narrow entrance does not mean a sale for slim customers. Yesterday we had to carry you out with the door. The bent brass bell is in my hut. Pick it up in your paws to ring it.\n\nDelivery crews should come round from the south. Please collect the trolley with the blue ribbon from the north gate: I have already explained twice to your sausage that the entrance is closed. The cheese is staying put."],
[&"", &"Объявление на сырном рынке · приписка сторожа"]: [&"Cheese market notice · a note from the caretaker"],
[&"", &"В полицию не обращалась."]: [&"I have not contacted the police."],
[&"", &"Соседка уверяет, что кот ждёт жену с ночной смены"]: [&"My neighbour insists the cat is waiting for his wife to finish her night shift"],
[&"", &"Уже пятый вечер у нашей двери сидит чёрный кот."]: [&"For the fifth evening running, a black cat has been sitting outside our door."],
[&"", &"Полиции приятна благодарность за работу, о которой она впервые прочитала в газете. Жительница ещё даже не подавала заявление; читатели замечают выдумку."]: [&"The police appreciate being thanked for work they first heard about in the newspaper. The resident has not even filed a report; readers spot the invention."],
[&"", &"Спите спокойно, мадам Пух: полиция уже разобралась с котом"]: [&"Sleep soundly, Madame Pukh: police have already dealt with the cat"],
[&"", &"Покупатели оглядывались у мусорных баков, пока не заметили, что доказательств слежки нет. Доверие упало, власти недовольны придуманной угрозой."]: [&"Buyers kept looking over their shoulders at the bins, until they noticed there was no evidence of surveillance. Trust fell, and the authorities resent the invented threat."],
[&"", &"Он знает, когда вы выносите мусор: чёрный кот держит квартал в страхе!"]: [&"He knows when you take out the rubbish: black cat terrorises the neighbourhood!"],
[&"", &"Тревогу крольчихи услышали, но слежку за ней вы не подтвердили. Читатели ценят осторожность; частный вопрос не касается властей."]: [&"You heard the rabbit\'s concerns without claiming she was being watched. Readers appreciate your caution; this private matter does not involve the authorities."],
[&"", &"Мадам Пух просит выяснить, зачем чёрный кот сидит у подъезда"]: [&"Madame Pukh asks why a black cat keeps sitting outside her building"],
[&"", &"Уважаемая редакция! Пишет крольчиха Пух, звонок с морковкой. Уже пятый вечер у нашей двери сидит чёрный кот. Я выхожу: смотрит. Вынесла мусор чёрным ходом: он там! Соседка уверяет, что кот ждёт жену с ночной смены, а я привлекаю его шуршанием пакета. Но почему он знает, когда я выбрасываю очистки?\n\nНа его помятой кепке написано «Рыжие Пушистики». После блюдца воды остался чёрный ободок, будто мыли печную трубу. Соседка советует спросить, где он работает. В полицию не обращалась. Выясните: это опасность или мне опять извиняться перед незнакомым мужем?"]: [&"Dear Editor! Pukh the rabbit here, the doorbell with the carrot. For the fifth evening running, a black cat has been sitting outside our door. I step out: he watches. I took the rubbish out the back: there he was! My neighbour insists the cat is waiting for his wife to finish her night shift, and that my rustling bag attracts him. But how does he know when I throw out the peelings?\n\nHis battered cap says \"Ginger Fluffballs\". After I gave him a saucer of water, it had a black ring round it, as if someone had washed a chimney in it. My neighbour says I should ask where he works. I have not contacted the police. Please find out: am I in danger, or must I apologise to another stranger\'s husband?"],
[&"", &"Письмо мадам Пух · квартал Фонарей"]: [&"Letter from Madame Pukh · Lantern Quarter"],
[&"", &"Язык / Language"]: [&"Language / Язык"],
[&"", &"Меньше проверок — меньше тревоги перед работой.\nЕсли лояльность не ниже {threshold} в начале смены, восстанавливается до {amount} выносливости. Бонус начисляется один раз, при начале смены. Изменение лояльности в течение смены не отнимает и не добавляет силы."]: [&"Fewer inspections mean less to worry about before work.\nIf loyalty is at least {threshold} when a shift begins, recover up to {amount} stamina. This bonus applies once, at shift start. Loyalty changes during the shift do not add or remove stamina."],
[&"", &"В НАЧАЛЕ СМЕНЫ: +{amount} СИЛ"]: [&"SHIFT START: +{amount} STAMINA"],
[&"", &"СЛЕДУЮЩАЯ СМЕНА: +{amount} СИЛ"]: [&"NEXT SHIFT: +{amount} STAMINA"],
[&"", &"ПРИ {threshold}: +{amount} К СИЛАМ"]: [&"AT {threshold}: +{amount} STAMINA"],
[&"", &"Положительные отзывы читателей воодушевляют.\nПока репутация не ниже {threshold}, каждая публикация тратит на {amount} выносливости меньше."]: [&"Positive reader feedback keeps you going.\nWhile reputation is at least {threshold}, each publication costs {amount} less stamina."],
[&"", &"ОТЗЫВЫ: −{amount} К РАСХОДУ СИЛ"]: [&"READER SUPPORT: −{amount} STAMINA COST"],
[&"", &"ПРИ {threshold}: −{amount} К РАСХОДУ СИЛ"]: [&"AT {threshold}: −{amount} STAMINA COST"],
[&"", &"ПРИ 75: +10 К СИЛАМ"]: [&"AT 75: +10 STAMINA"],
[&"", &"ПРИ 75: −2 К РАСХОДУ СИЛ"]: [&"AT 75: −2 STAMINA COST"],
[&"", &"Подробнее о выносливости"]: [&"About stamina"],
[&"", &"Редактор"]: [&"Editor"],
[&"", &"КАРТОЧКА РЕДАКТОРА"]: [&"EDITOR\'S CARD"],
[&"", &"Следующая страница"]: [&"Next page"],
[&"", &"Предыдущая страница"]: [&"Previous page"],
[&"", &"Звуки (SFX)"]: [&"Sound effects"],
[&"", &"Музыка"]: [&"Music"],
[&"", &"02  /  ЗВУК"]: [&"02  /  AUDIO"],
[&"", &"Выбор заголовка: с фоном"]: [&"Headline selection backdrop"],
[&"", &"Подсказки"]: [&"Tooltips"],
[&"", &"01  /  ИНТЕРФЕЙС"]: [&"01  /  INTERFACE"],
[&"", &"COCO NEWS  /  СЛУЖЕБНАЯ ЗАПИСКА"]: [&"COCO NEWS  /  INTERNAL MEMO"],
[&"", &"СМЕНА 01"]: [&"SHIFT 01"],
[&"", &"Каждый вечер я вижу одного чёрного кота у своего подъезда. Мне кажется, он за мной следит! Соседка говорит, что кот ждёт хозяйку из ночной смены. К полиции я пока не обращалась. Пожалуйста, выясните, что происходит."]: [&"Every evening I see the same black cat outside my building. I think he is watching me! My neighbour says he is waiting for his owner to come off the night shift. I have not contacted the police yet. Please find out what is going on."],
[&"", &"Письмо жительницы · квартал Фонарей"]: [&"A resident\'s letter · Lantern Quarter"],
[&"", &"Награды и штрафы усилены"]: [&"Rewards and penalties increased"],
[&"", &"БАЛАНС"]: [&"BALANCE"],
[&"", &"Подробнее о квалификации"]: [&"About professional skill"],
[&"", &"КВАЛИФИКАЦИЯ"]: [&"SKILL"],
[&"", &"ЛОЯЛЬНОСТЬ ГОСУДАРСТВУ"]: [&"GOVERNMENT LOYALTY"],
[&"", &"РЕПУТАЦИЯ КОМПАНИИ"]: [&"PAPER\'S REPUTATION"],
[&"", &"Подробнее о показателе"]: [&"About this stat"],
[&"", &"ВЫНОСЛИВОСТЬ"]: [&"STAMINA"],
[&"", &"Остаться в игре"]: [&"Keep playing"],
[&"", &"Выйти без сохранения"]: [&"Quit without saving"],
[&"", &"Прогресс после последнего сохранения будет потерян. Выйти без сохранения?"]: [&"Progress since your last save will be lost. Quit without saving?"],
[&"", &"Не удалось сохранить"]: [&"Could not save"],
[&"", &"Начать историю"]: [&"Start story"],
[&"", &"История Николы Коко начинается с первого рабочего дня."]: [&"Nicola Coco\'s story begins with her first day at work."],
[&"", &"COCO NEWS  /  ГЛАВА I"]: [&"COCO NEWS  /  CHAPTER I"],
[&"", &"ВЫХОД"]: [&"QUIT"],
[&"", &"НАСТРОЙКИ"]: [&"SETTINGS"],
[&"", &"НОВАЯ ИСТОРИЯ"]: [&"NEW STORY"],
[&"", &"ДО ПЕЧАТИ"]: [&"BEFORE THE PRESS"],
[&"", &"Настройки"]: [&"Settings"],
[&"", &"Пропустить"]: [&"Skip"],
[&"", &"Назад"]: [&"Back"],
[&"", &"Тише. Бриполис засыпает…"]: [&"Hush. Bripolis is falling asleep…"],
[&"", &"Показатели Николы Коко и рюкзак"]: [&"Nicola Coco\'s stats and bag"],
[&"", &"Покормить рыбок: открыть рюкзак"]: [&"Feed the fish: open bag"],
[&"", &"Никола Коко: открыть сведения"]: [&"Nicola Coco: view profile"],
[&"", &"Пауза · Esc"]: [&"Pause · Esc"],
